{
 "file": "EN/MINIGAME/MIGFISHINGMSGINFO.BMD",
 "entries": [
  {
   "id": "MSG_FISHING_DIRECT_01#0",
   "speaker": "Morgana",
   "en": "Where are you gonna throw it?",
   "uk": "Куди закидатимеш?",
   "note": ""
  },
  {
   "id": "MSG_FISHING_DIRECT_02#0",
   "speaker": "Morgana",
   "en": "Ooh, that one looks[n]pretty lively.",
   "uk": "О-о, ця здається[n]доволі жвавою.",
   "note": ""
  },
  {
   "id": "MSG_FISHING_DIRECT_03#0",
   "speaker": "Morgana",
   "en": "Make sure you focus...!",
   "uk": "Зосередься...!",
   "note": ""
  },
  {
   "id": "MSG_FISHING_DIRECT_04#0",
   "speaker": "Morgana",
   "en": "How about you aim for[n]that fish over there?",
   "uk": "Може, ціль у ту[n]рибу он там?",
   "note": ""
  },
  {
   "id": "MSG_FISHING_DIRECT_05#0",
   "speaker": "Morgana",
   "en": "Make sure you cast the[n]hook properly, all right?",
   "uk": "Закидай гачок як слід,[n]гаразд?",
   "note": ""
  },
  {
   "id": "MSG_FISHING_WAIT_01#0",
   "speaker": "Morgana",
   "en": "I wonder if you'll catch one...",
   "uk": "Цікаво, чи впіймаєш...",
   "note": ""
  },
  {
   "id": "MSG_FISHING_WAIT_02#0",
   "speaker": "Morgana",
   "en": "Be patient...!",
   "uk": "Терпіння...!",
   "note": ""
  },
  {
   "id": "MSG_FISHING_WAIT_03#0",
   "speaker": "Morgana",
   "en": "Hm...",
   "uk": "Гм...",
   "note": ""
  },
  {
   "id": "MSG_FISHING_WAIT_04#0",
   "speaker": "Morgana",
   "en": "Maybe we should have thrown[n]it over there instead...?",
   "uk": "Може, треба було закинути[n]туди...?",
   "note": ""
  },
  {
   "id": "MSG_FISHING_WAIT_05#0",
   "speaker": "Morgana",
   "en": "Come on, come on...!",
   "uk": "Ну ж бо, ну ж бо...!",
   "note": ""
  },
  {
   "id": "MSG_FISHING_HIT_01#0",
   "speaker": "Morgana",
   "en": "We got one!",
   "uk": "Є одна!",
   "note": ""
  },
  {
   "id": "MSG_FISHING_HIT_02#0",
   "speaker": "Morgana",
   "en": "There we go!",
   "uk": "Отак!",
   "note": ""
  },
  {
   "id": "MSG_FISHING_HIT_03#0",
   "speaker": "Morgana",
   "en": "All right!",
   "uk": "Чудово!",
   "note": ""
  },
  {
   "id": "MSG_FISHING_HIT_04#0",
   "speaker": "Morgana",
   "en": "The real battle starts now!",
   "uk": "Тепер почнеться справжній бій!",
   "note": ""
  },
  {
   "id": "MSG_FISHING_HIT_05#0",
   "speaker": "Morgana",
   "en": "It's on the line!",
   "uk": "Сидить на гачку!",
   "note": ""
  },
  {
   "id": "MSG_FISHING_BATTLE_01#0",
   "speaker": "Morgana",
   "en": "Damn, it's pretty tough...!",
   "uk": "Чорт, досить сильна...!",
   "note": ""
  },
  {
   "id": "MSG_FISHING_BATTLE_02#0",
   "speaker": "Morgana",
   "en": "It's got spunk!",
   "uk": "Яка завзята!",
   "note": ""
  },
  {
   "id": "MSG_FISHING_BATTLE_03#0",
   "speaker": "Morgana",
   "en": "Keep going...!",
   "uk": "Не здавайся...!",
   "note": ""
  },
  {
   "id": "MSG_FISHING_BATTLE_04#0",
   "speaker": "Morgana",
   "en": "Don't let your guard down...!",
   "uk": "Не розслабляйся...!",
   "note": ""
  },
  {
   "id": "MSG_FISHING_BATTLE_05#0",
   "speaker": "Morgana",
   "en": "Just pull!",
   "uk": "Тягни!",
   "note": ""
  }
 ]
}