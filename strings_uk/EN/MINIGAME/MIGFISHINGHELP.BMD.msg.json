{
 "file": "EN/MINIGAME/MIGFISHINGHELP.BMD",
 "entries": [
  {
   "id": "HELP_FISHING_000#0",
   "speaker": null,
   "en": "It's pretty dangerous[n]to put in your mouth.",
   "uk": "Досить небезпечно[n]брати в рот.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_000#1",
   "speaker": null,
   "en": "This might be useful[n]as a luring bait.",
   "uk": "Може згодитися[n]як принада.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_001#0",
   "speaker": null,
   "en": "A standard bait sold in stores.",
   "uk": "Звичайна наживка з крамниці.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_001#1",
   "speaker": null,
   "en": "Its success rate is so-so.",
   "uk": "Успіх так собі.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_002#0",
   "speaker": null,
   "en": "This is the one you want.[n]The fishes love it too.",
   "uk": "Саме те, що треба.[n]Рибам теж подобається.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_003#0",
   "speaker": null,
   "en": "Karaage-chan (Four years-old)",
   "uk": "Карааґе (чотири роки)",
   "note": ""
  },
  {
   "id": "HELP_FISHING_004#0",
   "speaker": null,
   "en": "Even humans are drawn[n]to it during winter.",
   "uk": "Узимку навіть людей[n]до неї тягне.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_004#1",
   "speaker": null,
   "en": "It has an immediate[n]effect on fishes too.",
   "uk": "На риб теж діє[n]миттєво.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_005#0",
   "speaker": null,
   "en": "It even melts in water.",
   "uk": "Навіть у воді тане.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_006#0",
   "speaker": null,
   "en": "Even humans want to nibble on it.",
   "uk": "Навіть людям хочеться куснути.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_006#1",
   "speaker": null,
   "en": "Well, just the pack, though.",
   "uk": "Ну, тільки пачку.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_007#0",
   "speaker": null,
   "en": "I'll give you the can and all.",
   "uk": "Віддам разом із бляшанкою.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_008#0",
   "speaker": null,
   "en": "Choose this one if you're[n]having trouble deciding.",
   "uk": "Обирайте цю, якщо[n]не можете вирішити.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_009#0",
   "speaker": null,
   "en": "It doesn't use any meat.",
   "uk": "Зовсім без м'яса.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_010#0",
   "speaker": null,
   "en": "Its taste is habit-forming.",
   "uk": "Смак, що викликає звикання.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_011#0",
   "speaker": null,
   "en": "The fishes that eat[n]this get kind of cranky.",
   "uk": "Риби, що це їдять,[n]стають якимись дратівливими.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_012#0",
   "speaker": null,
   "en": "You can catch all kinds[n]of fish with this.",
   "uk": "З цим можна зловити[n]будь-яку рибу.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_012#1",
   "speaker": null,
   "en": "All the fish will swim toward[n]this bait at full speed.",
   "uk": "Уся риба мчить до цієї[n]наживки щодуху.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_013#0",
   "speaker": null,
   "en": "Ground hermit crab.",
   "uk": "Наземний рак-самітник.",
   "note": ""
  },
  {
   "id": "HELP_FISHING_014#0",
   "speaker": null,
   "en": "For fish, Calorism will[n]be their Last Supper.",
   "uk": "Для риб «Калорізм» стане[n]Таємною вечерею.",
   "note": ""
  }
 ]
}