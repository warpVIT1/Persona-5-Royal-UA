   "note": ""
  },
  {
   "id": "MSG_Laundry_Pay_HaveItem#0",
   "speaker": "Morgana",
   "en": "It costs 400 yen. You have [clr 2]sooty[n]equipment[clr 27] that needs cleaning,[n]but you don't have enough money...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_Laundry_Pay_HaveItem_2#0",
   "speaker": "Morgana",
   "en": "It costs 400 yen. You have [clr 2]sooty[n]equipment[clr 27] that needs cleaning,[n]but you don't have enough money...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_Laundry_Pay_HaveItem_2#1",
