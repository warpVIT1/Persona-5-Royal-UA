{
 "file": "EN/SCRIPT/FIELD/FSCR3000_001_000.BF",
 "entries": [
  {
   "id": "BED_CHECK_mes00#0",
   "speaker": null,
   "en": "There's a plain mattress here.",
   "uk": "Тут лежить голий матрац.",
   "note": ""
  },
  {
   "id": "BED_CHECK_NG_0409_mes01#0",
   "speaker": null,
   "en": "Is this supposed to be my bed...?",
   "uk": "Це що, має бути моє ліжко?..",
   "note": ""
  },
  {
   "id": "BED_CHECK_mes01#0",
   "speaker": null,
   "en": "I'll put the sheets I got on the bed.",
   "uk": "Застелю ліжко простирадлом,[n]яке мені дали.",
   "note": ""
  },
  {
   "id": "BED_CHECK_mes02#0",
   "speaker": null,
   "en": "I should be able to sleep on this now.",
   "uk": "Тепер на цьому можна спати.",
   "note": ""
  },
  {
   "id": "BED_CHECK_0410_EV_mes01#0",
   "speaker": null,
   "en": "Maybe I'll skip writing in my journal and[n]just go to sleep...",
   "uk": "Може, не писати в щоденник,[n]а просто лягти спати...",
   "note": ""
  },
  {
   "id": "BED_CHECK_0410_EV_SEL#0",
   "speaker": null,
   "en": "Sleep",
   "uk": "Лягти спати",
   "note": ""
  },
  {
   "id": "BED_CHECK_0410_EV_SEL#1",
   "speaker": null,
   "en": "Cancel",
   "uk": "Скасувати",
   "note": ""
  },
  {
   "id": "BED_CHECK_0410_EV_mes02#0",
   "speaker": null,
   "en": "Let me sit down on the sofa and write[n]in my journal.",
   "uk": "Сяду на диван і запишу дещо[n]в щоденник.",
   "note": ""
  },
  {
   "id": "BED_CHECK_0410_END_mes01#0",
   "speaker": null,
   "en": "I guess I'll change and go to bed.",
   "uk": "Мабуть, перевдягнуся й ляжу спати.",
   "note": ""
  }
 ]
}