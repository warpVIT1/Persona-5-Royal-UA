 "entries": [
  {
   "id": "D156_07_CONSOLE_SYS_mes0#0",
   "speaker": null,
   "en": "24-hour factory operation panel.",
   "uk": "Панель керування цілодобовою[n]фабрикою.",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_SYS_sel#0",
   "speaker": null,
   "en": "Set it to \"Break\"",
   "uk": "Обрати «Перерва»",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_SYS_sel#1",
   "speaker": null,
   "en": "Set it to \"Lunch\"",
   "uk": "Обрати «Обід»",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_SYS_sel#2",
   "speaker": null,
   "en": "Set it to \"Unpaid Overtime\"",
   "uk": "Обрати «Безоплатні понаднормові»",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_SYS_sel#3",
   "speaker": null,
   "en": "Don't change anything",
   "uk": "Нічого не змінювати",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_SYS_A_me#0",
   "speaker": "Factory Announcement",
   "en": "IT IS NOW BREAK TIME!",
   "uk": "НАСТАВ ЧАС ПЕРЕРВИ!",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_SYS_A_me_2#0",
   "speaker": "Factory Announcement",
   "en": "LET US REST AND RESTORE OUR[n]WEARY SPIRITS!",
   "uk": "ВІДПОЧИНЬМО Й ВІДНОВІМО[n]НАШ ВИСНАЖЕНИЙ ДУХ!",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_SYS_A_me_3#0",
   "speaker": "Factory Announcement",
   "en": "BREAK TIME SHALL LAST FOR[n]APPROXIMATELY FIVE SECONDS!",
   "uk": "ПЕРЕРВА ТРИВАТИМЕ[n]ПРИБЛИЗНО П'ЯТЬ СЕКУНД!",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_SYS_B_me#0",
   "speaker": "Factory Announcement",
   "en": "IT IS NOW BREAK TIME!",
   "uk": "НАСТАВ ЧАС ПЕРЕРВИ!",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_SYS_B_me_2#0",
   "speaker": "Factory Announcement",
   "en": "LET US CONSUME OUR SLOP AND[n]GLEEFULLY REENERGIZE!",
   "uk": "СПОЖИЙМО НАШУ БАЛАНДУ[n]Й РАДІСНО ПІДЗАРЯДІМОСЯ!",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_SYS_B_me_3#0",
   "speaker": "Factory Announcement",
   "en": "LUNCHTIME SHALL LAST FOR[n]APPROXIMATELY THIRTY SECONDS!",
   "uk": "ОБІД ТРИВАТИМЕ[n]ПРИБЛИЗНО ТРИДЦЯТЬ СЕКУНД!",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_SYS_C_me#0",
   "speaker": "Factory Announcement",
   "en": "WE ARE CURRENTLY IN A STATE OF[n]CONSTANT UNPAID OVERTIME!",
   "uk": "НАРАЗІ МИ В РЕЖИМІ ПОСТІЙНИХ[n]БЕЗОПЛАТНИХ ПОНАДНОРМОВИХ!",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_SYS_C_me#1",
   "speaker": "Factory Announcement",
   "en": "LET US STRIVE TO WORK HARD[n]AROUND THE CLOCK!",
   "uk": "ПРАЦЮЙМО СТАРАННО[n]ЦІЛОДОБОВО!",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_SUB_mes0#0",
   "speaker": null,
   "en": "If I hack into this terminal, I can[n]stop the factory temporarily.",
   "uk": "Якщо зламати цей термінал,[n]можна тимчасово зупинити фабрику.",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_SUB_sel#0",
   "speaker": null,
   "en": "Hack",
   "uk": "Зламати",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_SUB_sel#1",
   "speaker": null,
   "en": "Don't hack",
   "uk": "Не ламати",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_WORK_mes#0",
   "speaker": null,
   "en": "BREAK TIME IS OVER!",
   "uk": "ПЕРЕРВУ ЗАКІНЧЕНО!",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_WORK_mes_2#0",
   "speaker": null,
   "en": "LET US MAKE UP FOR LOST TIME!",
   "uk": "НАДОЛУЖМО ЗГАЯНИЙ ЧАС!",
   "note": ""
  },
  {
   "id": "D156_07_CONSOLE_NG_mes01#0",
   "speaker": null,
   "en": "Currently in break time.",
   "uk": "Зараз перерва.",
   "note": ""
  }
 ]
