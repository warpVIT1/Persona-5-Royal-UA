{
 "file": "EN/SCRIPT/FIELD/FSCR0160_002_100.BF",
 "entries": [
  {
   "id": "D08_02_e454_030_mes01#0",
   "speaker": "Morgana",
   "en": "Can you see that further in? That's the[n]temple.",
   "uk": "Бачиш он там, далі? Це[n]храм.",
   "note": ""
  },
  {
   "id": "D08_02_e454_030_mes02#0",
   "speaker": "Ryuji",
   "en": "Heh, it's nice knowin' there aren't gonna[n]be any bullshit traps or nothing this time!",
   "uk": "Хе, приємно знати, що цього разу[n]не буде жодних клятих пасток!",
   "note": ""
  },
  {
   "id": "D08_02_e454_030_mes02#1",
   "speaker": "Ryuji",
   "en": "All right, let's get movin'!",
   "uk": "Гаразд, рушаймо!",
   "note": ""
  },
  {
   "id": "D08_02_e454_035_mes01#0",
   "speaker": "Morgana",
   "en": "Hm...? What the...",
   "uk": "Хм...? Що за...",
   "note": ""
  },
  {
   "id": "D08_02_e454_035_mes02#0",
   "speaker": "Ann",
   "en": "What's up?",
   "uk": "Що таке?",
   "note": ""
  },
  {
   "id": "D08_02_e454_035_mes03#0",
   "speaker": "Morgana",
   "en": "I'm sensing something up ahead...",
   "uk": "Я щось відчуваю попереду...",
   "note": ""
  },
  {
   "id": "D08_02_e454_035_mes04#0",
   "speaker": "Ryuji",
   "en": "I guess we can't just go waltzin' in there,[n]huh... Whaddya say, Joker?",
   "uk": "Схоже, просто так туди не вальсуєш,[n]га... Що скажеш, Джокере?",
   "note": ""
  },
  {
   "id": "D08_02_e454_035_selA#0",
   "speaker": null,
   "en": "Yeah, let's push onward.",
   "uk": "Так, просуваймося далі.",
   "note": ""
  },
  {
   "id": "D08_02_e454_035_selA#1",
   "speaker": null,
   "en": "We should prepare first.",
   "uk": "Спершу підготуймося.",
   "note": ""
  },
  {
   "id": "D08_02_e454_035_selA_1_m#0",
   "speaker": "Morgana",
   "en": "Right! We've come this far, so we can't[n]overlook anything now!",
   "uk": "Точно! Ми зайшли так далеко, тож[n]тепер не можна нічого проґавити!",
   "note": ""
  },
  {
   "id": "D08_02_e454_035_re_mes01#0",
   "speaker": "Ryuji",
   "en": "You wanna go, Joker?",
   "uk": "Підемо, Джокере?",
   "note": ""
  },
  {
   "id": "D08_02_e454_035_re_selA#0",
   "speaker": null,
   "en": "Let's push onward.",
   "uk": "Просуваймося далі.",
   "note": ""
  },
  {
   "id": "D08_02_e454_035_re_selA#1",
   "speaker": null,
   "en": "We should prepare first.",
   "uk": "Спершу підготуймося.",
   "note": ""
  },
  {
   "id": "D08_02_e454_035_re_selA_#0",
   "speaker": "Morgana",
   "en": "Make sure you don't overlook anything!",
   "uk": "Дивись, нічого не проґав!",
   "note": ""
  }
 ]
