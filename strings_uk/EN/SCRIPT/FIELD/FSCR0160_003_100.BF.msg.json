  {
   "id": "D08_02_e457_010_mes01#0",
   "speaker": "Haru",
   "en": "Look, over there!",
   "uk": "Дивіться, он там!",
   "note": ""
  },
  {
   "id": "D08_02_e457_010_mes02#0",
   "speaker": "Yusuke",
   "en": "It seems guards have appeared.",
   "uk": "Схоже, з'явилися вартові.",
   "note": ""
  },
  {
   "id": "D08_02_e457_010_mes03#0",
   "speaker": "Morgana",
   "en": "The people in the city recognized us, so[n]it's only natural we'd draw the enemy's[n]attention as well.",
   "uk": "Люди в місті нас упізнали, тож цілком[n]природно, що ми привернули й увагу[n]ворога.",
   "note": ""
  },
  {
   "id": "D08_02_e457_010_mes04#0",
   "speaker": "Ryuji",
   "en": "Well they can bring it on! I'm startin' to[n]get fired up!",
   "uk": "Та нехай сунуть! Я вже[n]розпалююся!",
   "note": ""
  },
  {
   "id": "D08_02_e457_015_mes01#0",
   "speaker": "Futaba",
   "en": "Wait up! I'm getting another reading[n]from up ahead!",
   "uk": "Стривайте! Попереду ще один[n]сигнал!",
   "note": ""
  },
  {
   "id": "D08_02_e457_015_mes01#1",
   "speaker": "Futaba",
   "en": "Are you ready for this?",
   "uk": "Ви готові?",
   "note": ""
  },
  {
   "id": "D08_02_e457_015_selA#0",
   "speaker": null,
   "en": "I'm good to go.",
   "uk": "Я готовий.",
   "note": ""
  },
  {
   "id": "D08_02_e457_015_selA#1",
   "speaker": null,
   "en": "Not quite yet.",
   "uk": "Ще ні.",
   "note": ""
  },
  {
   "id": "D08_02_e457_015_selA_1_m#0",
   "speaker": "Morgana",
   "en": "Okay, just make sure you prepare[n]yourself!",
   "uk": "Гаразд, тільки добре[n]підготуйся!",
   "note": ""
  },
  {
   "id": "D08_02_e457_015_re_mes01#0",
   "speaker": "Futaba",
   "en": "You ready, Joker?",
   "uk": "Готовий, Джокере?",
   "note": ""
  },
  {
   "id": "D08_02_e457_015_re_selA#0",
   "speaker": null,
   "en": "I'm good to go.",
   "uk": "Я готовий.",
   "note": ""
  },
