{
 "file": "EN/SCRIPT/FIELD/FSCR0500_100_200.BF",
 "entries": [
  {
   "id": "meme_1224_target_lost_me#0",
   "speaker": "Futaba",
   "en": "Huh...? What's going on...?",
   "uk": "Га...? Що відбувається...?",
   "note": ""
  },
  {
   "id": "meme_1224_target_lost_me#1",
   "speaker": "Futaba",
   "en": "Something's different in here...[n]I can't sense any targets.",
   "uk": "Тут щось не так...[n]Я не відчуваю жодних цілей.",
   "note": ""
  },
  {
   "id": "meme_1224_target_lost_me#2",
   "speaker": "Futaba",
   "en": "This has never happened, not even in[n]a Palace...",
   "uk": "Такого ніколи не бувало, навіть[n]у Палаці...",
   "note": ""
  },
  {
   "id": "meme_1224_target_lost_me_2#0",
   "speaker": "Ryuji",
   "en": "This is perfect. We don't got time to be[n]dealin' with those weak dudes anyways!",
   "uk": "Це ж ідеально. Нам однаково ніколи[n]возитися з тими слабаками!",
   "note": ""
  },
  {
   "id": "meme_1224_target_lost_me_3#0",
   "speaker": "Yusuke",
   "en": "Yes, the fewer hindrances we meet on[n]our descent, the better.",
   "uk": "Так, що менше перешкод на шляху[n]вниз, то краще.",
   "note": ""
  },
