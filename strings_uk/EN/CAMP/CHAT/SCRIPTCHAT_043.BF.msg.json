{
 "file": "EN/CAMP/CHAT/SCRIPTCHAT_043.BF",
 "entries": [
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Makoto",
   "en": "Futaba, can you open up?",
   "uk": "Футабо, можеш відчинити?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Futaba",
   "en": "Open what?",
   "uk": "Що відчинити?",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Yusuke",
   "en": "The front door.",
   "uk": "Вхідні двері.",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Futaba",
   "en": "Why?",
   "uk": "Навіщо?",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Makoto",
   "en": "Won't you come too, [fName]?[n]We're in front of Futaba's house.",
   "uk": "Може, і ти підійдеш, [fName]?[n]Ми перед будинком Футаби.",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Futaba",
   "en": "You wanna meet here...[n]and not at Leblanc?",
   "uk": "Ви хочете зустрітися тут...[n]а не в «Леблані»?",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Makoto",
   "en": "Isn't that more comforting?",
   "uk": "Хіба так не спокійніше?",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Futaba",
   "en": "Y-Y-You never mentioned this.",
   "uk": "В-в-ви про це не казали.",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Makoto",
   "en": "It would be nice if you[n]could hurry down soon. It's[n]scorching hot out here.",
   "uk": "Було б добре, якби ти[n]швидше спустилася. Тут[n]надворі пекельна спека.",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Futaba",
   "en": "You demon...!",
   "uk": "Ти демониця...!",
   "note": ""
  },
  {
   "id": "MSG_CHAT_MORUEND_00#0",
   "speaker": "Morgana",
   "en": "Looks like we're meeting up immediately[n]over at Futaba's.",
   "uk": "Схоже, ми негайно збираємося[n]в Футаби.",
   "note": ""
  },
  {
   "id": "MSG_CHAT_MORUEND_00#1",
   "speaker": "Morgana",
   "en": "Makoto's really going about this[n]seriously...",
   "uk": "Макото взялася за це[n]всерйоз...",
   "note": ""
  }
 ]
}