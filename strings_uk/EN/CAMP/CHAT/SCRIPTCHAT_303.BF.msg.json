{
 "file": "EN/CAMP/CHAT/SCRIPTCHAT_303.BF",
 "entries": [
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Ryuji",
   "en": "Shinjuku at night, eh?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Yusuke",
   "en": "That sounds rather dangerous.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Ann",
   "en": "Where should we meet up?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Ryuji",
   "en": "Stand by, Ann. It'll be easier[n]to move around with less of us.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Yusuke",
   "en": "My apologies. I don't have the[n]money to take the train there.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Ryuji",
   "en": "Then you're on standby too.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Ryuji",
   "en": "Me and [fName] will go, OK?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_015_0_0#0",
   "speaker": null,
   "en": "Got it.",
   "uk": "Зрозумів.",
   "note": ""
  },
  {
   "id": "SEL_015_0_0#1",
   "speaker": null,
   "en": "I'm worried.",
   "uk": "Я хвилююся.",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Ann",
   "en": "If [fName]'s going, I guess[n]there's no need to worry.[n]We'll leave it to you then.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Yusuke",
   "en": "It will be fine. With Ryuji by[n]your side, you will blend right[n]into the dangerous city.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Ryuji",
   "en": "Shut up!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Ryuji",
   "en": "Well, I guess that's that.[n]Let's meet up in Shibuya.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Ann",
   "en": "Be careful, you two.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Yusuke",
   "en": "I shall be sure to save money for[n]situations like this from now on.",
   "uk": "",
   "note": ""
  }
 ]
}