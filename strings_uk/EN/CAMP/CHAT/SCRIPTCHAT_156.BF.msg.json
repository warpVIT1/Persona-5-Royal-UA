{
 "file": "EN/CAMP/CHAT/SCRIPTCHAT_156.BF",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Yusuke",
   "en": "Has anyone received any[n]form of contact from Haru?",
   "uk": "Чи отримував хтось якусь[n]звістку від Хару?",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Ann",
   "en": "Not me.",
   "uk": "Я ні.",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Ryuji",
   "en": "Nope...",
   "uk": "Ні...",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Makoto",
   "en": "I haven't.",
   "uk": "Я теж ні.",
   "note": ""
  },
  {
   "id": "SEL_004_0_0#0",
   "speaker": null,
   "en": "I did.",
   "uk": "Я отримав.",
   "note": ""
  },
  {
   "id": "SEL_004_0_0#1",
   "speaker": null,
   "en": "I didn't.",
   "uk": "Я ні.",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Futaba",
   "en": "We got a call this morning.",
   "uk": "Нам зранку дзвонили.",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Ryuji",
   "en": "For real!?",
   "uk": "Серйозно!?",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Ann",
   "en": "Did she seem OK?",
   "uk": "З нею все гаразд?",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Futaba",
   "en": "She sounded tired.",
   "uk": "Голос був утомлений.",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Yusuke",
   "en": "I see... So, what did she say?",
   "uk": "Зрозуміло... І що ж вона сказала?",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Futaba",
   "en": "Looks like she wants to[n]talk about something.",
   "uk": "Схоже, хоче про щось[n]поговорити.",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Futaba",
   "en": "Said she'll come here[n]sometime this evening.",
   "uk": "Сказала, що прийде сюди[n]десь увечері.",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Yusuke",
   "en": "Great. Let us gather then.",
   "uk": "Чудово. Тоді й зберімося.",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Makoto",
   "en": "All right. We'll meet at the[n]hideout after school.",
   "uk": "Гаразд. Зустрінемося у сховку[n]після школи.",
   "note": ""
  }
 ]
}