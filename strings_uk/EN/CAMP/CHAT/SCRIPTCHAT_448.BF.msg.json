{
 "file": "EN/CAMP/CHAT/SCRIPTCHAT_448.BF",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Sojiro",
   "en": "Hey, something's come up.",
   "uk": "Агов, тут дещо сталося.",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Sojiro",
   "en": "...It's sapped all my motivation.",
   "uk": "...У мене геть пропало бажання.",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Sojiro",
   "en": "The store's gonna go into the[n]red if this continues. It'll[n]be bad for you too, you know.",
   "uk": "Якщо так триватиме, кафе піде[n]в мінус. Тобі від цього теж[n]буде погано, знаєш.",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Sojiro",
   "en": "So, what'll you do?",
   "uk": "То що робитимеш?",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Sojiro",
   "en": "Leblanc awaits your return!",
   "uk": "«Леблан» чекає на твоє повернення!",
   "note": ""
  },
  {
   "id": "CHAT_NOREACTION_MSG#0",
   "speaker": "Sojiro",
   "en": "Something happen to you? Don't[n]be afraid to come back, OK?",
   "uk": "Щось сталося? Не бійся[n]повертатися, гаразд?",
   "note": ""
  },
  {
   "id": "CHAT_REACTION_MSG#0",
   "speaker": "Sojiro",
   "en": "Yeah, just get on back here.[n]I'm waiting for you!",
   "uk": "Ага, просто вертайся сюди.[n]Я чекаю на тебе!",
   "note": ""
  },
  {
   "id": "MSG_MORUGANA#0",
   "speaker": "Morgana",
   "en": "What are you going to do? Will you[n]accept the chief's invitation?",
   "uk": "Що робитимеш? Приймеш[n]запрошення шефа?",
   "note": ""
  },
  {
   "id": "SEL_001#0",
   "speaker": null,
   "en": "Go home",
   "uk": "Ідіть додому",
   "note": ""
  },
  {
   "id": "SEL_001#1",
   "speaker": null,
   "en": "Check bond with Sojiro",
   "uk": "Перевірити зв'язок із Соджіро",
   "note": ""
  },
  {
   "id": "SEL_001#2",
   "speaker": null,
   "en": "Respond later",
   "uk": "Відповісти пізніше",
   "note": ""
  },
  {
   "id": "SEL_002#0",
   "speaker": null,
   "en": "I'll be right home.",
   "uk": "Зараз буду вдома.",
   "note": ""
  }
 ]
}