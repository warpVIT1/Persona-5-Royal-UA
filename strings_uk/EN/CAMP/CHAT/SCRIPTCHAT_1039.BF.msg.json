 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Futaba",
   "en": "What are you doing today?",
   "uk": "Що робиш сьогодні?",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Futaba",
   "en": "If we're going to the[n]Palace, let me know.",
   "uk": "Якщо йдемо в Палац,[n]дай знати.",
   "note": ""
  },
  {
   "id": "MSG_MORUGANA#0",
   "speaker": "Morgana",
   "en": "Well, what do you want to do? Should[n]we meet up at the hideout and head[n]into the Palace?",
   "uk": "Ну, що хочеш робити? Зберемося[n]в схованці й підемо[n]в Палац?",
   "note": ""
  },
  {
   "id": "SEL_001#0",
   "speaker": null,
   "en": "Meet up",
   "uk": "Зібратися",
   "note": ""
  },
  {
   "id": "SEL_001#1",
   "speaker": null,
   "en": "Decide later",
   "uk": "Вирішити пізніше",
   "note": ""
  },
  {
   "id": "SEL_002#0",
   "speaker": null,
   "en": "Let's go to the Palace.",
   "uk": "Ходімо в Палац.",
   "note": ""
  },
  {
   "id": "MSG_REACTION#0",
   "speaker": "Futaba",
   "en": "Roger that.",
   "uk": "Прийнято.",
   "note": ""
  },
  {
   "id": "MSG_REACTION_02#0",
   "speaker": "Futaba",
   "en": "I'll be waiting for you guys.",
   "uk": "Чекаю на вас.",
   "note": ""
  }
 ]
