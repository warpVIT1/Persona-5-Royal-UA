   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Haru",
   "en": "I actually feel bad having[n]everyone worry about me...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Haru",
   "en": "How about you? Are you doing OK?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_008_0_0#0",
   "speaker": null,
   "en": "I'm managing.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_008_0_0#1",
   "speaker": null,
   "en": "This is awful.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Haru",
   "en": "You sure are strong.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Haru",
   "en": "Hang in there.",
