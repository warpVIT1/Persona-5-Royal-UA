{
 "file": "EN/CAMP/CHAT/SCRIPTCHAT_453.BF",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Sojiro",
   "en": "Hey, are you free today?",
   "uk": "Агов, ти сьогодні вільний?",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Sojiro",
   "en": "I want to ask you to[n]help me out. Come home.",
   "uk": "Хочу попросити тебе[n]допомогти. Іди додому.",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Sojiro",
   "en": "It's tough being here[n]when you're not around.",
   "uk": "Важко тут, коли[n]тебе немає поруч.",
   "note": ""
  },
  {
   "id": "CHAT_NOREACTION_MSG#0",
   "speaker": "Sojiro",
   "en": "Something happen to you? Don't[n]be afraid to come back, OK?",
   "uk": "Щось сталося? Не бійся[n]повертатися, гаразд?",
   "note": ""
  },
  {
   "id": "CHAT_REACTION_MSG#0",
   "speaker": "Sojiro",
   "en": "Thanks. I'll be counting on you.",
   "uk": "Дякую. Розраховую на тебе.",
   "note": ""
  },
  {
   "id": "MSG_MORUGANA#0",
   "speaker": "Morgana",
   "en": "What are you going to do? Will you[n]accept the chief's invitation?",
   "uk": "Що робитимеш? Приймеш[n]запрошення шефа?",
   "note": ""
  },
  {
   "id": "SEL_001#0",
   "speaker": null,
   "en": "Go home",
   "uk": "Піти додому",
   "note": ""
  },
  {
   "id": "SEL_001#1",
   "speaker": null,
   "en": "Check bond with Sojiro",
   "uk": "Перевірити зв'язок із Соджіро",
   "note": ""
  },
  {
   "id": "SEL_001#2",
   "speaker": null,
   "en": "Respond later",
   "uk": "Відповісти пізніше",
   "note": ""
  },
  {
   "id": "SEL_002#0",
   "speaker": null,
   "en": "I'll be right home.",
   "uk": "Зараз буду вдома.",
   "note": ""
  }
 ]
}