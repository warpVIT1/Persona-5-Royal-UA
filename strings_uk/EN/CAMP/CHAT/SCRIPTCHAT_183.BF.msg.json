{
 "file": "EN/CAMP/CHAT/SCRIPTCHAT_183.BF",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Haru",
   "en": "Tomorrow's finally the day.",
   "uk": "Завтра нарешті той самий день.",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Futaba",
   "en": "We've already secured the route[n]to the Treasure...",
   "uk": "Шлях до Скарбу[n]ми вже проклали...",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#1",
   "speaker": "Futaba",
   "en": "No problems there.",
   "uk": "Тут проблем нуль.",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Ann",
   "en": "All we have to do now is wait.",
   "uk": "Тепер лишається тільки чекати.",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Ryuji",
   "en": "Sweet. We're gonna rock this shit!",
   "uk": "Клас. Ми там усіх порвемо!",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Sumire",
   "en": "Yes!",
   "uk": "Так!",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#1",
   "speaker": "Sumire",
   "en": "Oh, [fName]-senpai—I wanted[n]to ask you something...",
   "uk": "О, [fName]-семпаю, я хотіла[n]дещо спитати...",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#2",
   "speaker": "Sumire",
   "en": "Has Dr. Maruki contacted you yet?",
   "uk": "Доктор Марукі вже виходив на зв'язок?",
   "note": ""
  },
  {
   "id": "SEL_005_0_0#0",
   "speaker": null,
   "en": "Nope.",
   "uk": "Ні.",
   "note": ""
  },
  {
   "id": "SEL_005_0_0#1",
   "speaker": null,
   "en": "Not yet.",
   "uk": "Ще ні.",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Yusuke",
   "en": "I see...",
   "uk": "Ясно...",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#1",
   "speaker": "Yusuke",
   "en": "I suppose waiting really is[n]our only option.",
   "uk": "Гадаю, очікування — і справді[n]єдиний наш варіант.",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Makoto",
   "en": "You're right.",
   "uk": "Твоя правда.",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#1",
   "speaker": "Makoto",
   "en": "If anything comes up on my end,[n]though, I'll get in touch with you all.",
   "uk": "Утім, якщо в мене щось з'явиться,[n]я з усіма вами зв'яжуся.",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Makoto",
   "en": "See you tomorrow.",
   "uk": "До завтра.",
   "note": ""
  }
 ]
}