{
 "file": "EN/CAMP/CHAT/SCRIPTCHAT_314.BF",
 "entries": [
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Ryuji",
   "en": "Yo, how'd it go?",
   "uk": "Йо, ну як воно?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Ryuji",
   "en": "You find out anything about[n]Futaba Sakura?",
   "uk": "Дізнався шось про[n]Футабу Сакуру?",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Ann",
   "en": "I've been wondering about[n]that too!",
   "uk": "Мені теж кортить дізнатися!",
   "note": ""
  },
  {
   "id": "SEL_004_0_0#0",
   "speaker": null,
   "en": "Tell you tomorrow.",
   "uk": "Розповім завтра.",
   "note": ""
  },
  {
   "id": "SEL_004_0_0#1",
   "speaker": null,
   "en": "At the hideout, OK?",
   "uk": "У сховку, гаразд?",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Ryuji",
   "en": "Whoa-ho!",
   "uk": "Ого-го!",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Yusuke",
   "en": "So you did learn something.[n]Fine work.",
   "uk": "Отже, ти таки щось дізнався.[n]Чудова робота.",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Ann",
   "en": "I knew we could count[n]on you!",
   "uk": "Я знала, що на тебе[n]можна покластися!",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Makoto",
   "en": "[fName]-kun, thank you.",
   "uk": "[fName]-кун, дякую тобі.",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Makoto",
   "en": "All right, then let's all[n]meet up tomorrow.",
   "uk": "Гаразд, тоді зберімося[n]всі завтра.",
   "note": ""
  }
 ]
}