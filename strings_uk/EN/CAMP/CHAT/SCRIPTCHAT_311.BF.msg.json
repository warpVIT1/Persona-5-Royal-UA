{
 "file": "EN/CAMP/CHAT/SCRIPTCHAT_311.BF",
 "entries": [
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Alibaba",
   "en": "Good day.",
   "uk": "Добрий день.",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#0",
   "speaker": null,
   "en": "Who is this?",
   "uk": "Хто це?",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#1",
   "speaker": null,
   "en": "What do you want?",
   "uk": "Чого тобі треба?",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#2",
   "speaker": null,
   "en": "Good day to you too.",
   "uk": "І вам добрий день.",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Alibaba",
   "en": "Ah, you responded today.",
   "uk": "О, сьогодні ти відповідаєш.",
   "note": ""
  },
  {
   "id": "MSG_003_5_0#0",
   "speaker": "Alibaba",
   "en": "Once again, I am Alibaba.",
   "uk": "Нагадаю: я Алібаба.",
   "note": ""
  },
  {
   "id": "MSG_003_7_0#0",
   "speaker": "Alibaba",
   "en": "You are the leader of the[n]Phantom Thieves, correct?",
   "uk": "Ти лідер Фантомних[n]Злодіїв, правильно?",
   "note": ""
  },
  {
   "id": "SEL_004_0_0#0",
   "speaker": null,
   "en": "You got the wrong guy.",
   "uk": "Ви помилилися адресою.",
   "note": ""
  },
  {
   "id": "SEL_004_0_0#1",
   "speaker": null,
   "en": "That's right.",
   "uk": "Саме так.",
   "note": ""
  },
  {
   "id": "SEL_004_0_0#2",
   "speaker": null,
   "en": "Who are you again?",
   "uk": "А ти хто такий?",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Alibaba",
   "en": "No, I know I'm right.",
   "uk": "Ні, я знаю, що це так.",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Alibaba",
   "en": "Mm, I appreciate your honesty.",
   "uk": "М-м, ціную твою чесність.",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Alibaba",
   "en": "I already said, I am Alibaba.",
   "uk": "Я вже казав: я Алібаба.",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Alibaba",
   "en": "I take it you received[n]the calling card?",
   "uk": "Як я розумію, візитівку[n]ти отримав?",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Morgana",
   "en": "So it really was from this guy...",
   "uk": "То вона й справді була від нього...",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Alibaba",
   "en": "Are you at school right now?",
   "uk": "Ти зараз у школі?",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#0",
   "speaker": null,
   "en": "I'm in class.",
   "uk": "Я на уроці.",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#1",
   "speaker": null,
   "en": "Nope.",
   "uk": "Ні.",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#2",
   "speaker": null,
   "en": "Who are you again?",
   "uk": "А ти хто такий?",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Alibaba",
   "en": "Hm, you're a surprisingly[n]diligent student.",
   "uk": "Гм, а ти на диво[n]старанний учень.",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Alibaba",
   "en": "Are you cutting class?[n]That's not good, you know.",
   "uk": "Прогулюєш уроки?[n]Це, знаєш, недобре.",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Alibaba",
   "en": "I'll answer that question as[n]many times as is necessary.",
   "uk": "Я відповідатиму на це питання[n]стільки разів, скільки потрібно.",
   "note": ""
  },
  {
   "id": "MSG_014_5_0#0",
   "speaker": "Alibaba",
   "en": "I am Alibaba.",
   "uk": "Я Алібаба.",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Alibaba",
   "en": "Now then, I have prepared[n]the calling card for you.",
   "uk": "Отже, візитівка для тебе[n]вже готова.",
   "note": ""
  },
  {
   "id": "MSG_015_5_0#0",
   "speaker": "Alibaba",
   "en": "When are you going to steal it?",
   "uk": "Коли ти збираєшся красти?",
   "note": ""
  },
  {
   "id": "SEL_016_0_0#0",
   "speaker": null,
   "en": "What're you talking about?",
   "uk": "Про що ви говорите?",
   "note": ""
  },
  {
   "id": "SEL_016_0_0#1",
   "speaker": null,
   "en": "Steal from who?",
   "uk": "Красти в кого?",
   "note": ""
  },
  {
   "id": "SEL_016_0_0#2",
   "speaker": null,
   "en": "Who are you again?",
   "uk": "А ти хто такий?",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Alibaba",
   "en": "Hm? Stealing a heart, of course.",
   "uk": "Гм? Красти серце, звісно.",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Alibaba",
   "en": "What do you mean by that?",
   "uk": "Що ти маєш на увазі?",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Alibaba",
   "en": "I'll keep answering if[n]you insist on asking.",
   "uk": "Якщо наполягаєш на питаннях,[n]я й далі відповідатиму.",
   "note": ""
  },
  {
   "id": "MSG_019_5_0#0",
   "speaker": "Alibaba",
   "en": "I am Alibaba.",
   "uk": "Я Алібаба.",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Alibaba",
   "en": "Aren't you able to steal a[n]heart as long as you have[n]a calling card?",
   "uk": "Хіба ти не можеш украсти[n]серце, якщо в тебе є[n]візитівка?",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Morgana",
   "en": "Tell him.",
   "uk": "Скажи йому.",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#1",
   "speaker": "Morgana",
   "en": "We need the name of the target.",
   "uk": "Нам потрібне ім'я цілі.",
   "note": ""
  },
  {
   "id": "SEL_021_5_0#0",
   "speaker": null,
   "en": "What's the target's name?",
   "uk": "Як звати ціль?",
   "note": ""
  },
  {
   "id": "SEL_021_5_0#1",
   "speaker": null,
   "en": "I need a name.",
   "uk": "Мені потрібне ім'я.",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Alibaba",
   "en": "...A name? Is your heart[n]thievery truly impossible[n]without such information?",
   "uk": "...Ім'я? Невже без таких[n]відомостей красти серця[n]справді неможливо?",
   "note": ""
  },
  {
   "id": "SEL_023_0_0#0",
   "speaker": null,
   "en": "It is.",
   "uk": "Так.",
   "note": ""
  },
  {
   "id": "SEL_023_0_0#1",
   "speaker": null,
   "en": "Just tell me.",
   "uk": "Просто скажи.",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Alibaba",
   "en": "...I see.",
   "uk": "...Зрозуміло.",
   "note": ""
  },
  {
   "id": "MSG_024_1_0#0",
   "speaker": "Alibaba",
   "en": "Hm, I suppose past calling[n]cards did have names on them.",
   "uk": "Гм, на попередніх візитівках[n]справді були імена.",
   "note": ""
  },
  {
   "id": "MSG_024_3_0#0",
   "speaker": "Alibaba",
   "en": "One moment.",
   "uk": "Хвилинку.",
   "note": ""
  },
  {
   "id": "MSG_024_5_0#0",
   "speaker": "Alibaba",
   "en": "Very well, I'll tell you.",
   "uk": "Гаразд, я скажу.",
   "note": ""
  },
  {
   "id": "MSG_024_6_0#0",
   "speaker": "Alibaba",
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "MSG_024_7_0#0",
   "speaker": "Alibaba",
   "en": "I believe their name[n]was... Futaba Sakura.",
   "uk": "Здається, її звати...[n]Футаба Сакура.",
   "note": ""
  },
  {
   "id": "MSG_024_8_0#0",
   "speaker": "Alibaba",
   "en": "If you fail in this mission,[n]I will expose your identity to[n]the world and to the police.",
   "uk": "Якщо провалиш це завдання,[n]я розкрию, хто ти такий,[n]усьому світові й поліції.",
   "note": ""
  },
  {
   "id": "MSG_024_9_0#0",
   "speaker": "Alibaba",
   "en": "Well then, I'll be counting on[n]you. We shall speak again after[n]the change of heart.",
   "uk": "Що ж, розраховую на тебе.[n]Поговоримо знову після[n]зміни серця.",
   "note": ""
  },
  {
   "id": "SEL_025_0_0#0",
   "speaker": null,
   "en": "Wait.",
   "uk": "Зажди.",
   "note": ""
  },
  {
   "id": "SEL_025_0_0#1",
   "speaker": null,
   "en": "Who is Futaba Sakura?",
   "uk": "Хто така Футаба Сакура?",
   "note": ""
  },
  {
   "id": "SEL_025_0_0#2",
   "speaker": null,
   "en": "Who are you?",
   "uk": "Хто ви?",
   "note": ""
  }
 ]
}