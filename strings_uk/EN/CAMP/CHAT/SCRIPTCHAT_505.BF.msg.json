{
 "file": "EN/CAMP/CHAT/SCRIPTCHAT_505.BF",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Futaba",
   "en": "You free today?",
   "uk": "Ти сьогодні вільний?",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Futaba",
   "en": "Can you come with me?[n]There's somewhere I want to go.",
   "uk": "Підеш зі мною?[n]Є місце, куди я хочу сходити.",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Futaba",
   "en": "I'll be waiting in[n]front of Leblanc.",
   "uk": "Чекатиму перед[n]«Лебланом».",
   "note": ""
  },
  {
   "id": "CHAT_NOREACTION_MSG#0",
   "speaker": "Futaba",
   "en": "I waited for you...[n]I'll ask again another[n]time, so join me then.",
   "uk": "Я чекала на тебе...[n]Ще якось спитаю,[n]тоді й підеш.",
   "note": ""
  },
  {
   "id": "CHAT_REACTION_MSG#0",
   "speaker": "Futaba",
   "en": "K. Come back quickly.",
   "uk": "Ок. Вертайся швиденько.",
   "note": ""
  },
  {
   "id": "MSG_MORUGANA#0",
   "speaker": "Morgana",
   "en": "So, what's the plan? Will you take[n]Futaba up on her invitation?",
   "uk": "То який план? Приймеш[n]запрошення Футаби?",
   "note": ""
  },
  {
   "id": "SEL_001#0",
   "speaker": null,
   "en": "Head over immediately",
   "uk": "Піти негайно",
   "note": ""
  },
  {
   "id": "SEL_001#1",
   "speaker": null,
   "en": "Check bond with Futaba",
   "uk": "Перевірити зв'язок із Футабою",
   "note": ""
  },
  {
   "id": "SEL_001#2",
   "speaker": null,
   "en": "Respond later",
   "uk": "Відповісти пізніше",
   "note": ""
  },
  {
   "id": "SEL_002#0",
   "speaker": null,
   "en": "I'm on my way.",
   "uk": "Уже йду.",
   "note": ""
  }
 ]
}