{
 "file": "EN/CAMP/CHAT/SCRIPTCHAT_450.BF",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Sojiro",
   "en": "Hey, [fName].",
   "uk": "Агов, [fName].",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Sojiro",
   "en": "You're a kind-hearted[n]young man, right?",
   "uk": "Ти ж добросердий[n]хлопець, так?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Sojiro",
   "en": "Hurry on home and prove it.",
   "uk": "Мерщій додому й доведи це.",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Sojiro",
   "en": "I mean, just come back to[n]the store, all right?",
   "uk": "Тобто просто вертайся[n]в кафе, гаразд?",
   "note": ""
  },
  {
   "id": "CHAT_NOREACTION_MSG#0",
   "speaker": "Sojiro",
   "en": "Something happen to you? Don't[n]be afraid to come back, OK?",
   "uk": "Щось сталося? Не бійся[n]повертатися, гаразд?",
   "note": ""
  },
  {
   "id": "CHAT_REACTION_MSG#0",
   "speaker": "Sojiro",
   "en": "How kind of you... All right,[n]I'll be waiting. Hurry up!",
   "uk": "Як люб'язно... Гаразд,[n]чекаю. Поквапся!",
   "note": ""
  },
  {
   "id": "MSG_MORUGANA#0",
   "speaker": "Morgana",
   "en": "What are you going to do? Will you[n]accept the chief's invitation?",
   "uk": "Що робитимеш? Приймеш[n]запрошення шефа?",
   "note": ""
  },
  {
   "id": "SEL_001#0",
   "speaker": null,
   "en": "Go home",
   "uk": "Піти додому",
   "note": ""
  },
  {
   "id": "SEL_001#1",
   "speaker": null,
   "en": "Check bond with Sojiro",
   "uk": "Перевірити зв'язок із Соджіро",
   "note": ""
  },
  {
   "id": "SEL_001#2",
   "speaker": null,
   "en": "Respond later",
   "uk": "Відповісти пізніше",
   "note": ""
  },
  {
   "id": "SEL_002#0",
   "speaker": null,
   "en": "I'll be right home.",
   "uk": "Зараз буду вдома.",
   "note": ""
  }
 ]
}