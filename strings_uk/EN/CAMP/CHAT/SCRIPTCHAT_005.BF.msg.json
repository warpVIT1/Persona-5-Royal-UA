{
 "file": "EN/CAMP/CHAT/SCRIPTCHAT_005.BF",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Ryuji",
   "en": "Man, we need cash.",
   "uk": "Блін, нам треба бабло.",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Ann",
   "en": "Sure, but why bring that up now?",
   "uk": "Ну так, але чого ти раптом про це?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Ryuji",
   "en": "Well we can get all sortsa[n]weapons and meds and shit now...",
   "uk": "Ну, тепер ми можемо брати всяку[n]зброю, ліки й таке інше...",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Ryuji",
   "en": "But we can't actually buy any[n]of it without some dough.",
   "uk": "Але без грошей нічого[n]з цього не купимо.",
   "note": ""
  },
  {
   "id": "SEL_004_0_0#0",
   "speaker": null,
   "en": "Got any savings?",
   "uk": "Є якісь заощадження?",
   "note": ""
  },
  {
   "id": "SEL_004_0_0#1",
   "speaker": null,
   "en": "So we'll earn some.",
   "uk": "Значить, заробимо.",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Ryuji",
   "en": "Nope!",
   "uk": "Не-а!",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Ryuji",
   "en": "Oh, like it's that easy.",
   "uk": "Ага, наче це так просто.",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Ann",
   "en": "We could get part-time jobs?",
   "uk": "Може, влаштуємося на підробіток?",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Ryuji",
   "en": "I dunno... Do we have to?",
   "uk": "Не знаю... А обов'язково?",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Ryuji",
   "en": "Oh shit.",
   "uk": "От чорт.",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Ryuji",
   "en": "Ushimaru's lookin' this way.",
   "uk": "Усімару дивиться сюди.",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Ryuji",
   "en": "Sorry, gotta drop out of[n]chat for a sec. Bye!",
   "uk": "Сорі, мушу на секунду вийти[n]з чату. Бувай!",
   "note": ""
  }
 ]
