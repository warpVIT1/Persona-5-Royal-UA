{
 "file": "EN/CAMP/CHAT/SCRIPTCHAT_1065.BF",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Yusuke",
   "en": "You have exams soon, right?",
   "uk": "У тебе ж скоро іспити?",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Yusuke",
   "en": "Mine are nearing too.",
   "uk": "У мене теж наближаються.",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Yusuke",
   "en": "Well, exams should be fairly[n]similar no matter where they[n]are held.",
   "uk": "Що ж, іспити, мабуть, усюди[n]доволі схожі, хай де[n]їх проводять.",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Yusuke",
   "en": "Would you like to study together?",
   "uk": "Хочеш повчитися разом?",
   "note": ""
  },
  {
   "id": "MSG_MORUGANA#0",
   "speaker": "Morgana",
   "en": "So, what's it going to be? Will you study[n]with Yusuke?",
   "uk": "Ну, що вирішиш? Повчишся[n]з Юске?",
   "note": ""
  },
  {
   "id": "SEL_001#0",
   "speaker": null,
   "en": "Study",
   "uk": "Вивчення",
   "note": ""
  },
  {
   "id": "SEL_001#1",
   "speaker": null,
   "en": "Decide later",
   "uk": "Вирішити пізніше",
   "note": ""
  },
  {
   "id": "SEL_002#0",
   "speaker": null,
   "en": "Let's do it.",
   "uk": "Ходімо.",
   "note": ""
  },
  {
   "id": "MSG_REACTION#0",
   "speaker": "Yusuke",
   "en": "Is it all right if[n]we do it at Leblanc?",
   "uk": "Нічого, якщо ми[n]позаймаємося в «Леблані»?",
   "note": ""
  },
  {
   "id": "MSG_REACTION_02#0",
   "speaker": "Yusuke",
   "en": "Save some seats for us.",
   "uk": "Займи нам місця.",
   "note": ""
  }
 ]
