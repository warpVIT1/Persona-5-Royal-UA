{
 "file": "EN/CAMP/CHAT/SCRIPTCHAT_833.BF",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Futaba",
   "en": "It's finally the big day!",
   "uk": "Нарешті настав великий день!",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Futaba",
   "en": "And you better not say it's Pi Day[n]or something. I'm not joking[n]about this!",
   "uk": "І тільки не кажи, що сьогодні День[n]числа пі чи щось таке. Я не[n]жартую!",
   "note": ""
  },
  {
   "id": "SEL_010_0_0#0",
   "speaker": null,
   "en": "Don't worry, I know.",
   "uk": "Не хвилюйся, я знаю.",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Futaba",
   "en": "...Okay. Then I'll see you[n]in Shibuya.",
   "uk": "...Гаразд. Тоді побачимося[n]в Шібуї.",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Futaba",
   "en": "I'll be waiting. Time to make[n]like a tree!",
   "uk": "Я чекатиму. Час[n]ушиватися!",
   "note": ""
  }
 ]
}