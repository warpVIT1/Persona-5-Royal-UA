{
 "file": "EN/CAMP/CHAT/SCRIPTCHAT_122.BF",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Futaba",
   "en": "Did you get the data yet?",
   "uk": "Дані вже в тебе?",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Makoto",
   "en": "No, my sister still[n]hasn't come home.",
   "uk": "Ні, сестра досі[n]не повернулася додому.",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Ryuji",
   "en": "Mannn, she's seriously that busy?",
   "uk": "Блі-і-ін, вона реально така зайнята?",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Makoto",
   "en": "Probably because of us.",
   "uk": "Мабуть, через нас.",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Ann",
   "en": "So, uh... do you still want to[n]go through with this...?",
   "uk": "То, е-е... ти досі хочеш[n]це зробити?..",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Makoto",
   "en": "Yes. I can do it.",
   "uk": "Так. Я впораюся.",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Makoto",
   "en": "Hold on, I have a message.",
   "uk": "Зачекайте, мені прийшло[n]повідомлення.",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Makoto",
   "en": "It sounds like she's[n]on her way home.",
   "uk": "Схоже, вона вже[n]їде додому.",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Ryuji",
   "en": "All right! It's finally time!",
   "uk": "Ну все! Нарешті час настав!",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Futaba",
   "en": "My heart's pounding.",
   "uk": "У мене серце калатає.",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Yusuke",
   "en": "Make sure to be cautious, OK?",
   "uk": "Будь обачною, гаразд?",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#0",
   "speaker": null,
   "en": "It's up to you.",
   "uk": "Вирішуй сама.",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#1",
   "speaker": null,
   "en": "Be careful.",
   "uk": "Будь обережний.",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Makoto",
   "en": "Understood. I'll report[n]back tomorrow.",
   "uk": "Зрозуміла. Завтра[n]про все доповім.",
   "note": ""
  },
  {
   "id": "MSG_CHAT_MORUEND_00#0",
   "speaker": "Morgana",
   "en": "Oooh, I can't wait to see what comes[n]of this...",
   "uk": "О-о-о, не терпиться побачити,[n]що з цього вийде...",
   "note": ""
  }
 ]
}