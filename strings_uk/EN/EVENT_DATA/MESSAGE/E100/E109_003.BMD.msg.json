{
 "file": "EN/EVENT_DATA/MESSAGE/E100/E109_003.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Sae",
   "en": "...There was a terrible subway accident[n]that day. You remember it, don't you?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_000_0_0#1",
   "speaker": "Sae",
   "en": "I assume you know of the uproar that[n]the public calls the \"psychotic breakdown[n]incidents.\"",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#0",
   "speaker": null,
   "en": "I might.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#1",
   "speaker": null,
   "en": "Never heard of them.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#2",
   "speaker": null,
   "en": "What does that mean?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Sae",
   "en": "You say that like it's none of your[n]business.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Sae",
   "en": "That can't possibly be true.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Sae",
   "en": "*sigh*",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Sae",
   "en": "It was all over the news, and one of the[n]victims included a teacher at your high[n]school.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#1",
   "speaker": "Sae",
   "en": "I've no doubt you heard about it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#2",
   "speaker": "Sae",
   "en": "On that day... were you still an \"ordinary\"[n]student?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_006_0_0#0",
   "speaker": null,
   "en": "What do you mean?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_006_0_0#1",
   "speaker": null,
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Sae",
   "en": "...Let me change the question.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#1",
   "speaker": "Sae",
   "en": "You transferred to Shujin Academy,[n]correct?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Sae",
   "en": "An ordinary prep school that could be[n]found in any city...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#1",
   "speaker": "Sae",
   "en": "...That's what it should've been.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Sae",
   "en": "What happened around that time?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#1",
   "speaker": "Sae",
   "en": "Tell me everything—truthfully.",
   "uk": "",
   "note": ""
  }
 ]
}