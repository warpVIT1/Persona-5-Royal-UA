{
 "file": "EN/EVENT_DATA/MESSAGE/E100/E111_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Th-That's weird... Where's the school?",
   "uk": "Д-дивно... А де школа?",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#0",
   "speaker": null,
   "en": "Where are we?",
   "uk": "Де ми?",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#1",
   "speaker": null,
   "en": "Is this our school?",
   "uk": "Це наша школа?",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#2",
   "speaker": null,
   "en": "Did we make a wrong turn?",
   "uk": "Ми десь не туди звернули?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "This SHOULD be the school... I think...",
   "uk": "Це ПОВИННА бути школа... Начебто...",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "It should be... It said \"Shujin\" on[n]the gate...",
   "uk": "Мала б бути... На воротах же було[n]написано «Сюдзін»...",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#1",
   "speaker": "Vulgar Boy",
   "en": "What's goin' on here?",
   "uk": "Що тут коїться?",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "N-No! This has to be it!",
   "uk": "Н-ні! Це має бути вона!",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#1",
   "speaker": "Vulgar Boy",
   "en": "I mean, it... should be...",
   "uk": "Тобто вона... мала б бути...",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Out of service? Where'd we end up?",
   "uk": "Не працює? Куди це нас занесло?",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "The sign was for the school, right?",
   "uk": "Табличка ж була шкільна, так?",
   "note": ""
  },
  {
   "id": "SEL_008_0_0#0",
   "speaker": null,
   "en": "Yeah.",
   "uk": "Ага.",
   "note": ""
  },
  {
   "id": "SEL_008_0_0#1",
   "speaker": null,
   "en": "What's going on here?",
   "uk": "Що тут коїться?",
   "note": ""
  },
  {
   "id": "SEL_008_0_0#2",
   "speaker": null,
   "en": "I wasn't paying attention.",
   "uk": "Я не звернув уваги.",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Right!? You saw it too!",
   "uk": "Правда ж!? Ти теж бачив!",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "I-I dunno! I wanna know!",
   "uk": "Я-я не знаю! Сам хочу знати!",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Geez, you freaked me out...",
   "uk": "Тьху, налякав мене...",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#1",
   "speaker": "Vulgar Boy",
   "en": "Who're you? You a student?",
   "uk": "Ти хто? Учень?",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Man, your costume's impressive...[n]Is that armor real?",
   "uk": "Чувак, крутий у тебе костюм...[n]Це справжні обладунки?",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "C'mon, don't just stand there.[n]Say somethin'.",
   "uk": "Ну, чого стоїш як стовп?[n]Скажи щось.",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "...H-Hey, what's goin' on?",
   "uk": "...А-агов, що відбувається?",
   "note": ""
  },
  {
   "id": "SEL_017_0_0#0",
   "speaker": null,
   "en": "Is he school staff?",
   "uk": "Він зі шкільного персоналу?",
   "note": ""
  },
  {
   "id": "SEL_017_0_0#1",
   "speaker": null,
   "en": "This must be a prank.",
   "uk": "Це, мабуть, розіграш.",
   "note": ""
  },
  {
   "id": "SEL_017_0_0#2",
   "speaker": null,
   "en": "What is this?",
   "uk": "Що це таке?",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Dude, I don't know!",
   "uk": "Чувак, я не знаю!",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "You really think so?",
   "uk": "Ти справді так думаєш?",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Dude, I don't know!",
   "uk": "Чувак, я не знаю!",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "...This shit's real.",
   "uk": "...Це, бляха, по-справжньому.",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "C-Calm down! Time out, man!",
   "uk": "С-спокійно! Тайм-аут, чуваче!",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "We gotta run!",
   "uk": "Треба тікати!",
   "note": ""
  },
  {
   "id": "SEL_024_0_0#0",
   "speaker": null,
   "en": "Run?",
   "uk": "Тікати?",
   "note": ""
  },
  {
   "id": "SEL_024_0_0#1",
   "speaker": null,
   "en": "Got it.",
   "uk": "Зрозумів.",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Yeah, we better not mess with 'em! Go!",
   "uk": "Ага, краще з ними не зв'язуватися! Біжи!",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Stop standin' around and run!",
   "uk": "Годі стовбичити, тікай!",
   "note": ""
  },
  {
   "id": "MSG_027_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Ugh, what's with these guys!?",
   "uk": "Тьху, та що з цими типами!?",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Gah!",
   "uk": "А-а!",
   "note": ""
  },
  {
   "id": "MSG_029_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Oww... Y-You're gonna break my bones,[n]dammit!",
   "uk": "Ай... В-ви мені кістки поламаєте,[n]чорт забирай!",
   "note": ""
  },
  {
   "id": "MSG_029_0_0#1",
   "speaker": "Vulgar Boy",
   "en": "The hell you think you're— Aagh!",
   "uk": "Якого біса ви... А-а-а!",
   "note": ""
  },
  {
   "id": "MSG_030_0_0#0",
   "speaker": "Guard's Voice",
   "en": "Take them away!",
   "uk": "Забрати їх!",
   "note": ""
  }
 ]
}