{
 "file": "EN/EVENT_DATA/MESSAGE/E100/E110_001.BMD",
 "entries": [
  {
   "id": "MND_000_0_0#0",
   "speaker": null,
   "en": "Pervy teacher...",
   "uk": "Збоченець-учитель...",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Hm?",
   "uk": "Хм?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "...What do you want?",
   "uk": "...Чого тобі?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#1",
   "speaker": "Vulgar Boy",
   "en": "You plannin' on rattin' me out to[n]Kamoshida?",
   "uk": "Збираєшся настукати на мене[n]Камошіді?",
   "note": ""
  },
  {
   "id": "SEL_003_0_0#0",
   "speaker": null,
   "en": "Kamoshida?",
   "uk": "Камошіді?",
   "note": ""
  },
  {
   "id": "SEL_003_0_0#1",
   "speaker": null,
   "en": "What do you mean?",
   "uk": "Що ти маєш на увазі?",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Huh? In that car just now. It was[n]Kamoshida.",
   "uk": "Га? У тій машині щойно. Це був[n]Камошіда.",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "He does whatever the hell he wants.[n]Who does he think he is—the king of[n]a castle? Don't you agree?",
   "uk": "Робить що йому, бляха, заманеться.[n]Він що, думає, що він король у своєму[n]замку? Скажи ж?",
   "note": ""
  },
  {
   "id": "SEL_007_0_0#0",
   "speaker": null,
   "en": "The king of a castle?",
   "uk": "Король у замку?",
   "note": ""
  },
  {
   "id": "SEL_007_0_0#1",
   "speaker": null,
   "en": "Which castle?",
   "uk": "У якому замку?",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "No, I mean...",
   "uk": "Та ні, я про те...",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Uh, it's just a sayin'...",
   "uk": "Е-е, це просто вислів такий...",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "...Wait. You don't know Kamoshida?[n]Are you for real?",
   "uk": "...Стоп. Ти не знаєш Камошіду?[n]Ти серйозно?",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#1",
   "speaker": "Vulgar Boy",
   "en": "You're from Shujin, right?",
   "uk": "Ти ж із Шуджін, так?",
   "note": ""
  },
  {
   "id": "SEL_012_0_0#0",
   "speaker": null,
   "en": "I think so...",
   "uk": "Наче так...",
   "note": ""
  },
  {
   "id": "SEL_012_0_0#1",
   "speaker": null,
   "en": "You go to Shujin too?",
   "uk": "Ти теж ходиш до Шуджін?",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "...You messin' with me?",
   "uk": "...Ти з мене глузуєш?",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#1",
   "speaker": "Vulgar Boy",
   "en": "You're wearing a Shujin uniform.",
   "uk": "На тобі ж форма Шуджін.",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "What? No other high school's got a[n]uniform like this.",
   "uk": "Що? Ні в якій іншій школі[n]немає такої форми.",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "A second-year, huh... We're the same[n]grade then.",
   "uk": "Другокурсник, га... Отже, ми[n]однолітки.",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Never seen you before though.",
   "uk": "Але я тебе раніше не бачив.",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Oh, you a transfer student?",
   "uk": "О, ти що, переведений?",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Then no wonder you don't know him.",
   "uk": "Тоді не дивно, що ти його не знаєш.",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "This rain ain't too bad. We better hurry[n]up, or we'll be late.",
   "uk": "Дощ уже не такий сильний. Краще[n]поквапмося, бо запізнимося.",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Nnh...",
   "uk": "Нгх...",
   "note": ""
  },
  {
   "id": "MND_025_0_0#0",
   "speaker": null,
   "en": "I feel light-headed for some reason...",
   "uk": "Чомусь паморочиться в голові...",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Vulgar Boy",
   "en": "Uuugh, my head hurts...",
   "uk": "У-у-ух, голова болить...",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#1",
   "speaker": "Vulgar Boy",
   "en": "Dammit... I wanna go home...",
   "uk": "Чорт... Хочу додому...",
   "note": ""
  }
 ]
}