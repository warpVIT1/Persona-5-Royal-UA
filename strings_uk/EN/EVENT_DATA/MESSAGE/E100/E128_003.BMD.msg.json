{
 "file": "EN/EVENT_DATA/MESSAGE/E100/E128_003.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Ryuji",
   "en": "Huh?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Ryuji",
   "en": "We're at school...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#1",
   "speaker": "Ryuji",
   "en": "There wasn't anything out of place along[n]the way, right? I didn't see no castle[n]either...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Ryuji",
   "en": "...We must've made a wrong turn[n]somewhere.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#1",
   "speaker": "Ryuji",
   "en": "Let's try again.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_003_0_0#0",
   "speaker": null,
   "en": "Again?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_003_0_0#1",
   "speaker": null,
   "en": "I want to go home.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Ryuji",
   "en": "Don't worry. I won't mess up this time.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Ryuji",
   "en": "C'mon, you gotta stick with me to the end.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Ryuji",
   "en": "Let's go.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Ryuji",
   "en": "For real?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Ryuji",
   "en": "Is it smaller than we think it is?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Ryuji",
   "en": "What do you think?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#0",
   "speaker": null,
   "en": "Check on your phone.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#1",
   "speaker": null,
   "en": "Are you sure it's around here?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Ryuji",
   "en": "I already did that.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#1",
   "speaker": "Ryuji",
   "en": "I didn't see anything like it around here...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Ryuji",
   "en": "I'm not so sure anymore...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#1",
   "speaker": "Ryuji",
   "en": "When I checked on my phone, I didn't[n]see anything like it around here...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Ryuji",
   "en": "Huh? Phone...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Ryuji",
   "en": "Hey, that reminds me—didn't you have a[n]navigation app thingy on, back then?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_016_0_0#0",
   "speaker": null,
   "en": "Navigation app?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_016_0_0#1",
   "speaker": null,
   "en": "I dunno.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Ryuji",
   "en": "I dunno if it was or not, but I heard stuff[n]that sounded like one comin' from your[n]phone.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Ryuji",
   "en": "You didn't notice? I heard stuff that[n]sounded like one comin' from your[n]phone.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Ryuji",
   "en": "Y'know, didn't it say stuff like \"returned[n]to the real world\" or something like that?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#1",
   "speaker": "Ryuji",
   "en": "Lemme see your phone for a bit.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Ryuji",
   "en": "What's this eyeball-lookin' thing?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_023_0_0#0",
   "speaker": null,
   "en": "It just appeared.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_023_0_0#1",
   "speaker": null,
   "en": "I can't delete it...",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_023_0_0#2",
   "speaker": null,
   "en": "Cute logo, huh?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Ryuji",
   "en": "What?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Ryuji",
   "en": "Wait, what?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Ryuji",
   "en": "That's not how I'd describe it...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_027_0_0#0",
   "speaker": "Ryuji",
   "en": "What a weird app...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Ryuji",
   "en": "...Oh wait, this is it!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_029_0_0#0",
   "speaker": "Ryuji",
   "en": "I knew it—it IS a navigation app![n]There's even your search history!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_029_5_0#0",
   "speaker": "Ryuji",
   "en": "Oh man, I'm such a genius!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_030_0_0#0",
   "speaker": "Ryuji",
   "en": "Let's try usin' it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_031_0_0#0",
   "speaker": null,
   "en": "I dunno about this.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_031_0_0#1",
   "speaker": null,
   "en": "But I don't know how.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_032_0_0#0",
   "speaker": "Ryuji",
   "en": "Why? All we're doin' is startin' an app.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_034_0_0#0",
   "speaker": "Ryuji",
   "en": "Then I'll do it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_035_0_0#0",
   "speaker": "Metaverse Navigator",
   "en": "Kamoshida... Shujin Academy...[n]Pervert... Castle...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_035_0_0#1",
   "speaker": "Metaverse Navigator",
   "en": "Beginning navigation.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_036_0_0#0",
   "speaker": "Ryuji",
   "en": "There we go!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_037_0_0#0",
   "speaker": "Ryuji",
   "en": "...Then, we went in a certain direction,[n]and—",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_038_0_0#0",
   "speaker": "Ryuji",
   "en": "Hey, what're you—",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_039_0_0#0",
   "speaker": "Ryuji",
   "en": "...Huh?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_040_0_0#0",
   "speaker": "Ryuji",
   "en": "What the hell!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_041_0_0#0",
   "speaker": "Metaverse Navigator",
   "en": "You have arrived at your destination.[n]Ending navigation.",
   "uk": "",
   "note": ""
  }
 ]
}