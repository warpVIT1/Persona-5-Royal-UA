{
 "file": "EN/EVENT_DATA/MESSAGE/E100/E159_101.BMD",
 "entries": [
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Ryuji",
   "en": "But daaamn...",
   "uk": "Але ж че-е-ерт...",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Ann",
   "en": "Hm? What's up?",
   "uk": "Гм? Що таке?",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Ryuji",
   "en": "N-Nothing. I-I was just thinkin' we should[n]choose a code name for you too.",
   "uk": "Н-нічого. Я-я просто подумав, що тобі[n]теж треба вибрати кодове ім'я.",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Ann",
   "en": "A code name?",
   "uk": "Кодове ім'я?",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Ryuji",
   "en": "I'm Skull, he's Joker, and that's Mona.",
   "uk": "Я — Череп, він — Джокер, а це — Мона.",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Morgana",
   "en": "Judging by your costume...",
   "uk": "Судячи з твого костюма...",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Ryuji",
   "en": "I mean, she's got that tail and stuff, so...",
   "uk": "Ну, в неї ж хвіст і все таке, тож...",
   "note": ""
  },
  {
   "id": "MSG_010_5_0#0",
   "speaker": "Ryuji",
   "en": "Whadda you think, [fName]?",
   "uk": "Що скажеш, [fName]?",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#0",
   "speaker": null,
   "en": "Catgirl.",
   "uk": "Дівчина-кішка.",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#1",
   "speaker": null,
   "en": "Sexy Cat.",
   "uk": "Сексі-кішка.",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#2",
   "speaker": null,
   "en": "Kitty Woman.",
   "uk": "Жінка-кицька.",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Ann",
   "en": "Wait! Is that what you're going to call me[n]from now on!? I am SO not down with[n]this!",
   "uk": "Стоп! Ви що, отак мене відтепер[n]і називатимете!? Я ЗОВСІМ на таке[n]не згодна!",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Ryuji",
   "en": "What do you wanna be called, then?",
   "uk": "А як тоді хочеш називатися?",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Ann",
   "en": "Um, something better than just[n]a little cat...",
   "uk": "Е-е, якось краще, ніж просто[n]кицька...",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Ann",
   "en": "Maybe... \"Panther\"?",
   "uk": "Може... «Пантера»?",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#1",
   "speaker": "Ann",
   "en": "That sounds pretty cool, doesn't it?",
   "uk": "Звучить доволі круто, правда?",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Ryuji",
   "en": "Huh? Why?",
   "uk": "Га? Чому?",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Ann",
   "en": "'Cause it sounds more... ferocious?",
   "uk": "Бо звучить більш... хижо?",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Morgana",
   "en": "She's a cougar...",
   "uk": "Вона хижачка...",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Ann",
   "en": "Don't call me that!",
   "uk": "Не називай мене так!",
   "note": ""
  },
  {
   "id": "MSG_019_5_0#0",
   "speaker": "Ann",
   "en": "More importantly: Kamoshida!",
   "uk": "Є дещо важливіше: Камошіда!",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Ryuji",
   "en": "Oh, right. Let's go!",
   "uk": "А, точно. Ходімо!",
   "note": ""
  }
 ]
}