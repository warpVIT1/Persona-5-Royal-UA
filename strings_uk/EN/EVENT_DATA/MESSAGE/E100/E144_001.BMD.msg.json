{
 "file": "EN/EVENT_DATA/MESSAGE/E100/E144_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Ann",
   "en": "Will you please give it a rest!?[n]I told you, I'm not feeling up to it...",
   "uk": "Може, вже дасте мені спокій!?[n]Я ж казала, що мені не до того...",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Ann",
   "en": "Wait, what!? That's not what you[n]promised! And you call yourself[n]a teacher!?",
   "uk": "Стривайте, що!? Ви такого не обіцяли![n]І ви ще називаєте себе[n]учителем!?",
   "note": ""
  },
  {
   "id": "MSG_001_5_0#0",
   "speaker": "Ann",
   "en": "This has nothing to do with Shiho!",
   "uk": "Шіхо тут ні до чого!",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Ann",
   "en": "Ah...",
   "uk": "Ах...",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Ann",
   "en": "Shiho's... starting position...",
   "uk": "Місце Шіхо... в основному складі...",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Ann",
   "en": "Wait... Were you listening?",
   "uk": "Стривай... Ти підслуховував?",
   "note": ""
  },
  {
   "id": "SEL_005_0_0#0",
   "speaker": null,
   "en": "I was eavesdropping.",
   "uk": "Я підслуховував.",
   "note": ""
  },
  {
   "id": "SEL_005_0_0#1",
   "speaker": null,
   "en": "Not on purpose.",
   "uk": "Не навмисно.",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Ann",
   "en": "Haven't you heard of privacy?",
   "uk": "Ти що, не чув про особистий простір?",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Ann",
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#1",
   "speaker": "Ann",
   "en": "...No, I was out of line. Sorry.",
   "uk": "...Ні, я перегнула палицю. Вибач.",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Ann",
   "en": "So how much did you hear?",
   "uk": "То скільки ти почув?",
   "note": ""
  },
  {
   "id": "SEL_009_0_0#0",
   "speaker": null,
   "en": "You were arguing.",
   "uk": "Ви сперечалися.",
   "note": ""
  },
  {
   "id": "SEL_009_0_0#1",
   "speaker": null,
   "en": "Something about a friend.",
   "uk": "Щось про подругу.",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Ann",
   "en": "I see... That is true...",
   "uk": "Он як... Це правда...",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Ann",
   "en": "Shiho...",
   "uk": "Шіхо...",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Ann",
   "en": "It's nothing at all.",
   "uk": "Це зовсім нічого.",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#1",
   "speaker": "Ann",
   "en": "Nothing...",
   "uk": "Нічого...",
   "note": ""
  }
 ]
}