{
 "file": "EN/EVENT_DATA/MESSAGE/E400/E484_120.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Kasumi",
   "en": "Whew...",
   "uk": "Хух...",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Kasumi",
   "en": "Ngh...",
   "uk": "Нгх...",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Morgana",
   "en": "Hey, are you all right?",
   "uk": "Гей, з тобою все гаразд?",
   "note": ""
  },
  {
   "id": "MSG_002_3_0#0",
   "speaker": "Kasumi",
   "en": "I can't... be weak anymore...",
   "uk": "Я більше... не можу бути слабкою...",
   "note": ""
  },
  {
   "id": "MSG_002_5_0#0",
   "speaker": "(SE)芳♀ かすみ",
   "en": "Hrrrrrrah!",
   "uk": "Х-р-р-ра-а-а!",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Morgana",
   "en": "Whoa!",
   "uk": "Ого!",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#1",
   "speaker": "Morgana",
   "en": "I'm quite impressed, considering how[n]you just awakened to your Persona[n]and all.",
   "uk": "Я вражений — надто з огляду на те,[n]що твоя Персона щойно[n]пробудилася.",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Kasumi",
   "en": "[lName]-senpai... Right?",
   "uk": "[lName]-семпай... Так?",
   "note": ""
  },
  {
   "id": "SEL_005_0_0#0",
   "speaker": null,
   "en": "Yeah.",
   "uk": "Ага.",
   "note": ""
  },
  {
   "id": "SEL_005_0_0#1",
   "speaker": null,
   "en": "How'd you know?",
   "uk": "Звідки ти знаєш?",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Kasumi",
   "en": "...I knew it.",
   "uk": "...Я так і знала.",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Kasumi",
   "en": "I could tell from your voice, and your posture.",
   "uk": "Я впізнала вас за голосом[n]і за поставою.",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Kasumi",
   "en": "By the way...",
   "uk": "До речі...",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Kasumi",
   "en": "...Why are we dressed like this now?",
   "uk": "...А чому ми тепер так одягнені?",
   "note": ""
  },
  {
   "id": "SEL_014_0_0#0",
   "speaker": null,
   "en": "It's a really long story.",
   "uk": "Це дуже довга історія.",
   "note": ""
  },
  {
   "id": "SEL_014_0_0#1",
   "speaker": null,
   "en": "Curious, eh?",
   "uk": "Що, цікаво?",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Morgana",
   "en": "Well, of course. This has to be awfully[n]confusing for her.",
   "uk": "Ще б пак. Вона, певно, геть[n]нічого не розуміє.",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Morgana",
   "en": "...Looks like they've found us.",
   "uk": "...Схоже, нас знайшли.",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#1",
   "speaker": "Morgana",
   "en": "Time to get out of here, quick.[n]We can explain later.",
   "uk": "Час забиратися звідси, швидко.[n]Пояснимо потім.",
   "note": ""
  },
  {
   "id": "SEL_017_0_0#0",
   "speaker": null,
   "en": "Follow my lead.",
   "uk": "Іди за мною.",
   "note": ""
  },
  {
   "id": "SEL_017_0_0#1",
   "speaker": null,
   "en": "Let's escape together.",
   "uk": "Тікаймо разом.",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Kasumi",
   "en": "Right!",
   "uk": "Так!",
   "note": ""
  }
 ]
}