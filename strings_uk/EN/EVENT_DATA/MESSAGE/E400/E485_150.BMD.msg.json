 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Kasumi",
   "en": "Oh, [lName]-senpai!",
   "uk": "О, [lName]-семпай!",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Kasumi",
   "en": "There's something I'd like to discuss[n]with you.",
   "uk": "Я хотіла б дещо з вами[n]обговорити.",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#1",
   "speaker": "Kasumi",
   "en": "Would you mind if I joined you for[n]lunch?",
   "uk": "Ви не проти, якщо я пообідаю[n]з вами?",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#0",
   "speaker": null,
   "en": "Not at all.",
   "uk": "Анітрохи.",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#1",
   "speaker": null,
   "en": "What is it?",
   "uk": "Що таке?",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Kasumi",
   "en": "Thank you.",
   "uk": "Дякую.",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Kasumi",
   "en": "All right, let's head to the roof.",
   "uk": "Гаразд, ходімо на дах.",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Kasumi",
   "en": "Let's discuss that elsewhere.",
   "uk": "Поговорімо про це деінде.",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Kasumi",
   "en": "What say we head to the roof?",
   "uk": "Може, піднімемося на дах?",
   "note": ""
  }
 ]
