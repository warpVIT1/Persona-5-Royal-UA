  {
   "id": "SEL_001_0_0#1",
   "speaker": null,
   "en": "What a great day.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Kasumi",
   "en": "And good morning to you!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Kasumi",
   "en": "Isn't it?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Kasumi",
   "en": "It's been quite a while since we last met[n]at school like this.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Kasumi",
   "en": "Thank you for your efforts in changing[n]Representative Shido's heart.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_006_0_0#0",
   "speaker": null,
   "en": "Thanks.",
