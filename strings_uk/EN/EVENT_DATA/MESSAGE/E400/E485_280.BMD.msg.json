   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Kasumi",
   "en": "But, I suppose we ought to deal with[n]exams first.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#1",
   "speaker": "Kasumi",
   "en": "I'll be in touch afterwards.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Kasumi",
   "en": "Please excuse me!",
   "uk": "",
   "note": ""
