   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Kasumi",
   "en": "I can understand why.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Kasumi",
   "en": "We should go somewhere to celebrate.",
