{
 "file": "EN/EVENT_DATA/MESSAGE/E400/E480_070.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Sojiro",
   "en": "Everyone's giving you the cold shoulder.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_000_0_0#1",
   "speaker": "Sojiro",
   "en": "That's what having a criminal record[n]does to you.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_000_5_0#0",
   "speaker": "Sojiro",
   "en": "Turns out your past follows you[n]wherever you go.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Sojiro",
   "en": "By the way... if you get expelled now,[n]I won't hesitate to kick you out. Got it?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#0",
   "speaker": null,
   "en": "I'll be careful.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#1",
   "speaker": null,
   "en": "I think I'll scrape by.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Sojiro",
   "en": "Hm...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Sojiro",
   "en": "I could save us all a little time and just[n]kick you out now if that's gonna be your[n]attitude.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Sojiro",
   "en": "*sigh* School never changes, huh?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Sojiro",
   "en": "Come on, we're going home.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Mysterious Voice",
   "en": "...Well then, it's a deal.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#1",
   "speaker": "Mysterious Voice",
   "en": "I'm sure your wish will come true.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Mysterious Voice",
   "en": "From today onward, you are...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Sojiro",
   "en": "What's wrong?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_010_0_0#0",
   "speaker": null,
   "en": "I heard a voice...",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_010_0_0#1",
   "speaker": null,
   "en": "It's nothing.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_010_0_0#2",
   "speaker": null,
   "en": "I guess I made a deal?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Sojiro",
   "en": "I didn't hear it...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Sojiro",
   "en": "...Well, good.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Sojiro",
   "en": "Oh, you mean what the principal said?[n]I dunno if I'd call it anything that formal,[n]though.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Sojiro",
   "en": "...Anyway, time for us to head back.",
   "uk": "",
   "note": ""
  }
 ]
}