   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Sojiro",
   "en": "This is obstruction of business, you know.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Agent Leader",
   "en": "...We've investigated this thoroughly.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
