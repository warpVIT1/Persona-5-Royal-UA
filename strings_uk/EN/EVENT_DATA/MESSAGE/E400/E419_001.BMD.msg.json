   "en": "Where are the Phantom Thieves?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Sojiro",
   "en": "If you're not a customer, I'm gonna[n]have to ask you to leave.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Agent Leader",
   "en": "He's an accomplice. Take him away.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Sojiro",
   "en": "Don't get all cocky. You're just some[n]useless criminal's lapdog.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#1",
   "speaker": "Sojiro",
   "en": "Justice isn't on your side.",
   "uk": "",
   "note": ""
  }
 ]
