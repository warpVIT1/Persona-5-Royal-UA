   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Sojiro",
   "en": "Oh, you mean those guys they've been[n]talking about on TV?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Agent Leader",
   "en": "Don't play dumb with me.",
