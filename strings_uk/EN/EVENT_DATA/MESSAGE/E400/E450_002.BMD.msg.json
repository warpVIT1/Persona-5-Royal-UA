{
 "file": "EN/EVENT_DATA/MESSAGE/E400/E450_002.BMD",
 "entries": [
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Ryuji",
   "en": "That... son of a bitch!",
   "uk": "Ах ти ж... сучий сину!",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Ryuji",
   "en": "Goddammit...",
   "uk": "Хай йому біс...",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Ryuji",
   "en": "What's this creepy-ass shit abou— Ugh!",
   "uk": "Що це за моторошне лайно... Ох!",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Ryuji",
   "en": "Ow... Huh?",
   "uk": "Ай... Га?",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Ryuji",
   "en": "Aaaaaaaaagh!",
   "uk": "А-а-а-а-а-а-а!",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Ryuji",
   "en": "My... My hand!",
   "uk": "Моя... Моя рука!",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Ann",
   "en": "Ryuji?",
   "uk": "Рюджі?",
   "note": ""
  },
  {
   "id": "MSG_027_0_0#0",
   "speaker": "Makoto",
   "en": "This can't be real, right?",
   "uk": "Це ж не може бути насправді, так?",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Yusuke",
   "en": "What is happening to us?",
   "uk": "Що з нами відбувається?",
   "note": ""
  },
  {
   "id": "MSG_029_0_0#0",
   "speaker": "Haru",
   "en": "No... no!",
   "uk": "Ні... ні!",
   "note": ""
  },
  {
   "id": "MSG_030_0_0#0",
   "speaker": "Futaba",
   "en": "My body's... disappearing...",
   "uk": "Моє тіло... зникає...",
   "note": ""
  },
  {
   "id": "MSG_031_0_0#0",
   "speaker": "Morgana",
   "en": "Don't tell me...",
   "uk": "Тільки не кажи...",
   "note": ""
  },
  {
   "id": "MSG_032_0_0#0",
   "speaker": "Holy Grail",
   "en": "Indeed. This isn't my doing.",
   "uk": "Саме так. Але це не моїх рук справа.",
   "note": ""
  },
  {
   "id": "MSG_033_0_0#0",
   "speaker": "Holy Grail",
   "en": "You imbeciles are about to disappear from the people's cognition.",
   "uk": "Ви, недоумки, от-от зникнете з[n]когніції людей.",
   "note": ""
  },
  {
   "id": "MSG_034_0_0#0",
   "speaker": "Ryuji",
   "en": "That damn voice!",
   "uk": "Знову цей клятий голос!",
   "note": ""
  },
  {
   "id": "MSG_035_0_0#0",
   "speaker": "Holy Grail",
   "en": "Mementos and reality have become one...",
   "uk": "Мементос і реальність злилися воєдино...",
   "note": ""
  },
  {
   "id": "MSG_036_0_0#0",
   "speaker": "Holy Grail",
   "en": "Thus, those who have disappeared from[n]cognition cannot exist anywhere.",
   "uk": "Тож той, хто зник із когніції, не може[n]існувати ніде.",
   "note": ""
  },
  {
   "id": "MSG_037_0_0#0",
   "speaker": "Ryuji",
   "en": "Disappear my ass... What the hell!",
   "uk": "Та щоб я зник? Що за чортівня!",
   "note": ""
  },
  {
   "id": "MSG_038_0_0#0",
   "speaker": "Ryuji",
   "en": "AAAA—",
   "uk": "А-А-А-А...",
   "note": ""
  },
  {
   "id": "MSG_039_0_0#0",
   "speaker": "Ann",
   "en": "Ryuji!",
   "uk": "Рюджі!",
   "note": ""
  },
  {
   "id": "MSG_040_0_0#0",
   "speaker": "Yusuke",
   "en": "Is this really it? Augh—",
   "uk": "Невже це кінець? Ах...",
   "note": ""
  },
  {
   "id": "MSG_042_0_0#0",
   "speaker": "Futaba",
   "en": "No! No—",
   "uk": "Ні! Ні...",
   "note": ""
  },
  {
   "id": "MSG_041_0_0#0",
   "speaker": "Makoto",
   "en": "Morgana... where did we... go wro—",
   "uk": "Моргано... де ми... помилилися...",
   "note": ""
  },
  {
   "id": "MSG_043_0_0#0",
   "speaker": "Haru",
   "en": "Ah... Aah...",
   "uk": "А... А-а...",
   "note": ""
  },
  {
   "id": "MSG_044_0_0#0",
   "speaker": "Morgana",
   "en": "Is this all my fault?",
   "uk": "Це все через мене?",
   "note": ""
  },
  {
   "id": "MSG_045_0_0#0",
   "speaker": "Morgana",
   "en": "Because I... brought you all there?",
   "uk": "Бо це я... привів вас усіх туди?",
   "note": ""
  },
  {
   "id": "SEL_046_0_0#0",
   "speaker": null,
   "en": "What's going on?",
   "uk": "Що сталося?",
   "note": ""
  },
  {
   "id": "SEL_046_0_0#1",
   "speaker": null,
   "en": "It's not your fault.",
   "uk": "Ти не винен.",
   "note": ""
  },
  {
   "id": "SEL_046_0_0#2",
   "speaker": null,
   "en": "Are we going to die?",
   "uk": "Ми помремо?",
   "note": ""
  },
  {
   "id": "MSG_047_0_0#0",
   "speaker": "Morgana",
   "en": "Dammit...",
   "uk": "Чорт...",
   "note": ""
  },
  {
   "id": "MSG_048_0_0#0",
   "speaker": "Morgana",
   "en": "I didn't mean to... I-I'm...",
   "uk": "Я не хотів... Я... я...",
   "note": ""
  },
  {
   "id": "MSG_049_0_0#0",
   "speaker": "Morgana",
   "en": "A-Aah...",
   "uk": "А... А-а...",
   "note": ""
  },
  {
   "id": "MSG_050_0_0#0",
   "speaker": "Morgana",
   "en": "I'm sorry... The mission's... a failure...",
   "uk": "Пробачте... Місію... провалено...",
   "note": ""
  }
 ]
}