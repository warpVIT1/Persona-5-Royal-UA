{
 "file": "EN/EVENT_DATA/MESSAGE/E400/E453_001.BMD",
 "entries": [
  {
   "id": "MND_000_0_0#0",
   "speaker": null,
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "MND_000_0_0#1",
   "speaker": null,
   "en": "Where am I...?",
   "uk": "Де я...?",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Sojiro",
   "en": "Hey...",
   "uk": "Гей...",
   "note": ""
  },
  {
   "id": "MSG_001_5_0#0",
   "speaker": "Sojiro",
   "en": "Coffee good for you?",
   "uk": "Каву будеш?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Man in a Suit",
   "en": ". That is your[n]name, yes?",
   "uk": ". Це твоє ім'я,[n]так?",
   "note": ""
  },
  {
   "id": "SEL_003_0_0#0",
   "speaker": null,
   "en": "That's right.",
   "uk": "Саме так.",
   "note": ""
  },
  {
   "id": "SEL_003_0_0#1",
   "speaker": null,
   "en": "What do you want?",
   "uk": "Чого тобі треба?",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Man in a Suit",
   "en": "...Congratulations.",
   "uk": "...Вітаю.",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#1",
   "speaker": "Man in a Suit",
   "en": "You've been chosen by god. As such,[n]we will protect you at all costs.",
   "uk": "Тебе обрав бог. Тож ми захищатимемо[n]тебе будь-якою ціною.",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Man in a Suit",
   "en": "You'll be an inmate from here on.",
   "uk": "Відтепер ти — в'язень.",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#1",
   "speaker": "Man in a Suit",
   "en": "You've truly made the right choice.",
   "uk": "Ти справді зробив правильний вибір.",
   "note": ""
  },
  {
   "id": "SEL_006_0_0#0",
   "speaker": null,
   "en": "I agree.",
   "uk": "Згоден.",
   "note": ""
  },
  {
   "id": "SEL_006_0_0#1",
   "speaker": null,
   "en": "What are you saying?",
   "uk": "Що ти таке кажеш?",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Sojiro",
   "en": "I wish I could've become an inmate too...",
   "uk": "Шкода, що я теж не міг стати в'язнем...",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Man in a Suit",
   "en": "Well then... you're coming with us.",
   "uk": "Отже... ти підеш із нами.",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#1",
   "speaker": "Man in a Suit",
   "en": "Mankind will face ruin in no time, after all.",
   "uk": "Зрештою, людство от-от загине.",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Sojiro",
   "en": "*sigh* We're ruined already...",
   "uk": "*зітхає* Ми вже й так загинули...",
   "note": ""
  }
 ]
}