{
 "file": "EN/EVENT_DATA/MESSAGE/E400/E499_010.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Boy in White",
   "en": "Hmm...",
   "uk": "Хм-м...",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Boy in White",
   "en": "How about this one?",
   "uk": "А як щодо цієї?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Morgana",
   "en": "Huh?",
   "uk": "Га?",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Boy in White",
   "en": "Ooh!",
   "uk": "О-о!",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#1",
   "speaker": "Boy in White",
   "en": "Tasty...",
   "uk": "Смачно...",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Boy in White",
   "en": "...But it's not right. This doesn't taste[n]like I was told it would.",
   "uk": "...Але не те. На смак не така,[n]як мені казали.",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#1",
   "speaker": "Boy in White",
   "en": "*sigh* l've looked all over for it, too...",
   "uk": "*зітхає* А я ж скрізь її шукав...",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Boy in White",
   "en": "Hm?",
   "uk": "Хм?",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#1",
   "speaker": "Boy in White",
   "en": "There's something about him...",
   "uk": "У ньому щось є...",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Boy in White",
   "en": "...I see.",
   "uk": "...Ясно.",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#1",
   "speaker": "Boy in White",
   "en": "If it's not here, I guess I'll have to[n]search the other side.",
   "uk": "Якщо тут немає, мабуть, доведеться[n]шукати з того боку.",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Boy in White",
   "en": "Thanks for the tasty flower!",
   "uk": "Дякую за смачну квітку!",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Boy in White",
   "en": "And thanks to you, too...",
   "uk": "І тобі теж дякую...",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#1",
   "speaker": "Boy in White",
   "en": "...For the hint you gave me.",
   "uk": "...За підказку, яку ти мені дав.",
   "note": ""
  },
  {
   "id": "SEL_009_0_0#0",
   "speaker": null,
   "en": "You're welcome.",
   "uk": "Нема за що.",
   "note": ""
  },
  {
   "id": "SEL_009_0_0#1",
   "speaker": null,
   "en": "I didn't do anything.",
   "uk": "Я нічого не зробив.",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Boy in White",
   "en": "......?",
   "uk": "......?",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Boy in White",
   "en": "Did you actually see me?",
   "uk": "Ти справді мене бачив?",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#1",
   "speaker": "Boy in White",
   "en": "Nah, no way...",
   "uk": "Та ні, не може бути...",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Morgana",
   "en": "What was that kid's deal? He just...[n]drank from a flower.",
   "uk": "Що з тим хлопцем? Він просто...[n]випив квітку.",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#1",
   "speaker": "Morgana",
   "en": "And what was he muttering about[n]some \"other side\"?",
   "uk": "І що він бурмотів про[n]якийсь «той бік»?",
   "note": ""
  }
 ]
}