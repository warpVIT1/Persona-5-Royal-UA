{
 "file": "EN/EVENT_DATA/MESSAGE/E400/E469_001.BMD",
 "entries": [
  {
   "id": "MSG_000_5_0#0",
   "speaker": "Tearful Woman",
   "en": "Someone... Someone just disappeared!",
   "uk": "Хтось... Хтось щойно зник!",
   "note": ""
  },
  {
   "id": "MSG_000_7_0#0",
   "speaker": "Pale Man",
   "en": "What the hell!? What's going on!?",
   "uk": "Якого біса?! Що відбувається?!",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Frightened Punk",
   "en": "Do something, dammit! Aren't you[n]the police!?",
   "uk": "Зробіть щось, чорт забирай![n]Ви ж поліція!",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Young Officer",
   "en": "Please, you have to calm down!",
   "uk": "Прошу, заспокойтеся!",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#1",
   "speaker": "Young Officer",
   "en": "Sir, what's going on here!?",
   "uk": "Пане, що тут відбувається?!",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Veteran Officer",
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Shocked Man",
   "en": "It's no use...",
   "uk": "Усе марно...",
   "note": ""
  },
  {
   "id": "MSG_006_5_0#0",
   "speaker": "Morgana",
   "en": "And we'll definitely... definitely...",
   "uk": "І ми неодмінно... неодмінно...",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Shocked Man",
   "en": "Huh...?",
   "uk": "Га...?",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Morgana",
   "en": "Take the world!",
   "uk": "Заберемо цей світ!",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Attentive Male Student",
   "en": "...What was this again?",
   "uk": "...Що ж це було таке?",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Veteran Officer",
   "en": "...The Phantom Thieves?",
   "uk": "...Фантомні Злодії?",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Young Officer",
   "en": "Weren't the Phantom Thieves those—",
   "uk": "Хіба Фантомні Злодії — це не ті—",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Timid Female Student",
   "en": "They haven't given up yet...",
   "uk": "Вони ще не здалися...",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Young Man in a Suit",
   "en": "Can they even do anything about[n]a situation like this?",
   "uk": "Та чи можуть вони взагалі[n]щось удіяти в такій ситуації?",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Introverted Young Man",
   "en": "No, it's impossible... There's no way...",
   "uk": "Ні, це неможливо... Аж ніяк...",
   "note": ""
  }
 ]
}