  {
   "id": "MSG_017_5_0#0",
   "speaker": "Kasumi",
   "en": "What are you talking about?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "(SE)女の声その1",
   "en": "I heard the school moved her exam[n]period. Must be nice getting perks[n]like that...",
