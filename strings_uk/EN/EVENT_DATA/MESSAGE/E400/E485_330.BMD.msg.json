{
 "file": "EN/EVENT_DATA/MESSAGE/E400/E485_330.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Voice from Intercom",
   "en": "Where are you going?",
   "uk": "Куди ти йдеш?",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#0",
   "speaker": null,
   "en": "I'm going home.",
   "uk": "Я їду додому.",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#1",
   "speaker": null,
   "en": "I'm leaving this place.",
   "uk": "Я йду звідси.",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Voice from Intercom",
   "en": "Home?",
   "uk": "Додому?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#1",
   "speaker": "Voice from Intercom",
   "en": "But isn't this where you belong?",
   "uk": "Але хіба твоє місце не тут?",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Voice from Intercom",
   "en": "Leave?",
   "uk": "Ідеш?",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#1",
   "speaker": "Voice from Intercom",
   "en": "But, this is where you belong.",
   "uk": "Але ж твоє місце тут.",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Voice from Intercom",
   "en": "...I see.",
   "uk": "...Зрозуміло.",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#1",
   "speaker": "Voice from Intercom",
   "en": "So you still haven't accepted it...",
   "uk": "Отже, ти досі цього не прийняв...",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#2",
   "speaker": "Voice from Intercom",
   "en": "Well, I won't force you into anything.",
   "uk": "Що ж, я ні до чого тебе[n]не силуватиму.",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Voice from Intercom",
   "en": "Let's meet again...",
   "uk": "Зустріньмося ще...",
   "note": ""
  }
 ]
}