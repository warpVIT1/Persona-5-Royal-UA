{
 "file": "EN/EVENT_DATA/MESSAGE/E400/E481_010.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "Sorry, but I'm in a bit of a hurry.",
   "uk": "Вибачте, але я трохи поспішаю.",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Slimy Middle-Aged Man",
   "en": "You go to Shujin, right?",
   "uk": "Ти ж із Сюдзіну, так?",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#1",
   "speaker": "Slimy Middle-Aged Man",
   "en": "I heard things have been rough there[n]lately, what with that violent incident.[n]You wanna go talk about it somewhere?",
   "uk": "Чув, у вас там останнім часом непросто —[n]після того випадку з насильством.[n]Може, підемо кудись, поговоримо?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "Thank you for your concern.",
   "uk": "Дякую за турботу.",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#1",
   "speaker": "Student Called Yoshizawa",
   "en": "However, I really am in a hurry, so[n]if you'd excuse me...",
   "uk": "Але я справді поспішаю, тож[n]із вашого дозволу...",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "...Ah!",
   "uk": "...Ай!",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Slimy Middle-Aged Man",
   "en": "C'mon, there's no need to be shy.",
   "uk": "Та годі, нема чого соромитися.",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "Like I said...",
   "uk": "Я ж сказала...",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Slimy Middle-Aged Man",
   "en": "If you're busy, I'll put my number in[n]your phone so you can call me later.[n]Sound like a plan?",
   "uk": "Якщо ти зайнята, я запишу свій номер[n]у твій телефон — подзвониш пізніше.[n]Домовилися?",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "Stop it...",
   "uk": "Припиніть...",
   "note": ""
  },
  {
   "id": "MND_009_0_0#0",
   "speaker": null,
   "en": "I can't overlook this...",
   "uk": "Я не можу на це просто дивитися...",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "Uhhh...",
   "uk": "Е-е-е...",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Slimy Middle-Aged Man",
   "en": "What do you want?",
   "uk": "Тобі чого?",
   "note": ""
  },
  {
   "id": "SEL_012_0_0#0",
   "speaker": null,
   "en": "You're hurting her.",
   "uk": "Їй боляче.",
   "note": ""
  },
  {
   "id": "SEL_012_0_0#1",
   "speaker": null,
   "en": "I go to Shujin too.",
   "uk": "Я теж із Сюдзіну.",
   "note": ""
  },
  {
   "id": "SEL_012_0_0#2",
   "speaker": null,
   "en": "Could I ask you for directions?",
   "uk": "Не підкажете дорогу?",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Slimy Middle-Aged Man",
   "en": "Don't get worked up. I'm just being[n]friendly here.",
   "uk": "Не кип'ятися. Я просто[n]по-дружньому.",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Slimy Middle-Aged Man",
   "en": "Huh? Uhhh...",
   "uk": "Га? Е-е-е...",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Slimy Middle-Aged Man",
   "en": "What are you asking me for?",
   "uk": "А чого ти в мене питаєш?",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Slimy Middle-Aged Man",
   "en": "Oh, what the...",
   "uk": "Та що за...",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#1",
   "speaker": "Slimy Middle-Aged Man",
   "en": "What're you getting so jumpy about?[n]Like you're anything special!",
   "uk": "Чого ти так смикаєшся?[n]Теж мені, цяця!",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "MSG_018_5_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "Thank you so much! I'm sorry for[n]the trouble!",
   "uk": "Щиро вам дякую! Вибачте[n]за клопіт!",
   "note": ""
  },
  {
   "id": "SEL_019_0_0#0",
   "speaker": null,
   "en": "Are you okay?",
   "uk": "Ти в порядку?",
   "note": ""
  },
  {
   "id": "SEL_019_0_0#1",
   "speaker": null,
   "en": "Was that guy hassling you?",
   "uk": "Той тип до тебе чіплявся?",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "Yes, I'm fine now!",
   "uk": "Так, уже все гаразд!",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#1",
   "speaker": "Student Called Yoshizawa",
   "en": "It was pretty scary, though...",
   "uk": "Хоча було доволі страшно...",
   "note": ""
  },
  {
   "id": "MSG_020_5_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "Yes, that was rather scary...",
   "uk": "Так, було доволі страшно...",
   "note": ""
  },
  {
   "id": "MSG_020_5_0#1",
   "speaker": "Student Called Yoshizawa",
   "en": "But I'm all right now!",
   "uk": "Але зараз уже все добре!",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#1",
   "speaker": "Student Called Yoshizawa",
   "en": "Ah— Um...",
   "uk": "Ой... Е-е...",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "May I ask you something?",
   "uk": "Можна вас дещо запитати?",
   "note": ""
  },
  {
   "id": "MSG_025_5_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "So... what made you step in to help me?",
   "uk": "Скажіть... чому ви вирішили[n]мені допомогти?",
   "note": ""
  },
  {
   "id": "SEL_023_0_0#0",
   "speaker": null,
   "en": "Because I wanted to.",
   "uk": "Бо захотів.",
   "note": ""
  },
  {
   "id": "SEL_023_0_0#1",
   "speaker": null,
   "en": "I couldn't look the other way.",
   "uk": "Не міг пройти повз.",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "That's it?",
   "uk": "І це все?",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "I... see.",
   "uk": "Ось... як.",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "Well, I apologize for asking something[n]so strange. You're headed to the cleanup[n]as well, right?",
   "uk": "Що ж, вибачте за таке дивне[n]запитання. Ви теж ідете[n]на прибирання, так?",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#1",
   "speaker": "Student Called Yoshizawa",
   "en": "...The cleanup...?",
   "uk": "...Прибирання?..",
   "note": ""
  },
  {
   "id": "MSG_027_0_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "*gasp* Look at the time!",
   "uk": "*зойк* Ой, котра вже година!",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "I'm so sorry, I haven't even thanked[n]you properly yet!",
   "uk": "Вибачте, я ж навіть не подякувала[n]вам як слід!",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#1",
   "speaker": "Student Called Yoshizawa",
   "en": "Oh no! I forgot my gym clothes at[n]school! I'll see you at the cleanup, soon.",
   "uk": "О ні! Я забула спортивну форму[n]в школі! Побачимося на прибиранні.",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#2",
   "speaker": "Student Called Yoshizawa",
   "en": "We can talk more then, if you'd like.",
   "uk": "Там і поговоримо, якщо захочете.",
   "note": ""
  },
  {
   "id": "MSG_029_0_0#0",
   "speaker": "Student Called Yoshizawa",
   "en": "Pardon me!",
   "uk": "Вибачте, я побігла!",
   "note": ""
  }
 ]
}