{
 "file": "EN/EVENT_DATA/MESSAGE/E400/E428_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Ann",
   "en": "Huh!? Didn't we come from this way!?",
   "uk": "Га!? Хіба ми не звідси прийшли!?",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Ryuji",
   "en": "We can't get through like—",
   "uk": "Так ми не пройдемо—",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Yusuke",
   "en": "What is happening!?",
   "uk": "Що відбувається!?",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Ryuji",
   "en": "Hey, Oracle!",
   "uk": "Гей, Оракуле!",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Futaba",
   "en": "The ship is exploding... but why!?",
   "uk": "Корабель вибухає... але чому!?",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Ryuji",
   "en": "What kinda sloppy explanation is that!?",
   "uk": "Це що за халтурне пояснення!?",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Futaba",
   "en": "I don't know what's happening either!",
   "uk": "Я теж не знаю, що відбувається!",
   "note": ""
  },
  {
   "id": "MSG_007_3_0#0",
   "speaker": "Morgana",
   "en": "Something might've happened to Shido[n]in the real world!",
   "uk": "Може, щось сталося з Шідо в реальному[n]світі!",
   "note": ""
  },
  {
   "id": "MSG_007_6_0#0",
   "speaker": "Ryuji",
   "en": "Whaddya mean \"something\"!?",
   "uk": "Що значить «щось»!?",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Morgana",
   "en": "I don't know!",
   "uk": "Не знаю!",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Ann",
   "en": "Standing around here isn't going to help!",
   "uk": "Стоячи тут, ми нічого не змінимо!",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Haru",
   "en": "We have to run!",
   "uk": "Треба тікати!",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Makoto",
   "en": "Oracle! Are there any other escape[n]routes!?",
   "uk": "Оракуле! Є ще якісь шляхи до втечі!?",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Futaba",
   "en": "I'm looking, but...",
   "uk": "Шукаю, але...",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Makoto",
   "en": "What about that way!?",
   "uk": "А як щодо того боку!?",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Haru",
   "en": "No!",
   "uk": "Ні!",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Makoto",
   "en": "Our path...",
   "uk": "Наш шлях...",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Yusuke",
   "en": "Still, where else can we go!?",
   "uk": "Але куди ж іще нам іти!?",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Ryuji",
   "en": "Crap, this side too!",
   "uk": "Чорт, і тут теж!",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Ann",
   "en": "Are we... sinking?",
   "uk": "Ми... тонемо?",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Morgana",
   "en": "We are not gonna die like this!",
   "uk": "Ми не помремо отак!",
   "note": ""
  }
 ]
}