{
 "file": "EN/EVENT_DATA/MESSAGE/E500/E511_601.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Maruki",
   "en": "I'm sorry.",
   "uk": "Вибачте.",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Maruki",
   "en": "I said I didn't care what'd happen to me...",
   "uk": "Я казав, що мені байдуже,[n]що станеться зі мною...",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Maruki",
   "en": "But I guess...",
   "uk": "Але, мабуть...",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Maruki",
   "en": "I wasn't committed to my words...",
   "uk": "Я не був вірний своїм словам...",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Maruki",
   "en": "You too, huh?",
   "uk": "Ти теж, еге ж?",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Sumire",
   "en": "Crow-senpai, what are you—!?",
   "uk": "Вороне, що ти—!?",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Akechi",
   "en": "Can't you tell?",
   "uk": "Хіба не видно?",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Akechi",
   "en": "Tch!",
   "uk": "Тц!",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Maruki",
   "en": "You think the same thing, don't you?",
   "uk": "Ти думаєш так само, правда?",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Maruki",
   "en": "Of course you do...",
   "uk": "Звісно, так...",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Maruki",
   "en": "After all...",
   "uk": "Зрештою...",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Sumire",
   "en": "No, you can't!",
   "uk": "Ні, не можна!",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Akechi",
   "en": "We hesitate right now—we die!",
   "uk": "Завагаємося зараз — загинемо!",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Morgana",
   "en": "Up there!",
   "uk": "Он там!",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Maruki",
   "en": "I'm all yours... Use me... however you want...",
   "uk": "Я весь твій... Використай мене... як хочеш...",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Maruki",
   "en": "Now... show us... the reality...",
   "uk": "А тепер... покажи нам... реальність...",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Maruki",
   "en": "The reality... we wish for...",
   "uk": "Реальність... якої ми прагнемо...",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Maruki",
   "en": "I am thou and...",
   "uk": "Я — це ти, і...",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Adam Kadmon",
   "en": "...thou art I!",
   "uk": "...ти — це я!",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Futaba",
   "en": "Incoming!",
   "uk": "Атакує!",
   "note": ""
  }
 ]
}