  {
   "id": "MSG_000_0_0#0",
   "speaker": "Maruki",
   "en": "I'm sorry.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Maruki",
   "en": "I said I didn't care what'd happen to me...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Maruki",
   "en": "But I guess...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Maruki",
   "en": "I wasn't committed to my words...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Maruki",
   "en": "You too, huh?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Sumire",
   "en": "Crow-senpai, what are you—!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Akechi",
   "en": "Can't you tell?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Akechi",
   "en": "Tch!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Maruki",
   "en": "You think the same thing, don't you?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Maruki",
   "en": "Of course you do...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Maruki",
   "en": "After all...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Sumire",
   "en": "No, you can't!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Akechi",
   "en": "We hesitate right now—we die!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Morgana",
   "en": "Up there!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Maruki",
   "en": "I'm all yours... Use me... however you want...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Maruki",
   "en": "Now... show us... the reality...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Maruki",
   "en": "The reality... we wish for...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Maruki",
   "en": "I am thou and...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Adam Kadmon",
   "en": "...thou art I!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Futaba",
   "en": "Incoming!",
   "uk": "",
   "note": ""
  }
 ]
