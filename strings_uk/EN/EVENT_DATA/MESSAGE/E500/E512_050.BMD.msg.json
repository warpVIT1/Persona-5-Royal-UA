{
 "file": "EN/EVENT_DATA/MESSAGE/E500/E512_050.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Metaverse Navigator",
   "en": "A new area has been confirmed.[n]Updating guidance information.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Ryuji",
   "en": "Whoa, everything got all different.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Sumire",
   "en": "Hm? What's that?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Jose",
   "en": "Hey, good job.",
   "uk": "Агов, молодець.",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Ann",
   "en": "Oh, Jose.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Sumire",
   "en": "Wait... a kid? Driving?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_5_0#0",
   "speaker": "Sumire",
   "en": "And you all happen to know him[n]already?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_5_0#1",
   "speaker": "Sumire",
   "en": "Is there anybody you don't know?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Jose",
   "en": "There's a flower here...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#1",
   "speaker": "Jose",
   "en": "...but this one smells a bit different from[n]the others.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#2",
   "speaker": "Jose",
   "en": "Let's see how it tastes.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Jose",
   "en": "Gah!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Jose",
   "en": "Hmm...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#1",
   "speaker": "Jose",
   "en": "Aw, I guess I shouldn't be picky.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Jose",
   "en": "I'm going to move on further.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#1",
   "speaker": "Jose",
   "en": "Are you guys doing the same?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_013_0_0#0",
   "speaker": null,
   "en": "Not sure yet.",
   "uk": "Ще не знаю.",
   "note": ""
  },
  {
   "id": "SEL_013_0_0#1",
   "speaker": null,
   "en": "If I feel like it.",
   "uk": "Якщо буде настрій.",
   "note": ""
  },
  {
   "id": "MSG_014_1_0#0",
   "speaker": "Jose",
   "en": "I see.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_1_0#1",
   "speaker": "Jose",
   "en": "Whether or not you do, let me know if[n]you find any more flowers.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_1_0#2",
   "speaker": "Jose",
   "en": "I'll reward you well for them.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Jose",
   "en": "Well, good job.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Sumire",
   "en": "What an odd kid.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Akechi",
   "en": "It would be much odder if the Metaverse[n]were as logical as the real world is.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Futaba",
   "en": "Be careful if you're going any further,[n]all right?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#1",
   "speaker": "Futaba",
   "en": "I'm getting all sorts of strange readings—[n]Shadows too.",
   "uk": "",
   "note": ""
  }
 ]
}