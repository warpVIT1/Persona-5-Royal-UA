 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Lavenza",
   "en": "Please allow me to experience for myself[n]the results of your true rehabilitation.",
   "uk": "Прошу, дозвольте мені самій відчути[n]плоди вашої справжньої реабілітації.",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Lavenza",
   "en": "Are you prepared now?",
   "uk": "Тепер ви готові?",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#0",
   "speaker": null,
   "en": "I'm good to go.",
   "uk": "Я готовий.",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#1",
   "speaker": null,
   "en": "One sec.",
   "uk": "Секунду.",
   "note": ""
  },
  {
