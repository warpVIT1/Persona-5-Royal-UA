{
 "file": "EN/EVENT_DATA/MESSAGE/E500/E511_393.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Maruki",
   "en": "I can give you strength...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Maruki",
   "en": "So you don't have to suffer.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Sumire",
   "en": "Doctor...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Maruki",
   "en": "Tell me: if you want your pain to end...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Maruki",
   "en": "...and desire to live as Kasumi...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Maruki",
   "en": "I'll actualize it!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Sumire",
   "en": "Huh!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Sumire",
   "en": "Ngh— Aaaaaah!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Akechi",
   "en": "Did he—!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Maruki",
   "en": "Sadly, she has lost sight of herself... She's in pain.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Maruki",
   "en": "Now, be her guide... and together,[n]escape from the nightmare!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Cendrillon",
   "en": "No, I... I can't...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Cendrillon",
   "en": "I don't want to go back to my life in cinders, ever again!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Akechi",
   "en": "What the hell...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Akechi",
   "en": "This so-called \"kindness\" of his disgusts me.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_5_0#0",
   "speaker": "Akechi",
   "en": "This so-called \"kindness\" of his disgusts me.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Akechi",
   "en": "Let's do this quick.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Cendrillon",
   "en": "I refuse to go back! I'm happy here...[n]THIS is where I belong!",
   "uk": "",
   "note": ""
  }
 ]
