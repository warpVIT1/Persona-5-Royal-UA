{
 "file": "EN/EVENT_DATA/MESSAGE/E500/E511_145.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Kasumi",
   "en": "Why?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Akechi",
   "en": "......",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#1",
   "speaker": "Akechi",
   "en": "That was your father in the video just[n]now, wasn't it, Yoshizawa-san?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#2",
   "speaker": "Akechi",
   "en": "And the one he was speaking to...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Kasumi",
   "en": "......",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#1",
   "speaker": "Kasumi",
   "en": "...Sumire.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#2",
   "speaker": "Kasumi",
   "en": "My younger sister... Sumire Yoshizawa.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Kasumi",
   "en": "...I'd mentioned to you that I've lost[n]a family member, right?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Kasumi",
   "en": "But, how was this video—",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_5_0#0",
   "speaker": "Kasumi",
   "en": "Nngh!",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_006_0_0#0",
   "speaker": null,
   "en": "Are you okay?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_006_0_0#1",
   "speaker": null,
   "en": "What's wrong?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Kasumi",
   "en": "I'm sorry...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#1",
   "speaker": "Kasumi",
   "en": "I don't know what's been wrong with[n]me lately.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#2",
   "speaker": "Kasumi",
   "en": "I've been getting this feeling, like...[n]like I need to remember something, but[n]at the same time, I oughtn't remember it...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Akechi",
   "en": "......",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Akechi",
   "en": "Can you still walk, Yoshizawa-san?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#1",
   "speaker": "Akechi",
   "en": "Whatever it is that's happening, we[n]have to keep going if we hope to[n]learn more about it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Kasumi",
   "en": "Yes—I'm all right! Let's go.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Akechi",
   "en": "...Hey.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Akechi",
   "en": "When was it that you said you became[n]acquainted with Yoshizawa-san?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_013_0_0#0",
   "speaker": null,
   "en": "Last spring.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_013_0_0#1",
   "speaker": null,
   "en": "After transferring here.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Akechi",
   "en": "I see...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#1",
   "speaker": "Akechi",
   "en": "Anyway, let's move out. I suspect[n]we still have a long way to go.",
   "uk": "",
   "note": ""
  }
 ]
}