{
 "file": "EN/EVENT_DATA/MESSAGE/E500/E512_095.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Jose",
   "en": "Hey there. Good job.",
   "uk": "Привіт. Молодець.",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Jose",
   "en": "Since you're here, does that mean you're[n]ready to fight me now?",
   "uk": "Раз ти тут, то, мабуть, готовий[n]зі мною битися?",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#0",
   "speaker": null,
   "en": "Not yet.",
   "uk": "Ще ні.",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#1",
   "speaker": null,
   "en": "Let's move out.",
   "uk": "Вирушаймо.",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Jose",
   "en": "Okay...",
   "uk": "Ясно...",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#1",
   "speaker": "Jose",
   "en": "Just come back if you change your mind.",
   "uk": "Просто повертайся, якщо передумаєш.",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#2",
   "speaker": "Jose",
   "en": "I stop here from time to time, so swing[n]by if you're in the area.",
   "uk": "Я час від часу тут зупиняюся, тож[n]заходь, якщо будеш поблизу.",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Jose",
   "en": "Well, see you later. Good job.",
   "uk": "Ну, до зустрічі. Молодець.",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Jose",
   "en": "Thanks.",
   "uk": "Дякую.",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Jose",
   "en": "Well... here I come!",
   "uk": "Ну... я йду!",
   "note": ""
  }
 ]
}