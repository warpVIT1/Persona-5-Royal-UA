{
 "file": "EN/EVENT_DATA/MESSAGE/E500/E511_595.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Maruki",
   "en": "Azathoth...",
   "uk": "Азатоте...",
   "note": ""
  },
  {
   "id": "MSG_000_0_0#1",
   "speaker": "Maruki",
   "en": "Did I... fail?",
   "uk": "Невже я... зазнав невдачі?",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Ann",
   "en": "Is that...?",
   "uk": "Це...?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Morgana",
   "en": "...It's Maruki's Treasure.",
   "uk": "...Це Скарб Марукі.",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Haru",
   "en": "What is it, though? ...A torch?",
   "uk": "Але що це? ...Смолоскип?",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Akechi",
   "en": "A torch is a light to guide people—it may[n]symbolize his perception of himself[n]as the guide for the entire world.",
   "uk": "Смолоскип — це світло, що веде людей.[n]Можливо, це символ того, як він бачить себе[n]провідником для всього світу.",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Akechi",
   "en": "We're here to change his heart, aren't[n]we? Go on, take it.",
   "uk": "Ми ж тут, щоб змінити його серце,[n]так? Ну ж бо, бери.",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Maruki",
   "en": "So... This is it...",
   "uk": "Отже... Ось і все...",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Futaba",
   "en": "This place is collapsing!",
   "uk": "Тут усе руйнується!",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Yusuke",
   "en": "We'd better take our leave.",
   "uk": "Нам краще йти.",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Maruki",
   "en": "Rumi... I'm sorry... I couldn't...",
   "uk": "Румі... Вибач... Я не зміг...",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Maruki",
   "en": "No, I... I can still...!",
   "uk": "Ні, я... я ще можу...!",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Makoto",
   "en": "Joker, look out!",
   "uk": "Джокере, обережно!",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Ryuji",
   "en": "Dammit... We've gotta book it!",
   "uk": "Чорт... Треба тікати!",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Morgana",
   "en": "Guys! Jump in!",
   "uk": "Народ! Застрибуйте!",
   "note": ""
  }
 ]
}