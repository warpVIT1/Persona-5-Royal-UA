{
 "file": "EN/EVENT_DATA/MESSAGE/E500/E511_625.BMD",
 "entries": [
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Maruki",
   "en": "*sob*",
   "uk": "*схлипує*",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Maruki",
   "en": "Haaaaaah!",
   "uk": "Ха-а-а-а!",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Maruki",
   "en": "Ah...",
   "uk": "Ах...",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Maruki",
   "en": "I'm done. I get it now.",
   "uk": "Досить. Тепер я розумію.",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Maruki",
   "en": "All thanks to you.",
   "uk": "Усе завдяки тобі.",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "(SE)丸喜 拓人",
   "en": "Ah...",
   "uk": "Ах...",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "(SE)主人公",
   "en": "Ngh...",
   "uk": "Нгх...",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Maruki",
   "en": "Huh?",
   "uk": "Га?",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Maruki",
   "en": "Come on...",
   "uk": "Ну ж бо...",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Maruki",
   "en": "I said I'm done.",
   "uk": "Я ж сказав, досить.",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Maruki",
   "en": "Please... let go of my hand.",
   "uk": "Будь ласка... відпусти мою руку.",
   "note": ""
  },
  {
   "id": "SEL_012_0_0#0",
   "speaker": null,
   "en": "We're going back together.",
   "uk": "Ми повертаємося разом.",
   "note": ""
  },
  {
   "id": "SEL_012_0_0#1",
   "speaker": null,
   "en": "I won't let it end like this.",
   "uk": "Я не дам цьому так закінчитися.",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Maruki",
   "en": "Your eyes are as bright and honest as ever...",
   "uk": "Твої очі ясні й чесні, як завжди...",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Maruki",
   "en": "You keep your head up, no matter what...",
   "uk": "Ти не опускаєш голови, хай там що...",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Maruki",
   "en": "I must have always been... afraid...",
   "uk": "Мабуть, я завжди... боявся...",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Maruki",
   "en": "Afraid you and I wouldn't wish for the same reality...",
   "uk": "Боявся, що ми бажатимемо різної реальності...",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Maruki",
   "en": "So bright...",
   "uk": "Так яскраво...",
   "note": ""
  }
 ]
}