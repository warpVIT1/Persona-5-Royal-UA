{
 "file": "EN/EVENT_DATA/MESSAGE/E500/E521_013.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Igor",
   "en": "*chuckle* Magnificent.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Lavenza",
   "en": "We have indeed witnessed your[n]decision.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Lavenza",
   "en": "Not only have you taken back mankind's[n]future for itself...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#1",
   "speaker": "Lavenza",
   "en": "But you've also re-established our[n]reason for existence.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Lavenza",
   "en": "While reality had been wholly distorted,[n]your actions have guided it back towards[n]what it ought to be.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_004_0_0#0",
   "speaker": null,
   "en": "What it ought to be?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_004_0_0#1",
   "speaker": null,
   "en": "Reality's been reverted?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Lavenza",
   "en": "That is correct.",
   "uk": "Саме так.",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#1",
   "speaker": "Lavenza",
   "en": "Time itself cannot be rewound, but every[n]past event will revert to the event that[n]should have occurred instead.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_006_0_0#0",
   "speaker": null,
   "en": "What should've occurred instead...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Sae",
   "en": "I'll ask you once more.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#1",
   "speaker": "Sae",
   "en": "I'd like for you to turn yourself in[n]to the police, of your own accord.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Lavenza",
   "en": "Indeed... Once you leave this room,[n]you will find yourself in...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_009_0_0#0",
   "speaker": null,
   "en": "...A painful reality.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Lavenza",
   "en": "Have you begun to regret your decision?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#0",
   "speaker": null,
   "en": "Of course not.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#1",
   "speaker": null,
   "en": "No, I stand by it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Lavenza",
   "en": "I see...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#1",
   "speaker": "Lavenza",
   "en": "Then it would be rather uncouth of me[n]to keep you here any longer.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Sae",
   "en": "I'll ask you once more.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#1",
   "speaker": "Sae",
   "en": "I'd like for you to turn yourself in[n]to the police, of your own accord.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Akechi",
   "en": "...I will carve my own path for myself.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#1",
   "speaker": "Akechi",
   "en": "I refuse to accept a reality concocted by[n]someone else, stuck under their control[n]for the rest of my days.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Lavenza",
   "en": "......",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_016_0_0#0",
   "speaker": null,
   "en": "What will happen to me?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_016_0_0#1",
   "speaker": null,
   "en": "What happens to Akechi?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Lavenza",
   "en": "Everything will return to how it[n]should be... Everything.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#1",
   "speaker": "Lavenza",
   "en": "There are no exceptions.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_018_0_0#0",
   "speaker": null,
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "MND_018_0_0#1",
   "speaker": null,
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Lavenza",
   "en": "Have your regrets begun?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_020_0_0#0",
   "speaker": null,
   "en": "No, I'm still sure.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_020_0_0#1",
   "speaker": null,
   "en": "There's no alternative.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_020_0_0#2",
   "speaker": null,
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Lavenza",
   "en": "I see...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Lavenza",
   "en": "It seems you are still resolute in this matter.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Lavenza",
   "en": "......",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Lavenza",
   "en": "Choosing such a path must not have[n]been easy for you...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Lavenza",
   "en": "For that, you have our utmost respect[n]and gratitude, [f 4 3].",
   "uk": "",
   "note": ""
  }
 ]
}