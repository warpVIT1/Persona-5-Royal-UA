{
 "file": "EN/EVENT_DATA/MESSAGE/E700/E751_010.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Haru",
   "en": "Apologies for the imposition, but[n]I really wanted some time with you.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#0",
   "speaker": null,
   "en": "I feel the same way.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#1",
   "speaker": null,
   "en": "Of course. It's Christmas Eve.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#2",
   "speaker": null,
   "en": "I was waiting for your call.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Haru",
   "en": "Really? Hee hee, I'm so glad[n]to hear that!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Haru",
   "en": "Yes! I'm so glad you understand.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Haru",
   "en": "Really? Then I'll be sure to call[n]you much sooner next year.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Haru",
   "en": "Well then. Would you like to get[n]dinner with me somewhere?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Haru",
   "en": "Shall we?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Haru",
   "en": "...What's wrong?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_008_0_0#0",
   "speaker": null,
   "en": "Let's hold hands.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_008_0_0#1",
   "speaker": null,
   "en": "How about a little romance?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Haru",
   "en": "Of course. We are a couple, and[n]this is Christmas Eve...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#1",
   "speaker": "Haru",
   "en": "Holding hands would be normal,[n]even expected... right?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Haru",
   "en": "...If you would.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Haru",
   "en": "Ah—romance? I-I'm afraid I'm not[n]sure what that entails...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Haru",
   "en": "Perhaps we could hold hands?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Haru",
   "en": "*giggle* I'm getting butterflies.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#1",
   "speaker": "Haru",
   "en": "Shall we head over?",
   "uk": "",
   "note": ""
  }
 ]
}