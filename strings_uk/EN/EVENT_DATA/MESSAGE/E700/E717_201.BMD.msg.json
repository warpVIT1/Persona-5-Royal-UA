{
 "file": "EN/EVENT_DATA/MESSAGE/E700/E717_201.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Hifumi",
   "en": "...You don't seem focused again today.[n]Your poor play is a result of your lack[n]of attention.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_000_0_0#1",
   "speaker": "Hifumi",
   "en": "Yes... an error caused by carelessness...[n]That term within shogi is called... what?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_001_0_0#0",
   "speaker": null,
   "en": "This question will affect Hifumi's trust[n]in me. I have to answer it correctly!",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#0",
   "speaker": null,
   "en": "Blunder.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#1",
   "speaker": null,
   "en": "Oopsies.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#2",
   "speaker": null,
   "en": "Fail.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Hifumi",
   "en": "...So you do know.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#1",
   "speaker": "Hifumi",
   "en": "How could I suspect you, who studies[n]twice as hard as anyone? It seems[n]I was the one at fault.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_004_0_0#0",
   "speaker": null,
   "en": "I was somehow able to maintain[n]her trust!",
   "uk": "Мені якось вдалося зберегти[n]її довіру!",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Hifumi",
   "en": "...Did you just have a \"blunder\"?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#1",
   "speaker": "Hifumi",
   "en": "I can't believe you don't even know that...[n]Are you really passionate about shogi?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#2",
   "speaker": "Hifumi",
   "en": "You're unbelievable... Please leave.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_990_0_0#0",
   "speaker": null,
   "en": "Hifumi is starting to lose her trust[n]in me...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_006_0_0#0",
   "speaker": null,
   "en": "She saw through my lies!",
   "uk": "Вона розкусила мою брехню!",
   "note": ""
  },
  {
   "id": "MND_006_0_0#1",
   "speaker": null,
   "en": "I have to regain her trust...",
   "uk": "",
   "note": ""
  }
 ]
}