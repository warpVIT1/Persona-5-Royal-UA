{
 "file": "EN/EVENT_DATA/MESSAGE/E700/E748_030.BMD",
 "entries": [
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "All right, that was a great performance[n]by the dance club!",
   "uk": "Отже, це був чудовий виступ[n]танцювального клубу!",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#1",
   "speaker": "Post-Festival MC",
   "en": "Everybody give them another[n]round of applause!",
   "uk": "Ану, всі, ще раз оплески[n]для них!",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Ryuji",
   "en": "...That sucked.",
   "uk": "...Відстій.",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "And now, it's time for your[n]favorite Shujin tradition:[n]the Student Sharing Special!",
   "uk": "А тепер — ваша улюблена традиція[n]Шуджін: Великий студентський[n]відвертий мікрофон!",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#1",
   "speaker": "Post-Festival MC",
   "en": "Round of applause, everyone!",
   "uk": "Оплески, будь ласка!",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Ryuji",
   "en": "They're doin' this again...?",
   "uk": "Вони знову це влаштовують...?",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "All right, who has something to say?[n]Anyone, anyone!?",
   "uk": "Отже, кому є що сказати?[n]Хто-небудь, хто-небудь!?",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Ryuji",
   "en": "Over here! Over here!",
   "uk": "Сюди! Сюди!",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#1",
   "speaker": "Ryuji",
   "en": "This guy's got something!",
   "uk": "Ось у нього є що сказати!",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Mishima",
   "en": "What!?",
   "uk": "Що!?",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "Hmmm... Where is \"this guy\"?",
   "uk": "Гм-м... І де ж цей «він»?",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#1",
   "speaker": "Post-Festival MC",
   "en": "I can't seem to find him! Oh well![n]Uh, Blondie, step on up here!",
   "uk": "Щось не бачу! Ну й гаразд![n]Е-е, білявчику, виходь сюди!",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Ryuji",
   "en": "What!?",
   "uk": "Що!?",
   "note": ""
  },
  {
   "id": "SEL_013_0_0#0",
   "speaker": null,
   "en": "This is karma.",
   "uk": "Це карма.",
   "note": ""
  },
  {
   "id": "SEL_013_0_0#1",
   "speaker": null,
   "en": "Good luck.",
   "uk": "Успіху.",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Mishima",
   "en": "Exactly.",
   "uk": "Саме так.",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Ryuji",
   "en": "For real!?",
   "uk": "Серйозно!?",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "Come, come. Everyone's waiting!",
   "uk": "Ну ж бо, ну ж бо. Усі чекають!",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Ryuji",
   "en": "Dammit...",
   "uk": "Чорт...",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "And what is your name?",
   "uk": "А як тебе звати?",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Ryuji",
   "en": "Sakamoto...",
   "uk": "Сакамото...",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "Ah, Sakamoto-kun!",
   "uk": "А, Сакамото!",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#1",
   "speaker": "Post-Festival MC",
   "en": "You look like someone filled to the brim[n]with pent-up anger toward society!",
   "uk": "Ти схожий на людину, вщерть повну[n]затаєної злості на суспільство!",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#2",
   "speaker": "Post-Festival MC",
   "en": "Anyway, on with the show![n]What would you like to share[n]with us today, Sakamoto-kun?",
   "uk": "Хай там як, продовжуємо шоу![n]Чим ти хочеш поділитися з нами[n]сьогодні, Сакамото?",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "Sakamoto-kun...?",
   "uk": "Сакамото...?",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Ryuji",
   "en": "Ummm... Uhhh...",
   "uk": "Е-е-е... Ем-м...",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Mishima",
   "en": "Huh...?",
   "uk": "Га...?",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "What's this!? Our Sakamoto-kun may[n]look tough, but it turns out he[n]has a nasty case of stage fright!",
   "uk": "Що це!? Наш Сакамото, може, й[n]виглядає крутим, але, виявляється,[n]страшенно боїться сцени!",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "Here, I'll give you a question...",
   "uk": "Гаразд, я поставлю вам запитання...",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#1",
   "speaker": "Post-Festival MC",
   "en": "Do you think the Phantom Thieves[n]are really Shujin students?",
   "uk": "Як ви думаєте, Фантомні Злодії[n]справді учні Шуджін?",
   "note": ""
  },
  {
   "id": "MSG_029_0_0#0",
   "speaker": "Ryuji",
   "en": "Huh...!?",
   "uk": "Га...!?",
   "note": ""
  },
  {
   "id": "MSG_031_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "We're all dying to know what[n]Akechi-kun was going to say about[n]their true identities.",
   "uk": "Нам усім страшенно цікаво, що Акечі[n]збирався сказати про їхні справжні[n]особи.",
   "note": ""
  },
  {
   "id": "MSG_031_0_0#1",
   "speaker": "Post-Festival MC",
   "en": "So, are they from Shujin? What do you[n]think, Sakamoto-kun?",
   "uk": "То вони з Шуджін? Як ти вважаєш,[n]Сакамото?",
   "note": ""
  },
  {
   "id": "MSG_032_0_0#0",
   "speaker": "Ryuji",
   "en": "U-Um, well...",
   "uk": "Е-е, ну...",
   "note": ""
  },
  {
   "id": "MND_033_0_0#0",
   "speaker": null,
   "en": "Ryuji's in trouble...",
   "uk": "Рюджі в халепі...",
   "note": ""
  },
  {
   "id": "MND_033_0_0#1",
   "speaker": null,
   "en": "He might accidentally[n]spill the beans about[n]the Phantom Thieves...",
   "uk": "Він може випадково[n]проговоритися про[n]Фантомних Злодіїв...",
   "note": ""
  },
  {
   "id": "MND_033_0_0#2",
   "speaker": null,
   "en": "I need to change[n]the subject...",
   "uk": "Треба змінити[n]тему...",
   "note": ""
  },
  {
   "id": "MSG_034_0_0#0",
   "speaker": "Ryuji",
   "en": "S-So uh, y-y'know...",
   "uk": "Т-тож, е-е, з-знаєте...",
   "note": ""
  },
  {
   "id": "SEL_035_0_0#0",
   "speaker": null,
   "en": "You have a girlfriend!?",
   "uk": "У тебе є дівчина!?",
   "note": ""
  },
  {
   "id": "SEL_035_0_0#1",
   "speaker": null,
   "en": "Stop stuttering!",
   "uk": "Годі заїкатися!",
   "note": ""
  },
  {
   "id": "SEL_035_0_0#2",
   "speaker": null,
   "en": "Blond hair is dumb!",
   "uk": "Біле волосся — це тупо!",
   "note": ""
  },
  {
   "id": "MSG_036_0_0#0",
   "speaker": "Ryuji",
   "en": "...Wha!?",
   "uk": "...Що!?",
   "note": ""
  },
  {
   "id": "MSG_037_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "Urk! Who would be interested in that!?",
   "uk": "Ох! Та кому таке цікаво!?",
   "note": ""
  },
  {
   "id": "MSG_038_0_0#0",
   "speaker": "Ryuji",
   "en": "O-Okay...",
   "uk": "Г-гаразд...",
   "note": ""
  },
  {
   "id": "MSG_039_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "Ohooo!",
   "uk": "Ого-го!",
   "note": ""
  },
  {
   "id": "MSG_039_0_0#1",
   "speaker": "Post-Festival MC",
   "en": "Someone's decided to speak[n]on our behalf!",
   "uk": "Хтось вирішив висловитися[n]від усіх нас!",
   "note": ""
  },
  {
   "id": "MSG_040_0_0#0",
   "speaker": "Ryuji",
   "en": "What was that!?",
   "uk": "Що це було!?",
   "note": ""
  },
  {
   "id": "MSG_041_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "Oooh! Sakamoto-kun's very identity[n]is being questioned!",
   "uk": "О-о-о! Під сумнівом сама суть[n]Сакамото!",
   "note": ""
  },
  {
   "id": "MSG_043_0_0#0",
   "speaker": "Ryuji",
   "en": "That dick...",
   "uk": "От гад...",
   "note": ""
  },
  {
   "id": "MSG_044_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "You over there!",
   "uk": "Ти, там!",
   "note": ""
  },
  {
   "id": "MSG_044_0_0#1",
   "speaker": "Post-Festival MC",
   "en": "Would you like to join in!?",
   "uk": "Не хочеш приєднатися!?",
   "note": ""
  },
  {
   "id": "MSG_045_0_0#0",
   "speaker": "Ryuji",
   "en": "Hell yeah he does!",
   "uk": "Ще й як хоче!",
   "note": ""
  },
  {
   "id": "MSG_046_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "Well then, come on up!",
   "uk": "Ну ж бо, виходь!",
   "note": ""
  },
  {
   "id": "MSG_047_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "Now, what would you like to share[n]with us today?",
   "uk": "Отже, чим ти хочеш поділитися[n]з нами сьогодні?",
   "note": ""
  },
  {
   "id": "SEL_048_0_0#0",
   "speaker": null,
   "en": "I have a bombshell!",
   "uk": "У мене сенсація!",
   "note": ""
  },
  {
   "id": "SEL_048_0_0#1",
   "speaker": null,
   "en": "There's someone I like!",
   "uk": "Мені дехто подобається!",
   "note": ""
  },
  {
   "id": "SEL_048_0_0#2",
   "speaker": null,
   "en": "Nothing.",
   "uk": "Нічого.",
   "note": ""
  },
  {
   "id": "MSG_049_0_0#0",
   "speaker": "Ryuji",
   "en": "The hell...!?",
   "uk": "Якого...!?",
   "note": ""
  },
  {
   "id": "MSG_050_0_0#0",
   "speaker": "Ryuji",
   "en": "Hey, what're you[n]gonna say!?",
   "uk": "Агов, що ти[n]збираєшся сказати!?",
   "note": ""
  },
  {
   "id": "SEL_051_0_0#0",
   "speaker": null,
   "en": "I love Ann.[clr 27]",
   "uk": "Я кохаю Анн.[clr 27]",
   "note": ""
  },
  {
   "id": "SEL_051_0_0#1",
   "speaker": null,
   "en": "I love Makoto.[clr 27]",
   "uk": "Я кохаю Макото.[clr 27]",
   "note": ""
  },
  {
   "id": "SEL_051_0_0#2",
   "speaker": null,
   "en": "I love Futaba.[clr 27]",
   "uk": "Я кохаю Футабу.[clr 27]",
   "note": ""
  },
  {
   "id": "SEL_051_0_0#3",
   "speaker": null,
   "en": "I love Haru.[clr 27]",
   "uk": "Я кохаю Хару.[clr 27]",
   "note": ""
  },
  {
   "id": "SEL_051_0_0#4",
   "speaker": null,
   "en": "I love Ryuji.[clr 27]",
   "uk": "Я кохаю Рюджі.[clr 27]",
   "note": ""
  },
  {
   "id": "SEL_051_0_0#5",
   "speaker": null,
   "en": "I love Yusuke.[clr 27]",
   "uk": "Я кохаю Юсуке.[clr 27]",
   "note": ""
  },
  {
   "id": "SEL_051_0_0#6",
   "speaker": null,
   "en": "I love Morgana.[clr 27]",
   "uk": "Я кохаю Морґану.[clr 27]",
   "note": ""
  },
  {
   "id": "MSG_052_0_0#0",
   "speaker": "Ryuji",
   "en": "Don't, you dumbass!",
   "uk": "Не смій, бовдуре!",
   "note": ""
  },
  {
   "id": "MSG_052_0_0#1",
   "speaker": "Ryuji",
   "en": "Things are gonna fall[n]apart if you do that!",
   "uk": "Якщо ти це скажеш,[n]усе розвалиться!",
   "note": ""
  },
  {
   "id": "MSG_052_0_0#2",
   "speaker": "Ryuji",
   "en": "C'mon, just quit it.[n]Please!",
   "uk": "Ну ж бо, припини.[n]Будь ласка!",
   "note": ""
  },
  {
   "id": "MSG_053_0_0#0",
   "speaker": "Ryuji",
   "en": "Are you stupid!?",
   "uk": "Ти дурний!?",
   "note": ""
  },
  {
   "id": "MSG_053_0_0#1",
   "speaker": "Ryuji",
   "en": "I won't be able to[n]show my face at school[n]if you do that!",
   "uk": "Після такого я не зможу[n]показатися в школі!",
   "note": ""
  },
  {
   "id": "MSG_053_0_0#2",
   "speaker": "Ryuji",
   "en": "And it's not even[n]a funny joke!",
   "uk": "І це навіть не[n]смішний жарт!",
   "note": ""
  },
  {
   "id": "MSG_053_0_0#3",
   "speaker": "Ryuji",
   "en": "C'mon, just quit it.[n]Please!",
   "uk": "Ну ж бо, припини.[n]Будь ласка!",
   "note": ""
  },
  {
   "id": "MSG_054_0_0#0",
   "speaker": "Ryuji",
   "en": "Oh, in that case.",
   "uk": "А, ну тоді гаразд.",
   "note": ""
  },
  {
   "id": "MSG_054_0_0#1",
   "speaker": "Ryuji",
   "en": "Wait, that's still not okay!",
   "uk": "Стоп, це все одно не діло!",
   "note": ""
  },
  {
   "id": "MSG_054_0_0#2",
   "speaker": "Ryuji",
   "en": "Nobody knows them![n]It's just gonna be[n]awkward, dude!",
   "uk": "Його ж ніхто не знає![n]Буде просто[n]незручно, чувак!",
   "note": ""
  },
  {
   "id": "MSG_054_0_0#3",
   "speaker": "Ryuji",
   "en": "C'mon, just quit it.[n]Please!",
   "uk": "Ну ж бо, припини.[n]Будь ласка!",
   "note": ""
  },
  {
   "id": "MSG_055_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "Um... Excuse me...",
   "uk": "Е-е... Перепрошую...",
   "note": ""
  },
  {
   "id": "MSG_055_0_0#1",
   "speaker": "Post-Festival MC",
   "en": "Do you have... anything?",
   "uk": "У тебе є... хоч щось?",
   "note": ""
  },
  {
   "id": "MSG_056_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "Really?",
   "uk": "Справді?",
   "note": ""
  },
  {
   "id": "MSG_057_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "Well uh, I guess that's the end[n]of that! Let's move on to the[n]next person, shall we?",
   "uk": "Що ж, е-е, мабуть, на цьому все![n]Переходимо до наступного,[n]гаразд?",
   "note": ""
  },
  {
   "id": "MSG_057_0_0#1",
   "speaker": "Post-Festival MC",
   "en": "Let's give him a nice round of applause!",
   "uk": "Гучні оплески для нього!",
   "note": ""
  }
 ]
