  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Ann",
   "en": "It's been a while since we've had some[n]alone time together.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_010_0_0#0",
   "speaker": null,
   "en": "Yeah, huh.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_010_0_0#1",
   "speaker": null,
   "en": "I'm kinda nervous.[clr 27]",
