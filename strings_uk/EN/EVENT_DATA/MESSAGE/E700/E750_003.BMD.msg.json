 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Sojiro",
   "en": "Oh right, today's Valentine's Day.[n]No wonder there were so many guys[n]bringing girls in here.",
   "uk": "",
   "note": ""
  },
  {
