{
 "file": "EN/EVENT_DATA/MESSAGE/E700/E747_002.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Kawakami",
   "en": "Ahhh... It's nice to finally have some[n]\"me\" time. I've been so busy lately... ",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_000_5_0#0",
   "speaker": null,
   "en": "It seems like Kawakami has been[n]waiting for me here...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Kawakami",
   "en": "...Hey.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#1",
   "speaker": "Kawakami",
   "en": "What are you looking at?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#0",
   "speaker": null,
   "en": "Your swimsuit.[clr 27]",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#1",
   "speaker": null,
   "en": "The Waikiki beach.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#2",
   "speaker": null,
   "en": "I can't really say.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Kawakami",
   "en": "I appreciate your honesty.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Kawakami",
   "en": "Shouldn't you be looking at me?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Kawakami",
   "en": "Okay, then I won't ask.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Kawakami",
   "en": "So, um...",
   "uk": "Отже, е-е...",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#1",
   "speaker": "Kawakami",
   "en": "Let's take a walk.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Kawakami",
   "en": "...Oooh!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_5_0#0",
   "speaker": "Kawakami",
   "en": "Look! Garlic shrimp!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Kawakami",
   "en": "Tasting the local delicacies is an absolute[n]must on vacation, don't you think?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_009_0_0#0",
   "speaker": null,
   "en": "It's the true pleasure of traveling.[clr 27]",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_009_0_0#1",
   "speaker": null,
   "en": "Let's eat together.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_009_0_0#2",
   "speaker": null,
   "en": "Treat me.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Kawakami",
   "en": "Right?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Kawakami",
   "en": "Yay!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Kawakami",
   "en": "Fiiine...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Kawakami",
   "en": "Hey, mister! Two orders of [n]garlic shrimp, please!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Kawakami",
   "en": "...Oh my god! I think I'm craving a beer!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#1",
   "speaker": "Kawakami",
   "en": "Why does drinking on the beach[n]have to be prohibited in Hawaii?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_014_5_0#0",
   "speaker": null,
   "en": "We gazed out over the ocean[n]while we enjoyed the delicate[n]flavors of a foreign country...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Shrimp Stand Owner",
   "en": "You two from Japan?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Kawakami",
   "en": "Yes, we are.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Shrimp Stand Owner",
   "en": "How 'bout them Phantom Thieves, huh?[n]The guys that steal hearts!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Kawakami",
   "en": "Wow, you're very well-informed.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Shrimp Stand Owner",
   "en": "Heard about it on the news![n]They're all the rage in Japan, yeah?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Kawakami",
   "en": "You're quite the celebrity.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Shrimp Stand Owner",
   "en": "Say, if y'run into 'em, tell 'em I say hello.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#1",
   "speaker": "Shrimp Stand Owner",
   "en": "And ask 'em to change people's hearts[n]so everyone loves shrimp!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Kawakami",
   "en": "Okay, I'll let them know.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Shrimp Stand Owner",
   "en": "By the way, you two honeymoonin' here?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Kawakami",
   "en": "Oh my!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Kawakami",
   "en": "C'mon, let's go.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_025_5_0#0",
   "speaker": null,
   "en": "We spent time on the beach until the[n]sun began to sink below the horizon...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Kawakami",
   "en": "It's been years since I've seen something[n]so beautiful...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_027_0_0#0",
   "speaker": "Kawakami",
   "en": "I was having so much fun...[n]I hope no one saw us.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_027_0_0#1",
   "speaker": "Kawakami",
   "en": "Although, I wouldn't back down[n]if someone actually confronted[n]us about it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Kawakami",
   "en": "To tell you the truth, I'm worried[n]that you're lonely... because of the[n]position I'm in...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#1",
   "speaker": "Kawakami",
   "en": "If that's true, then... I'm sorry.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_029_0_0#0",
   "speaker": null,
   "en": "There's nothing we can do about it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_029_0_0#1",
   "speaker": null,
   "en": "I'll endure it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_029_0_0#2",
   "speaker": null,
   "en": "I want to see you more.[clr 27]",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_030_0_0#0",
   "speaker": "Kawakami",
   "en": "...Thanks.",
   "uk": "...Дякую.",
   "note": ""
  },
  {
   "id": "MSG_031_0_0#0",
   "speaker": "Kawakami",
   "en": "...Oh yeah?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_032_0_0#0",
   "speaker": "Kawakami",
   "en": "...So do I.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_033_0_0#0",
   "speaker": "Kawakami",
   "en": "...Anyway, this is my first time here.[n]Hawaii's really nice, isn't it?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_033_0_0#1",
   "speaker": "Kawakami",
   "en": "Let's come back sometime,[n]just the two of us.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_034_0_0#0",
   "speaker": "Kawakami",
   "en": "...Here, take this.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_034_1_0#0",
   "speaker": null,
   "en": "It's a ring engraved with our initials...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_034_1_0#1",
   "speaker": null,
   "en": "Something about the faint gleam[n]reminds me of Kawakami...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_034_3_0#0",
   "speaker": "Kawakami",
   "en": "Tadahhh! That's the power of a paycheck!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_034_3_0#1",
   "speaker": "Kawakami",
   "en": "...Just kidding.[n]It's to commemorate today.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_034_5_0#0",
   "speaker": null,
   "en": "Thanks.",
   "uk": "Дякую.",
   "note": ""
  },
  {
   "id": "SEL_034_5_0#1",
   "speaker": null,
   "en": "Are these matching?[clr 27]",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_034_7_0#0",
   "speaker": "Kawakami",
   "en": "You're welcome.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_034_9_0#0",
   "speaker": "Kawakami",
   "en": "...Was that not a good idea?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_035_0_0#0",
   "speaker": "Kawakami",
   "en": "It's gonna get dark soon...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_035_0_0#1",
   "speaker": "Kawakami",
   "en": "We should head back.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_036_0_0#0",
   "speaker": null,
   "en": "I don't want you to go.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_036_0_0#1",
   "speaker": null,
   "en": "Just a bit longer.",
   "uk": "Ще зовсім трішки.",
   "note": ""
  },
  {
   "id": "MSG_037_0_0#0",
   "speaker": "Kawakami",
   "en": "If you say so, Master.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_038_0_0#0",
   "speaker": null,
   "en": "The two of us basked in the[n]stunning Hawaiian sunset.[n]Just me and Kawakami...",
   "uk": "",
   "note": ""
  }
 ]
}