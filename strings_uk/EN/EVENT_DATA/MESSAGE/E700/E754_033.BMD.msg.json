{
 "file": "EN/EVENT_DATA/MESSAGE/E700/E754_033.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Futaba",
   "en": "Urgh...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_000_0_0#1",
   "speaker": "Futaba",
   "en": "This place is like five times fancier[n]than I was expecting...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_000_0_0#2",
   "speaker": "Futaba",
   "en": "A-Are we gonna be okay? What if I[n]use the wrong fork? Are they gonna[n]kick me out?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#0",
   "speaker": null,
   "en": "We'll be fine.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#1",
   "speaker": null,
   "en": "Is the anxiety too much?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Futaba",
   "en": "O-Okay...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#1",
   "speaker": "Futaba",
   "en": "You're right. You're here with me, so...[n]I can try and calm down.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Futaba",
   "en": "Um, it's kicking in pretty bad...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#1",
   "speaker": "Futaba",
   "en": "But it doesn't control me! You went to[n]all this trouble, and you even made[n]reservations, so I can beat this!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#2",
   "speaker": "Futaba",
   "en": "I'm not gonna let it ruin me having[n]a good time.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Futaba",
   "en": "Ugh. I'm over here freaking out.[n]Meanwhile you look mature[n]enough to own the place.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#1",
   "speaker": "Futaba",
   "en": "Even when we just walked in, you were[n]really calm. Even cooler than usual.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_005_0_0#0",
   "speaker": null,
   "en": "You're making me blush.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_005_0_0#1",
   "speaker": null,
   "en": "Thanks.",
   "uk": "Дякую.",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Futaba",
   "en": "You can't blush, or I'll blush...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#1",
   "speaker": "Futaba",
   "en": "Oh geez, I'll be back in a sec.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_007_0_0#0",
   "speaker": null,
   "en": "When should I give her the gift?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_008_0_0#0",
   "speaker": null,
   "en": "○○○ is calling me...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_009_0_0#0",
   "speaker": null,
   "en": "I can't answer this now...!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Futaba",
   "en": "Your phone was ringing, right?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#0",
   "speaker": null,
   "en": "It's not a big deal.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#1",
   "speaker": null,
   "en": "Don't worry about it.",
   "uk": "Не зважайте.",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Futaba",
   "en": "Uh-huh.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Futaba",
   "en": "Sorry about that!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Announcer",
   "en": "Ladies and gentlemen, thank you for[n]joining us on this special day.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#1",
   "speaker": "Announcer",
   "en": "We wish you all an unforgettable[n]evening, with one last finishing touch[n]from us...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Futaba",
   "en": "What?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Futaba",
   "en": "Whoooaaa...",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_018_0_0#0",
   "speaker": null,
   "en": "This is for you.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_018_0_0#1",
   "speaker": null,
   "en": "I want you to have this.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Futaba",
   "en": "Huh...?",
   "uk": "Га...?",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#1",
   "speaker": "Futaba",
   "en": "Th-Thank you...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Futaba",
   "en": "Wow. Wow, okay. Everything's cool,[n]I'm just... kind of in shock...",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_021_0_0#0",
   "speaker": null,
   "en": "Calm down.",
   "uk": "Заспокойся.",
   "note": ""
  },
  {
   "id": "SEL_021_0_0#1",
   "speaker": null,
   "en": "How do you feel?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_021_0_0#2",
   "speaker": null,
   "en": "Surprise.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Futaba",
   "en": "Okay, I'll try...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#1",
   "speaker": "Futaba",
   "en": "...Yeah, it's hitting me now. I feel so...[n]happy.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Futaba",
   "en": "I dunno how to deal with it, but...[n]I'm really happy.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Futaba",
   "en": "I can't handle surprises!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#1",
   "speaker": "Futaba",
   "en": "...But this one made me happy.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Futaba",
   "en": "You're so incredible...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#1",
   "speaker": "Futaba",
   "en": "Like, it blows my mind that you're so...[n]selfless. You only go all out when it[n]comes to helping other people.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#2",
   "speaker": "Futaba",
   "en": "Even this. You put all this together for[n]me, right?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Futaba",
   "en": "Maybe one day I can be like that.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_027_0_0#0",
   "speaker": null,
   "en": "I'm sure you can do it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_027_0_0#1",
   "speaker": null,
   "en": "I'm looking forward to it.",
   "uk": "Чекаю з нетерпінням.",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Futaba",
   "en": "Hee hee... Yeah.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_029_0_0#0",
   "speaker": "Futaba",
   "en": "You're not a phantom thief anymore,[n]but I guess you've still got a knack for[n]stealing hearts.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_030_0_0#0",
   "speaker": null,
   "en": "Stealing?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_030_0_0#1",
   "speaker": null,
   "en": "What?",
   "uk": "Що?",
   "note": ""
  },
  {
   "id": "MSG_031_0_0#0",
   "speaker": "Futaba",
   "en": "Cause, um... you stole mine.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_032_0_0#0",
   "speaker": "Futaba",
   "en": "God, that was the cheesiest—[n]Forget I said anything!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_032_0_0#1",
   "speaker": "Futaba",
   "en": "...Hey, can we hang out a little longer?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_032_0_0#2",
   "speaker": "Futaba",
   "en": "I don't want to go home yet.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_033_0_0#0",
   "speaker": null,
   "en": "Futaba and I spent some[n]time alone together...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_033_0_0#1",
   "speaker": null,
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "MND_033_0_0#2",
   "speaker": null,
   "en": "Once it got late, I walked her[n]back to her house...",
   "uk": "",
   "note": ""
  }
 ]
}