{
 "file": "EN/EVENT_DATA/MESSAGE/E700/E754_023.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Ann",
   "en": "This place is crazy...",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#0",
   "speaker": null,
   "en": "Do you like it?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#1",
   "speaker": null,
   "en": "This is my first time here.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Ann",
   "en": "I'm so nervous right now, I can't even[n]tell...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#1",
   "speaker": "Ann",
   "en": "But I know I'm happy to be here.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Ann",
   "en": "Oh really? And here I was thinking you[n]were a regular.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#1",
   "speaker": "Ann",
   "en": "...Somehow I doubt that.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Ann",
   "en": "But this is way more intense than I was[n]expecting.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#1",
   "speaker": "Ann",
   "en": "You really thought this through, huh?[n]I love a guy who can think ahead!",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_005_0_0#0",
   "speaker": null,
   "en": "You're making me blush.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_005_0_0#1",
   "speaker": null,
   "en": "Thanks.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Ann",
   "en": "Yeah.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#1",
   "speaker": "Ann",
   "en": "Oh, sorry, give me a sec.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_007_0_0#0",
   "speaker": null,
   "en": "When should I give her the gift?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_008_0_0#0",
   "speaker": null,
   "en": "○○○ is calling me...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_009_0_0#0",
   "speaker": null,
   "en": "I can't answer this now...!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Ann",
   "en": "Someone calling?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#0",
   "speaker": null,
   "en": "It's not a big deal.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#1",
   "speaker": null,
   "en": "Don't worry about it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Ann",
   "en": "...Sure.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Ann",
   "en": "Okay, all set!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Announcer",
   "en": "Ladies and gentlemen, thank you for[n]joining us on this special day.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#1",
   "speaker": "Announcer",
   "en": "We wish you all an unforgettable[n]evening, with one last finishing[n]touch from us...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Ann",
   "en": "What? Hold on...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Ann",
   "en": "It's so beautiful...",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_018_0_0#0",
   "speaker": null,
   "en": "This is for you.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_018_0_0#1",
   "speaker": null,
   "en": "I want you to have this.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Ann",
   "en": "This is... for me?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#1",
   "speaker": "Ann",
   "en": "Thank you...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Ann",
   "en": "...Wow. The perfect gift, with the[n]perfect timing.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#1",
   "speaker": "Ann",
   "en": "It feels like I'm in a movie...",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_021_0_0#0",
   "speaker": null,
   "en": "How do you feel?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_021_0_0#1",
   "speaker": null,
   "en": "You prefer edible gifts?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_021_0_0#2",
   "speaker": null,
   "en": "Surprise.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Ann",
   "en": "Insanely happy! Duh!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Ann",
   "en": "Oh, totally. This date would have been[n]perfect, but you didn't bring me a cake.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#1",
   "speaker": "Ann",
   "en": "Seriously, though, I'm genuinely,[n]insanely happy... Thank you.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Ann",
   "en": "...Oh, you're good.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Ann",
   "en": "I can't believe you went to all this[n]trouble. But when I think about it,[n]it's such a 'you' thing to do.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#1",
   "speaker": "Ann",
   "en": "From the day I met you...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#2",
   "speaker": "Ann",
   "en": "You've always been so focused on what[n]you can do for everyone around you.[n]Always putting other people first.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Ann",
   "en": "I really admire that about you. Maybe[n]one day, I can be like that myself.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_027_0_0#0",
   "speaker": null,
   "en": "I'm sure you can do it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_027_0_0#1",
   "speaker": null,
   "en": "I'm looking forward to it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Ann",
   "en": "...Thanks.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#1",
   "speaker": "Ann",
   "en": "I'm gonna put in the work. And one[n]day, you're gonna think to yourself,[n]\"Man, I'm so glad Ann's in my life!\"",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_029_0_0#0",
   "speaker": null,
   "en": "I already think that way.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_029_0_0#1",
   "speaker": null,
   "en": "I'm thinking that now.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_030_0_0#0",
   "speaker": "Ann",
   "en": "Then you're gonna think it harder.[n]I'll make sure.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_030_0_0#1",
   "speaker": "Ann",
   "en": "Whatever happens, I want to stay[n]with you from now on, okay?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_031_0_0#0",
   "speaker": null,
   "en": "Ann and I spent some[n]time alone together...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_031_0_0#1",
   "speaker": null,
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "MND_031_0_0#2",
   "speaker": null,
   "en": "Once it got late, I walked[n]her back to the station...",
   "uk": "",
   "note": ""
  }
 ]
}