{
 "file": "EN/EVENT_DATA/MESSAGE/E700/E751_015.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Haru",
   "en": "Oh, it's exquisite!",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#0",
   "speaker": null,
   "en": "Glad we found one.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_001_0_0#1",
   "speaker": null,
   "en": "We really got lucky.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Haru",
   "en": "Oh yes! I have a surprise for you...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Haru",
   "en": "It's your Christmas present. I hope[n]you like it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_004_0_0#0",
   "speaker": null,
   "en": "Of course.",
   "uk": "Звісно.",
   "note": ""
  },
  {
   "id": "SEL_004_0_0#1",
   "speaker": null,
   "en": "Anything from you is good.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Haru",
   "en": "A fetching hat. I thought it might keep[n]you warm through winter...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#1",
   "speaker": "Haru",
   "en": "Perhaps you could wear it when[n]we go out together.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_006_0_0#0",
   "speaker": null,
   "en": "I'm looking forward to it.",
   "uk": "Чекаю з нетерпінням.",
   "note": ""
  },
  {
   "id": "SEL_006_0_0#1",
   "speaker": null,
   "en": "I'll take good care of it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Haru",
   "en": "Good! We have so many places to[n]visit together, after all. I can't wait[n]to take you on a café crawl...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Haru",
   "en": "...I'm so glad you like it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Haru",
   "en": "Oh...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Haru",
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "MND_011_0_0#0",
   "speaker": null,
   "en": "Haru is staring at me...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Haru",
   "en": "Look... You had some cream on[n]your nose.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Haru",
   "en": "Merry Christmas indeed. You've made[n]this more fun than any I've known[n]before.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#1",
   "speaker": "Haru",
   "en": "Thank you. For being with me.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_015_0_0#0",
   "speaker": null,
   "en": "No need to thank me.",
   "uk": "Не треба мені дякувати.",
   "note": ""
  },
  {
   "id": "SEL_015_0_0#1",
   "speaker": null,
   "en": "It's my pleasure.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Haru",
   "en": "...Good.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Haru",
   "en": "Oh... Look, [fName]-kun!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Haru",
   "en": "It's snowing so much harder now![n]How beautiful...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Haru",
   "en": "Most of my memories of Christmas are[n]quite solitary. That, or being forced[n]to attend some stuffy gala.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#1",
   "speaker": "Haru",
   "en": "This has been rather illuminating...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#2",
   "speaker": "Haru",
   "en": "I never imagined the holidays could[n]feel this wonderful.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Haru",
   "en": "I'm so happy... It's like something out[n]of a dream.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_026_0_0#0",
   "speaker": null,
   "en": "It's not a dream.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_026_0_0#1",
   "speaker": null,
   "en": "You're overthinking it.",
   "uk": "Ви забагато думаєте.",
   "note": ""
  },
  {
   "id": "MSG_027_0_0#0",
   "speaker": "Haru",
   "en": "Yes, you're right. It's just nice that[n]everything's finally stable.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_030_0_0#0",
   "speaker": "Haru",
   "en": "You know, I've already sent word that[n]I'll be home quite late tonight...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_030_0_0#1",
   "speaker": "Haru",
   "en": "So...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_031_0_0#0",
   "speaker": null,
   "en": "Haru and I spent some[n]time alone together...",
   "uk": "",
   "note": ""
  }
 ]
}