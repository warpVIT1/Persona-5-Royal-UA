{
 "file": "EN/EVENT_DATA/MESSAGE/E700/E747_003.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Hifumi",
   "en": "I didn't expect to see you here.[n]...It's quite a nice surprise.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_000_5_0#0",
   "speaker": null,
   "en": "It seems like Hifumi has been waiting[n]for me here...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Hifumi",
   "en": "Um... Do I look strange in this?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#1",
   "speaker": "Hifumi",
   "en": "Perhaps I should go change...",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#0",
   "speaker": null,
   "en": "It is the beach, after all.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#1",
   "speaker": null,
   "en": "You look great![clr 27]",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#2",
   "speaker": null,
   "en": "I can't handle it...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Hifumi",
   "en": "I'm happy to hear that...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Hifumi",
   "en": "Huh...?",
   "uk": "Що?..",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#1",
   "speaker": "Hifumi",
   "en": "...Oh, thank you very much.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Hifumi",
   "en": "Oh... sorry...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Hifumi",
   "en": "Um...",
   "uk": "Ем...",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#1",
   "speaker": "Hifumi",
   "en": "...Shall we take a walk?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Hifumi",
   "en": "Oh...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#1",
   "speaker": "Hifumi",
   "en": "Looks like they sell shrimp...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Hifumi",
   "en": "Shrimp are symbolic of living a long life.[n]Shall we have some?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_009_0_0#0",
   "speaker": null,
   "en": "Yeah, I'd like to try some.[clr 27]",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_009_0_0#1",
   "speaker": null,
   "en": "You think they taste good?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_009_0_0#2",
   "speaker": null,
   "en": "I'd rather have crab.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Hifumi",
   "en": "I wonder how they'll taste...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Hifumi",
   "en": "Only someone who has tasted them[n]would know the answer!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#1",
   "speaker": "Hifumi",
   "en": "So... we should try them ourselves...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Hifumi",
   "en": "Don't be difficult.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Hifumi",
   "en": "Um, two orders of... garlic shrimp, is it?[n]Yes, two orders of garlic shrimp, please...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Hifumi",
   "en": "Oh, they're quite... pungent.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#1",
   "speaker": "Hifumi",
   "en": "I imagine that a man would like[n]a bold flavor such as this.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_014_5_0#0",
   "speaker": null,
   "en": "I ate some delicious garlic shrimp[n]with Hifumi...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Shrimp Stand Owner",
   "en": "You two from Japan?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Hifumi",
   "en": "...Yes.",
   "uk": "...Так.",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Shrimp Stand Owner",
   "en": "How 'bout them Phantom Thieves, huh?[n]The guys that steal hearts!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Hifumi",
   "en": "...You've heard about the[n]Phantom Thieves?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Shrimp Stand Owner",
   "en": "Heard about it on the news![n]They're all the rage in Japan, yeah?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#1",
   "speaker": "Shrimp Stand Owner",
   "en": "Say, if y'run into 'em, tell 'em I say hello.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#2",
   "speaker": "Shrimp Stand Owner",
   "en": "And ask 'em to change people's hearts[n]so everyone loves shrimp!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Hifumi",
   "en": "S-Sure...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_022_0_0#0",
   "speaker": null,
   "en": "The owner gave us a heaping[n]pile of extra shrimp...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Hifumi",
   "en": "Oh, they're quite... pungent.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_023_5_0#0",
   "speaker": null,
   "en": "We gazed out over the ocean[n]while we enjoyed the delicate[n]flavors of a foreign country...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Hifumi",
   "en": "...It's so beautiful.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Hifumi",
   "en": "This is a refreshing break from staring[n]at a shogi board all day long. ",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#1",
   "speaker": "Hifumi",
   "en": "...I feel as if I'll be able to come up with[n]some great new moves once I return home.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Hifumi",
   "en": "Were you bored spending time with me?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#1",
   "speaker": "Hifumi",
   "en": "We would've had a more enjoyable time[n]if I had made better conversation...",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_027_0_0#0",
   "speaker": null,
   "en": "You're fine the way you are.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_027_0_0#1",
   "speaker": null,
   "en": "I had fun.[clr 27]",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_027_0_0#2",
   "speaker": null,
   "en": "Was it boring for you?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Hifumi",
   "en": "You are always so kind.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_029_0_0#0",
   "speaker": "Hifumi",
   "en": "...I'm happy to hear that.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_030_0_0#0",
   "speaker": "Hifumi",
   "en": "What...!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_031_0_0#0",
   "speaker": "Hifumi",
   "en": "...Of course not.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_032_0_0#0",
   "speaker": "Hifumi",
   "en": "Um... this is for you...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_032_0_0#1",
   "speaker": "Hifumi",
   "en": "I would be delighted if you[n]remembered this day...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_032_1_0#0",
   "speaker": null,
   "en": "It looks like a turtle...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MND_032_1_0#1",
   "speaker": null,
   "en": "Something about the transparent[n]stone reminds me of Hifumi...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_032_3_0#0",
   "speaker": "Hifumi",
   "en": "If only we went to the same school...",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_032_5_0#0",
   "speaker": null,
   "en": "Let's play a match soon.[clr 27]",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_032_5_0#1",
   "speaker": null,
   "en": "We'll see each other again.[clr 27]",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_032_7_0#0",
   "speaker": "Hifumi",
   "en": "...Yes.",
   "uk": "...Так.",
   "note": ""
  },
  {
   "id": "MSG_032_7_0#1",
   "speaker": "Hifumi",
   "en": "I'd like that.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_033_0_0#0",
   "speaker": "Hifumi",
   "en": "...Sun is about to set.[n]We should start heading back...",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_035_0_0#0",
   "speaker": null,
   "en": "Just a little longer.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_035_0_0#1",
   "speaker": null,
   "en": "We're fine like this.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_036_0_0#0",
   "speaker": "Hifumi",
   "en": "Yes.",
   "uk": "Так.",
   "note": ""
  },
  {
   "id": "MND_037_0_0#0",
   "speaker": null,
   "en": "The two of us basked in the stunning[n]Hawaiian sunset. Just me and Hifumi...",
   "uk": "",
   "note": ""
  }
 ]
}