{
 "file": "EN/EVENT_DATA/MESSAGE/E700/E748_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Makoto",
   "en": "...I made a fool of myself.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_000_0_0#1",
   "speaker": "Makoto",
   "en": "The post-festival party has never felt[n]that long before...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Makoto",
   "en": "By the way, I'm surprised you were able[n]to say what you did back there.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#0",
   "speaker": null,
   "en": "You were in trouble.[clr 27]",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_002_0_0#1",
   "speaker": null,
   "en": "I couldn't ignore you.[clr 27]",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Makoto",
   "en": "Huh...?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Makoto",
   "en": "I was at a complete loss for words.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#1",
   "speaker": "Makoto",
   "en": "You really helped me... Thank you.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Makoto",
   "en": "This may be a little rude to say, but[n]you're surprisingly reliable in a pinch.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#1",
   "speaker": "Makoto",
   "en": "My sister always says if I get married,[n]my husband should be someone[n]dependable like that.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Makoto",
   "en": "Oh, um... uh... forget what I just said!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#1",
   "speaker": "Makoto",
   "en": "......",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_007_5_0#0",
   "speaker": null,
   "en": "Husband?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_007_5_0#1",
   "speaker": null,
   "en": "Can you say that again?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Makoto",
   "en": "...Urgh!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Makoto",
   "en": "Oh, um...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#1",
   "speaker": "Makoto",
   "en": "...Urgh!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Makoto",
   "en": "Despite everything that happened[n]with Akechi-kun...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Makoto",
   "en": "My final post-festival party has turned[n]out to be quite the unforgettable one.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Makoto",
   "en": "Oh right... Here...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Makoto",
   "en": "If you'd accept this...",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_014_0_0#0",
   "speaker": null,
   "en": "It looks delicious.[clr 27]",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_014_0_0#1",
   "speaker": null,
   "en": "I can't wait to eat it.[clr 27]",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Makoto",
   "en": "I hope you enjoy it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Makoto",
   "en": "Come, let's go home.",
   "uk": "",
   "note": ""
  }
 ]
}