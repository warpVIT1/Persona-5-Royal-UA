  {
   "id": "MSG_048_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "Sooo, Okumura-san! What's your[n]relation to this guy?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_049_0_0#0",
   "speaker": "Haru",
   "en": "Th-That wasn't what we were[n]talking about...",
