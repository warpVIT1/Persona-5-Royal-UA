  },
  {
   "id": "MSG_045_0_0#0",
   "speaker": "Post-Festival MC",
   "en": "Now this is drama! A boy caught[n]in the throes of bittersweet youth![n]A stunning confession of love!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_046_5_0#0",
   "speaker": "Post-Festival MC",
   "en": "I think it was him!",
   "uk": "",
   "note": ""
