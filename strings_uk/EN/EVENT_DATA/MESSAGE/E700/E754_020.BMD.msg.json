  {
   "id": "MSG_012_0_0#1",
   "speaker": "Ann",
   "en": "Well. I guess this works as an apology.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#2",
   "speaker": "Ann",
   "en": "...Thank you.",
   "uk": "",
   "note": ""
  },
  {
