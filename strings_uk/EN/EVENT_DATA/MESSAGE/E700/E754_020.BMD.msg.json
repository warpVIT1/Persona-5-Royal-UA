  {
   "id": "MND_000_0_0#0",
   "speaker": null,
   "en": "I met up with Ann at the aquarium...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Ann",
   "en": "So pretty...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#1",
   "speaker": "Ann",
   "en": "No wonder they were doing all those[n]TV specials on this place.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Ann",
   "en": "Oh, check it out! Is that a tuna? And I[n]think that one's a yellowtail! Or maybe[n]a sardine?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Ann",
   "en": "Man, I must sound like I'm ordering[n]sushi, huh?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#1",
   "speaker": "Ann",
   "en": "......",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#2",
   "speaker": "Ann",
   "en": "Sorry, um... I guess I'm a little nervous.[n]I've never been on a date to an[n]aquarium before.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Ann",
   "en": "...Hey, can I ask you something?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#1",
   "speaker": "Ann",
   "en": "I was kinda joking on the phone, but...[n]is all this really in return for Valentine's[n]Day?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_005_0_0#0",
   "speaker": null,
   "en": "Of course.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_005_0_0#1",
   "speaker": null,
   "en": "That's correct.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Ann",
   "en": "Hee hee... Thanks.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#1",
   "speaker": "Ann",
   "en": "I'm having a great time.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Ann",
   "en": "...Hey, can I ask you something?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#1",
   "speaker": "Ann",
   "en": "Is this supposed to be a date for[n]White Day?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_008_0_0#0",
   "speaker": null,
   "en": "Of course.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_008_0_0#1",
   "speaker": null,
   "en": "That's correct.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Ann",
   "en": "Oh, okay! Hee hee, that's a relief.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#1",
   "speaker": "Ann",
   "en": "After we missed each other on[n]Valentine's Day, I kind of figured[n]I'd get stood up again.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Ann",
   "en": "...Hey, can I ask you something?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#1",
   "speaker": "Ann",
   "en": "Is this supposed to be a date for[n]White Day?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#0",
   "speaker": null,
   "en": "Of course.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#1",
   "speaker": null,
   "en": "Yes.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Ann",
   "en": "I see how it is.",
   "uk": "",
   "note": ""
