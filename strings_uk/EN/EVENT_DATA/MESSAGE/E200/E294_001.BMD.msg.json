{
 "file": "EN/EVENT_DATA/MESSAGE/E200/E294_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Ryuji",
   "en": "Hey, is this...?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Morgana",
   "en": "That's Futaba's Shadow. It isn't[n]the real her.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Ryuji",
   "en": "Oh yeah, you've seen her face. True.[n]This one's kinda dressed like a queen.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Makoto",
   "en": "So you're Futaba Sakura...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "......",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Ryuji",
   "en": "Hey, where's the Treasure?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Makoto",
   "en": "It's doubtful that you wouldn't know[n]where it is.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Ryuji",
   "en": "Hey, say somethin'.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Ann",
   "en": "Don't be like that!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_5_0#0",
   "speaker": "Ann",
   "en": "I'm sorry, Futaba-chan. It's okay, there's[n]no need to be scared.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_5_0#1",
   "speaker": "Ann",
   "en": "So, can you tell us where your most[n]treasured possession is?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Yusuke",
   "en": "This is going nowhere.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Ryuji",
   "en": "Let's just leave her.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Ann",
   "en": "Will you guys shut up for a bit!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "Those who plunder my tomb. Why have[n]you come?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Ann",
   "en": "She talked... but...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Ryuji",
   "en": "What're you sayin'? You want us to[n]steal it, right?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "If you believe you can steal it, then try[n]as you might.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Morgana",
   "en": "That's rather defiant-sounding.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Yusuke",
   "en": "Perhaps this is that \"tsundere\" thing[n]where someone is harsh or sweet[n]depending on the mood.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "Considering the state that my Palace[n]is in...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#1",
   "speaker": "Shadow Futaba",
   "en": "...There is no way that you can steal it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Yusuke",
   "en": "What are these voices?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Makoto",
   "en": "Murderer?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Ann",
   "en": "This is horrible...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_029_0_0#0",
   "speaker": "Ryuji",
   "en": "Hey, the hell is this?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_034_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "...That's right. I did it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_035_0_0#0",
   "speaker": "Ryuji",
   "en": "What?",
   "uk": "Що?",
   "note": ""
  },
  {
   "id": "MSG_036_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "I am the one who killed my mother.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_037_0_0#0",
   "speaker": "Ann",
   "en": "What was that!?",
   "uk": "Що це було!?",
   "note": ""
  },
  {
   "id": "MSG_038_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "My mother exists here.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_038_0_0#1",
   "speaker": "Shadow Futaba",
   "en": "I will remain here. I will do so until I die.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_039_0_0#0",
   "speaker": "Makoto",
   "en": "Our clothes...!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_040_0_0#0",
   "speaker": "Yusuke",
   "en": "She sees us as a threat now... What's[n]going on!?",
   "uk": "",
   "note": ""
  }
 ]
}