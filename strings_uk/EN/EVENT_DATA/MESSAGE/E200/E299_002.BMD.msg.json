{
 "file": "EN/EVENT_DATA/MESSAGE/E200/E299_002.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Sphinx",
   "en": "Fuuuuutaaaaaabaaaaaa!",
   "uk": "Фу-у-у-ута-а-а-ба-а-а!",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Makoto",
   "en": "Is it a Shadow?",
   "uk": "Це Тінь?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Makoto",
   "en": "No... Then—",
   "uk": "Ні... Тоді—",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Yusuke",
   "en": "It's not Futaba!",
   "uk": "Це не Футаба!",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Morgana",
   "en": "Don't tell me...",
   "uk": "Тільки не кажи...",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Ann",
   "en": "This is insane!",
   "uk": "Це божевілля!",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Ryuji",
   "en": "If it's not a Shadow, then what is it!?",
   "uk": "Якщо це не Тінь, то що!?",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Morgana",
   "en": "It's a... cognition!",
   "uk": "Це... когніція!",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Morgana",
   "en": "A monster that Futaba's cognition created!",
   "uk": "Чудовисько, створене когніцією Футаби!",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Makoto",
   "en": "How can that be!?",
   "uk": "Як таке можливо!?",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Ryuji",
   "en": "Hey, look out!",
   "uk": "Гей, обережно!",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Ryuji",
   "en": "Here it comes!",
   "uk": "Ось воно!",
   "note": ""
  }
 ]
