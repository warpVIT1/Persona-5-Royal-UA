{
 "file": "EN/EVENT_DATA/MESSAGE/E200/E298_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Futaba",
   "en": "If I use this... I can change my heart?",
   "uk": "Якщо я цим скористаюся...[n]я зможу змінити своє серце?",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Futaba",
   "en": "Vocal input...?",
   "uk": "Голосове введення...?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Futaba",
   "en": "Fu—",
   "uk": "Фу—",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#1",
   "speaker": "Futaba",
   "en": "Fu— Futaba Sakura.",
   "uk": "Фу— Футаба Сакура.",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Futaba",
   "en": "...Sojiro Sakura's house.",
   "uk": "...Дім Соджіро Сакури.",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Futaba",
   "en": "And then...",
   "uk": "А тоді...",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#1",
   "speaker": "Futaba",
   "en": "Something about \"distortion\"...",
   "uk": "Щось про «викривлення»...",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Futaba",
   "en": "Distortion... Distortion...",
   "uk": "Викривлення... Викривлення...",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Futaba",
   "en": "Hm?",
   "uk": "Гм?",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Futaba",
   "en": "Not again...",
   "uk": "Знову...",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Futaba",
   "en": "No!",
   "uk": "Ні!",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Futaba",
   "en": "That's right... I remember now.",
   "uk": "Точно... Тепер я згадала.",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#1",
   "speaker": "Futaba",
   "en": "Back when they were here, I—",
   "uk": "Коли вони тут були, я—",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#2",
   "speaker": "Futaba",
   "en": "...I messaged \"tomb\" in the chat, and...",
   "uk": "...Я написала «гробниця» в чаті, і...",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Navigation Voice",
   "en": "Input accepted. Searching for route[n]to destination.",
   "uk": "Запит прийнято. Пошук маршруту[n]до місця призначення.",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Futaba",
   "en": "...I can go in now?",
   "uk": "...Тепер я можу увійти?",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Futaba",
   "en": "No...",
   "uk": "Ні...",
   "note": ""
  },
  {
   "id": "MSG_027_0_0#0",
   "speaker": "Futaba",
   "en": "I can't take this anymore!",
   "uk": "Я більше не витримую!",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Navigation Voice",
   "en": "Beginning navigation.",
   "uk": "Початок навігації.",
   "note": ""
  }
 ]
}