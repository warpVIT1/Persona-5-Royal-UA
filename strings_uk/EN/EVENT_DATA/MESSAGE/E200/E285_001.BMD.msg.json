{
 "file": "EN/EVENT_DATA/MESSAGE/E200/E285_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Makoto",
   "en": "Hello, sir?",
   "uk": "Добрий вечір, пане?",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Makoto",
   "en": "He's not out, is he?",
   "uk": "Він же не пішов кудись, правда?",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#1",
   "speaker": "Makoto",
   "en": "The door ahead is open, and I can hear[n]the TV.",
   "uk": "Двері попереду відчинені, і чути[n]телевізор.",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Ryuji",
   "en": "I hope he didn't pass out or something...[n]I mean, Boss is kinda old, ain't he?",
   "uk": "Сподіваюся, він не знепритомнів чи[n]щось таке... Шеф же вже немолодий, так?",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Ann",
   "en": "I'm a bit worried. Should we go in and[n]check on him?",
   "uk": "Я трохи хвилююся. Може, зайдемо[n]й перевіримо, як він?",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Makoto",
   "en": "Please excuse us...",
   "uk": "Перепрошуємо...",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Makoto",
   "en": "A scream!? What was that!?",
   "uk": "Крик!? Що це було!?",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Morgana",
   "en": "H-How should I know?",
   "uk": "З-звідки мені знати?",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Makoto",
   "en": "Did you hear that!?",
   "uk": "Ви це чули!?",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Ann",
   "en": "Let's get out of here, please?[n]Can we just go?",
   "uk": "Ходімо звідси, будь ласка?[n]Можна ми просто підемо?",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Ryuji",
   "en": "What're you freakin' out for?",
   "uk": "Чого ти так панікуєш?",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Ann",
   "en": "I-I-I'm not freaking out!",
   "uk": "Я-я-я не панікую!",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Morgana",
   "en": "Could it be Alibaba? I mean, Futaba?",
   "uk": "Може, це Алібаба? Тобто Футаба?",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Makoto",
   "en": "Um, sorry... Can I hold your hand?",
   "uk": "Е-е, вибач... Можна тебе за руку?",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Makoto",
   "en": "Eek!",
   "uk": "Ай!",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Yusuke",
   "en": "I can sense someone's presence...",
   "uk": "Я відчуваю чиюсь присутність...",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Makoto",
   "en": "Who is it?",
   "uk": "Хто це?",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Makoto",
   "en": "Who's there!?",
   "uk": "Хто там!?",
   "note": ""
  },
  {
   "id": "MSG_019_5_0#0",
   "speaker": "Makoto",
   "en": "I can't take this anymore! I'm leaving!",
   "uk": "Я більше не витримаю! Я йду!",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Makoto",
   "en": "N-No... My legs won't move...",
   "uk": "Н-ні... Ноги не слухаються...",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Makoto",
   "en": "Aaaaaaah!",
   "uk": "А-а-а-а-а-а!",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Ann",
   "en": "Alibaba! Futaba!",
   "uk": "Алібабо! Футабо!",
   "note": ""
  },
  {
   "id": "MSG_023_5_0#0",
   "speaker": "Ann",
   "en": "Hey! C'mon, where are you!?",
   "uk": "Агов! Ну ж бо, де ти!?",
   "note": ""
  },
  {
   "id": "MSG_023_5_0#1",
   "speaker": "Ann",
   "en": "You're a hacker, right?[n]Just show yourself!",
   "uk": "Ти ж хакер, так?[n]Просто покажися!",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Makoto",
   "en": "I'msorryI'msorryI'msorry![n]PleasesavemeSis...",
   "uk": "Вибачтевибачтевибачте![n]Сестричкорятуймене...",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Sojiro's Voice",
   "en": "Are you okay, Futaba!?",
   "uk": "Футабо, ти в порядку!?",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Ryuji",
   "en": "Crap, he's home!",
   "uk": "Чорт, він удома!",
   "note": ""
  },
  {
   "id": "MSG_027_0_0#0",
   "speaker": "Sojiro",
   "en": "Who the hell are you!? Don't move!",
   "uk": "Ви хто такі, в біса!? Ні руш!",
   "note": ""
  },
  {
   "id": "MSG_027_5_0#0",
   "speaker": "Sojiro",
   "en": "You hear me!?",
   "uk": "Чуєте мене!?",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Makoto",
   "en": "I'msorryI'msorryI'msosorrySis...[n]Somebodypleasesaveme...",
   "uk": "Вибачтевибачтевибачтесестричко...[n]Хтоськольрятуйтемене...",
   "note": ""
  }
 ]
}