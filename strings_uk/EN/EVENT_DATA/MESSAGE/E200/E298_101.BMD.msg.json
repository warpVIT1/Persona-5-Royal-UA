{
 "file": "EN/EVENT_DATA/MESSAGE/E200/E298_101.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Futaba",
   "en": "An eyeball...? What's this?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_000_0_0#1",
   "speaker": "Futaba",
   "en": "Huh? When did it get on here?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Futaba",
   "en": "Wh-Whoaaa...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#1",
   "speaker": "Futaba",
   "en": "Wh-Who're you?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "I am the other you.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Futaba",
   "en": "Is this some kinda hallucination?[n]It's different from usual...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "How long will you continue blaming[n]yourself and shutting yourself away[n]from the world?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Futaba",
   "en": "Blaming myself for what?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "For your mother's death.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "Don't you think it's time you grasped[n]the truth of that moment?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#1",
   "speaker": "Shadow Futaba",
   "en": "What happened before your eyes...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#2",
   "speaker": "Shadow Futaba",
   "en": "What happened to your mother...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Futaba",
   "en": "The truth...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "Why did you choose to rely on the[n]Phantom Thieves?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Futaba",
   "en": "That's...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "Are you simply going to shut yourself in[n]and do nothing?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#1",
   "speaker": "Shadow Futaba",
   "en": "Are you going to avert your eyes from[n]the true answer?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Futaba",
   "en": "......",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "If so... I will kill them in your world.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Futaba",
   "en": "I... What should I do?",
   "uk": "",
   "note": ""
  }
 ]
}