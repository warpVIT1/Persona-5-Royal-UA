{
 "file": "EN/EVENT_DATA/MESSAGE/E200/E273_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Sae",
   "en": "So you won't tell me, no matter what?",
   "uk": "Отже, ви нізащо мені не скажете?",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Sojiro",
   "en": "I have nothing more to say to you[n]about that.",
   "uk": "Мені більше нічого вам[n]про це сказати.",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Sae",
   "en": "I see. In that case, I have ways of[n]making you talk.",
   "uk": "Ясно. У такому разі в мене є способи[n]змусити вас говорити.",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Sojiro",
   "en": "Huh? What's that supposed to—",
   "uk": "Га? Що це має—",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Sae",
   "en": "Thanks for the drink.",
   "uk": "Дякую за напій.",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Sojiro",
   "en": "H-Hey! We're not done here yet!",
   "uk": "А-агов! Ми ще не закінчили!",
   "note": ""
  },
  {
   "id": "SEL_006_0_0#0",
   "speaker": null,
   "en": "What's wrong?",
   "uk": "А що таке?",
   "note": ""
  },
  {
   "id": "SEL_006_0_0#1",
   "speaker": null,
   "en": "I'm home.",
   "uk": "Я вдома.",
   "note": ""
  },
  {
   "id": "SEL_006_0_0#2",
   "speaker": null,
   "en": "Lover's quarrel?",
   "uk": "Сварка закоханих?",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Sojiro",
   "en": "It's nothing.",
   "uk": "Нічого особливого.",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Sojiro",
   "en": "Yeah, that's obvious.",
   "uk": "Ага, бачу.",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Sojiro",
   "en": "No, you moron.",
   "uk": "Ні, бовдуре.",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Sojiro",
   "en": "It's past closing time. Clean up the place.",
   "uk": "Уже по закриттю. Прибери тут.",
   "note": ""
  }
 ]
}