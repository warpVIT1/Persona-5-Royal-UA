{
 "file": "EN/EVENT_DATA/MESSAGE/E200/E205_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Ryuji",
   "en": "Nothin's happenin'... I wonder what's—",
   "uk": "Нічого не відбувається... Цікаво, що там—",
   "note": ""
  },
  {
   "id": "MSG_000_0_0#1",
   "speaker": "Ryuji",
   "en": "...Hm!?",
   "uk": "...Га?!",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Ryuji",
   "en": "...It's off!",
   "uk": "...Вимкнулися!",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Ryuji",
   "en": "They seriously did it!",
   "uk": "У них справді вийшло!",
   "note": ""
  },
  {
   "id": "SEL_003_0_0#0",
   "speaker": null,
   "en": "They're amazing.",
   "uk": "Вони неймовірні.",
   "note": ""
  },
  {
   "id": "SEL_003_0_0#1",
   "speaker": null,
   "en": "Stay on guard.",
   "uk": "Не втрачай пильності.",
   "note": ""
  },
  {
   "id": "SEL_003_0_0#2",
   "speaker": null,
   "en": "What a surprise...",
   "uk": "Оце так несподіванка...",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Ryuji",
   "en": "Yeah, for real!",
   "uk": "Ага, і не кажи!",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Ryuji",
   "en": "Oh, right! These could come back on[n]at any second!",
   "uk": "А, точно! Вони ж можуть будь-якої миті[n]ввімкнутися знову!",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Ryuji",
   "en": "Yeah! It really is a miracle!",
   "uk": "Так! Це справді диво!",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Ryuji",
   "en": "Let's go!",
   "uk": "Ходімо!",
   "note": ""
  }
 ]
