{
 "file": "EN/EVENT_DATA/MESSAGE/E200/E290_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Morgana",
   "en": "This is Futaba's room.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Makoto",
   "en": "Futaba-chan? You're in there, right?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Morgana",
   "en": "There's no answer...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Makoto",
   "en": "Futaba-chan. Are you there?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#1",
   "speaker": "Makoto",
   "en": "I'm sorry for being startled and screaming[n]yesterday. It was so dark that I got scared.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Yusuke",
   "en": "No reaction whatsoever.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Ryuji",
   "en": "This is gonna be hard...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Makoto",
   "en": "You're listening, right, Alibaba?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Makoto",
   "en": "Is it Alibaba?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Alibaba",
   "en": "Why are you here?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Morgana",
   "en": "Why's she only reacting[n]to that name...?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Makoto",
   "en": "You're Futaba Sakura, aren't you?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Yusuke",
   "en": "She's not responding again.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Ann",
   "en": "Does she not like us saying her name?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Morgana",
   "en": "We don't have time to dally around.[n]We need her keyword before dealing[n]with Alibaba's identity.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Makoto",
   "en": "We want to learn more about you.[n]If we don't do so, we can't steal[n]your heart.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#1",
   "speaker": "Makoto",
   "en": "The reason why we came here is[n]because we need the keyword to[n]enter your Palace.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#2",
   "speaker": "Makoto",
   "en": "That's why we want to talk with[n]Futaba Sakura herself, and not[n]Alibaba.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Makoto",
   "en": "You don't have to show yourself.[n]Just answer some questions for us.[n]Chat messages are fine.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Alibaba",
   "en": "Okay.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Makoto",
   "en": "All right then...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#1",
   "speaker": "Makoto",
   "en": "Our leader, the guy who lives in[n]Leblanc's attic, wants to speak[n]with you.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Makoto",
   "en": "We're counting on you, [fName]-kun.[n]Try and get a keyword out of her.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_5_0#0",
   "speaker": "Alibaba",
   "en": "What do you want to hear?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_019_0_0#0",
   "speaker": null,
   "en": "What is this house to you?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_019_0_0#1",
   "speaker": null,
   "en": "Do you like this house?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_019_0_0#2",
   "speaker": null,
   "en": "How's it feel living here?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Alibaba",
   "en": "A house is a house.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Makoto",
   "en": "Looks like you should ask something[n]different.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Alibaba",
   "en": "......?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Makoto",
   "en": "Looks like you should ask something[n]different.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Alibaba",
   "en": "It's painful...",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_025_0_0#0",
   "speaker": null,
   "en": "Why?",
   "uk": "Чому?",
   "note": ""
  },
  {
   "id": "SEL_025_0_0#1",
   "speaker": null,
   "en": "Do you hate it?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_025_0_0#2",
   "speaker": null,
   "en": "Why don't you go out?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Alibaba",
   "en": "It's hard to tell.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_027_0_0#0",
   "speaker": "Makoto",
   "en": "Looks like you should ask something[n]different.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Alibaba",
   "en": "I don't.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_029_0_0#0",
   "speaker": "Makoto",
   "en": "Looks like you should ask something[n]different.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_030_0_0#0",
   "speaker": "Alibaba",
   "en": "I can't leave this place.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_030_0_0#1",
   "speaker": "Alibaba",
   "en": "I'm going to die here.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_031_0_0#0",
   "speaker": "Ann",
   "en": "Wha— Die...?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_032_0_0#0",
   "speaker": "Alibaba",
   "en": "Is this going to continue?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_033_0_0#0",
   "speaker": null,
   "en": "Die?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_033_0_0#1",
   "speaker": null,
   "en": "You should leave that room.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_033_0_0#2",
   "speaker": null,
   "en": "Why did you say that?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_034_0_0#0",
   "speaker": "Alibaba",
   "en": "That's right. I'm definitely[n]going to die here.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_035_0_0#0",
   "speaker": "Alibaba",
   "en": "That's impossible.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_036_0_0#0",
   "speaker": "Alibaba",
   "en": "Why?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_037_0_0#0",
   "speaker": "Alibaba",
   "en": "This place is my tomb.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_038_0_0#0",
   "speaker": "Makoto",
   "en": "Tomb?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_039_0_0#0",
   "speaker": "Ryuji",
   "en": "You think that's it?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_040_0_0#0",
   "speaker": "Morgana",
   "en": "Try entering \"tomb.\"",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_041_0_0#0",
   "speaker": "Navigation Voice",
   "en": "Input accepted. Searching for route[n]to destination.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_042_0_0#0",
   "speaker": "Morgana",
   "en": "We got it...!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_043_0_0#0",
   "speaker": "Alibaba",
   "en": "Was that enough?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_044_0_0#0",
   "speaker": "Makoto",
   "en": "Yes. It was plenty.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_044_0_0#1",
   "speaker": "Makoto",
   "en": "You haven't forgotten your[n]promise of helping us if we[n]complete your request, right?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_046_0_0#0",
   "speaker": "Alibaba",
   "en": "I haven't. We made a deal.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_049_0_0#0",
   "speaker": "Ryuji",
   "en": "Well then, let's hurry up and go.[n]Aaaand clicky.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_050_0_0#0",
   "speaker": "Morgana",
   "en": "You idiot, don't activate it here!",
   "uk": "",
   "note": ""
  }
 ]
}