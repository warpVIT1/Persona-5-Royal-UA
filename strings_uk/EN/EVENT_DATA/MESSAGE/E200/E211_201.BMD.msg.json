{
 "file": "EN/EVENT_DATA/MESSAGE/E200/E211_201.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Morgana",
   "en": "Oh yeah. We haven't decided on[n]the new recruit's code name yet.",
   "uk": "А, точно. Ми ж іще не придумали[n]новачкові кодове ім'я.",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Ann",
   "en": "It has to be \"Kitsune.\" You know, with[n]that kitsune mask and everything.",
   "uk": "Тільки «Кіцуне». Ну, через цю лисячу[n]маску й усе таке.",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Ryuji",
   "en": "Hell yeah. That really leaves an[n]impression.",
   "uk": "Ага, точно. Вона добряче впадає в око.",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Yusuke",
   "en": "Are you talking about me?",
   "uk": "Ви говорите про мене?",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Ann",
   "en": "What do you want your name over here[n]to be?",
   "uk": "Як ти хочеш, щоб тебе звали тут?",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Yusuke",
   "en": "I'd say \"Da Vinci.\"",
   "uk": "Я сказав би «Да Вінчі».",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Ryuji",
   "en": "Nope.",
   "uk": "Не-а.",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Ryuji",
   "en": "Well, you've got that mask like Ann said...[n]and there's that weird tail...",
   "uk": "Ну, в тебе ця маска, як сказала Анн...[n]і ще цей дивний хвіст...",
   "note": ""
  },
  {
   "id": "MSG_008_5_0#0",
   "speaker": "Ryuji",
   "en": "All right! You're Abura-age!",
   "uk": "Точно! Ти — Абураге!",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Morgana",
   "en": "Snrk...",
   "uk": "Пф-ф...",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Yusuke",
   "en": "Very well.",
   "uk": "Гаразд.",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Morgana",
   "en": "He's agreed to it!?",
   "uk": "Він погодився?!",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Ryuji",
   "en": "It's decided then! Abura-age!",
   "uk": "Тоді вирішено! Абураге!",
   "note": ""
  },
  {
   "id": "MSG_015_3_0#0",
   "speaker": "Ann",
   "en": "Nuh-uh! Not happening!",
   "uk": "Е, ні! Нізащо!",
   "note": ""
  },
  {
   "id": "MSG_015_5_0#0",
   "speaker": "Ann",
   "en": "Do you have any ideas, Joker?",
   "uk": "Маєш якісь ідеї, Джокере?",
   "note": ""
  },
  {
   "id": "SEL_016_0_0#0",
   "speaker": null,
   "en": "Clown.",
   "uk": "Клоун.",
   "note": ""
  },
  {
   "id": "SEL_016_0_0#1",
   "speaker": null,
   "en": "Fox.",
   "uk": "Лис.",
   "note": ""
  },
  {
   "id": "SEL_016_0_0#2",
   "speaker": null,
   "en": "I can't think of anything.",
   "uk": "Нічого не спадає на думку.",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Ann",
   "en": "That's a little too similar[n]to Joker though...",
   "uk": "Якось надто схоже на Джокера...",
   "note": ""
  },
  {
   "id": "MSG_017_5_0#0",
   "speaker": "Ann",
   "en": "\"Fox\" then. How about that?",
   "uk": "Тоді «Лис». Як вам?",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Ryuji",
   "en": "Not bad.",
   "uk": "Непогано.",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Ryuji",
   "en": "Ohhh, just keep it literal, huh? Sounds[n]good to me.",
   "uk": "О-о, просто як є, га? Мені подобається.",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Ann",
   "en": "Ugh... Why don't we go with a literal[n]\"Fox\" then?",
   "uk": "Ех... Чому б тоді не взяти просто[n]«Лис», як є?",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Ryuji",
   "en": "Oooh, not bad at all.",
   "uk": "О-о, зовсім непогано.",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Morgana",
   "en": "What do you think, Fox?",
   "uk": "Що скажеш, Лисе?",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Yusuke",
   "en": "It's acceptable.",
   "uk": "Прийнятно.",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Ryuji",
   "en": "It's set then. Let's go.",
   "uk": "Тоді вирішено. Ходімо.",
   "note": ""
  }
 ]
}