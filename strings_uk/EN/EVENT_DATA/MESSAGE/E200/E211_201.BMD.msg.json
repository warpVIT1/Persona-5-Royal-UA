{
 "file": "EN/EVENT_DATA/MESSAGE/E200/E211_201.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Morgana",
   "en": "Oh yeah. We haven't decided on[n]the new recruit's code name yet.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Ann",
   "en": "It has to be \"Kitsune.\" You know, with[n]that kitsune mask and everything.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Ryuji",
   "en": "Hell yeah. That really leaves an[n]impression.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Yusuke",
   "en": "Are you talking about me?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Ann",
   "en": "What do you want your name over here[n]to be?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Yusuke",
   "en": "I'd say \"Da Vinci.\"",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Ryuji",
   "en": "Nope.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Ryuji",
   "en": "Well, you've got that mask like Ann said...[n]and there's that weird tail...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_5_0#0",
   "speaker": "Ryuji",
   "en": "All right! You're Abura-age!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Morgana",
   "en": "Snrk...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Yusuke",
   "en": "Very well.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Morgana",
   "en": "He's agreed to it!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Ryuji",
   "en": "It's decided then! Abura-age!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_3_0#0",
   "speaker": "Ann",
   "en": "Nuh-uh! Not happening!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_5_0#0",
   "speaker": "Ann",
   "en": "Do you have any ideas, Joker?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_016_0_0#0",
   "speaker": null,
   "en": "Clown.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_016_0_0#1",
   "speaker": null,
   "en": "Fox.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_016_0_0#2",
   "speaker": null,
   "en": "I can't think of anything.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Ann",
   "en": "That's a little too similar[n]to Joker though...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_5_0#0",
   "speaker": "Ann",
   "en": "\"Fox\" then. How about that?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Ryuji",
   "en": "Not bad.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Ryuji",
   "en": "Ohhh, just keep it literal, huh? Sounds[n]good to me.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Ann",
   "en": "Ugh... Why don't we go with a literal[n]\"Fox\" then?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Ryuji",
   "en": "Oooh, not bad at all.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Morgana",
   "en": "What do you think, Fox?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Yusuke",
   "en": "It's acceptable.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Ryuji",
   "en": "It's set then. Let's go.",
   "uk": "",
   "note": ""
  }
 ]
