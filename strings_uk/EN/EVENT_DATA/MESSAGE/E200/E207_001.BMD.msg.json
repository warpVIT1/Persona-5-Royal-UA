{
 "file": "EN/EVENT_DATA/MESSAGE/E200/E207_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Ryuji",
   "en": "I hope those two managed to[n]get away...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Ann",
   "en": "Noooooo!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Yusuke",
   "en": "Ngh...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Yusuke",
   "en": "Gah...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Morgana",
   "en": "Aaagh... Owwwwww!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Ann",
   "en": "I thought I was gonna die...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#1",
   "speaker": "Ann",
   "en": "...Hey, will you let go already!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Yusuke",
   "en": "Hrgh!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Ann",
   "en": "Oh no! I didn't mean to push him[n]so hard... Are you okay? Wake up!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Yusuke",
   "en": "Who are you all!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_1_0#0",
   "speaker": "Ann",
   "en": "Calm down, Kitagawa-kun! It's me!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_3_0#0",
   "speaker": "Yusuke",
   "en": "...Takamaki-san?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_3_0#1",
   "speaker": "Yusuke",
   "en": "That means you two are...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_5_0#0",
   "speaker": "Yusuke",
   "en": "I don't recall ever seeing this cat costume[n]before though...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_7_0#0",
   "speaker": "Yusuke",
   "en": "What is this place?",
   "uk": "Що це за місце?",
   "note": ""
  },
  {
   "id": "MSG_008_9_0#0",
   "speaker": "Ann",
   "en": "We're inside Madarame's heart.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Yusuke",
   "en": "Inside... Sensei's heart?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#1",
   "speaker": "Yusuke",
   "en": "I'm sorry, Takamaki-san... but are[n]you sure you're feeling okay?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Ryuji",
   "en": "She ain't lyin'. This is what that bastard[n]truly feels. He's nothin' but a greed-filled[n]money-grubber.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Yusuke",
   "en": "Enough of this rubbish!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Ann",
   "en": "Kitagawa-kun! Didn't it cross your mind[n]that something wasn't right about[n]Madarame!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Yusuke",
   "en": "That's...",
   "uk": "Це...",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Ann",
   "en": "You may not want to believe it, but[n]this is another reality as viewed[n]through Madarame's eyes.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#1",
   "speaker": "Ann",
   "en": "...This is his true nature.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Yusuke",
   "en": "This repulsive world?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#1",
   "speaker": "Yusuke",
   "en": "Just who are all of you!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Ryuji",
   "en": "I guess you could say... we're a group[n]that changes the hearts of rotten crooks.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Yusuke",
   "en": "If everything you say is true, then[n]the sensei I know doesn't exist...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Ryuji",
   "en": "You gotta snap out of it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Yusuke",
   "en": "Still... he has kept me safe these past[n]ten years. My gratitude for that won't[n]just disappear.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Ryuji",
   "en": "You're gonna forgive him!? [n]At this rate you'll...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Yusuke",
   "en": "N-Ngh...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Ann",
   "en": "Are you okay?",
   "uk": "З тобою все гаразд?",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Yusuke",
   "en": "I'm trying to be rational about this, but[n]my emotions are overwhelming me...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Morgana",
   "en": "Sorry, but we don't have time to dawdle.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_5_0#0",
   "speaker": "Morgana",
   "en": "The security level's gone through[n]the roof! We need to get out of here[n]at once!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Yusuke",
   "en": "*pant* *pant*",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_027_0_0#0",
   "speaker": null,
   "en": "Let's go.",
   "uk": "Ходімо.",
   "note": ""
  },
  {
   "id": "SEL_027_0_0#1",
   "speaker": null,
   "en": "Here, lean on my shoulder.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Yusuke",
   "en": "...Yes.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_029_0_0#0",
   "speaker": "Yusuke",
   "en": "...No, it's all right.",
   "uk": "",
   "note": ""
  }
 ]
}