{
 "file": "EN/EVENT_DATA/MESSAGE/E300/E329_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Ryuji",
   "en": "The hell's up with this!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Ann",
   "en": "Look at it... There's no way we can force[n]that thing open.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Yusuke",
   "en": "We've hit a blockade quite early. Will we[n]have to control the real Okumura's[n]cognition to pass?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Makoto",
   "en": "Oh, that means Mona hasn't been able[n]to proceed any further either.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#1",
   "speaker": "Makoto",
   "en": "So if he's here in the Palace, he would[n]have to be somewhere before this door...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Girl's Voice",
   "en": "Halt, vigilante!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Ryuji",
   "en": "Wh-Who's that!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Mysterious Masked Girl",
   "en": "......",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Makoto",
   "en": "Those clothes... Could she be...?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Ann",
   "en": "A black mask!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#1",
   "speaker": "Ann",
   "en": "Wait, is she the one Madarame and[n]Kaneshiro were talking about!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Ryuji",
   "en": "So... she's the reason for all those people[n]goin' brain dead!? It was a girl this whole[n]time!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Mysterious Masked Girl",
   "en": "......",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Yusuke",
   "en": "Are you the one who has been[n]following us!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Ryuji",
   "en": "Say something, dammit!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Mysterious Voice",
   "en": "Enough of your misunderstandings!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Futaba",
   "en": "Mona!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Ann",
   "en": "You're okay!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Morgana",
   "en": "Long time no see, Panther.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Ryuji",
   "en": "Uh, it hasn't been that long.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Morgana",
   "en": "If you came for the Treasure, you should[n]just go home with your tail between your[n]legs.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Yusuke",
   "en": "Actually, we were looking for you.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Morgana",
   "en": "The Treasure will be taken by me[n]and this...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Morgana",
   "en": "This Beauty Thief!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Makoto",
   "en": "Beauty Thief?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Morgana",
   "en": "I'll have you know she's a Persona-user[n]too!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Beauty Thief",
   "en": "My name is Beauty Thief!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Ann",
   "en": "She really called herself that?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_027_0_0#0",
   "speaker": "Yusuke",
   "en": "Any tension that was in the air has just[n]gone out the window...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Beauty Thief",
   "en": "We will take the Treasure!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_029_0_0#0",
   "speaker": "Futaba",
   "en": "Mona already said that...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_030_0_0#0",
   "speaker": "Beauty Thief",
   "en": "You are not qualified to be phantom[n]thieves!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_030_0_0#1",
   "speaker": "Beauty Thief",
   "en": "Do you even understand what it means[n]to be a phantom thief? An admirable[n]phantom thief is...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_031_0_0#0",
   "speaker": "Morgana",
   "en": "Yeah, tell them!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_032_0_0#0",
   "speaker": "Beauty Thief",
   "en": "You! What do you think it means!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_033_0_0#0",
   "speaker": null,
   "en": "One who helps the weak.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_033_0_0#1",
   "speaker": null,
   "en": "One who lives for thrills.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_033_0_0#2",
   "speaker": null,
   "en": "I don't think about it.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_034_0_0#0",
   "speaker": "Beauty Thief",
   "en": "Yes, that's right?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_035_0_0#0",
   "speaker": "Beauty Thief",
   "en": "I see!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_036_0_0#0",
   "speaker": "Beauty Thief",
   "en": "That's no good, I say!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_037_0_0#0",
   "speaker": "Beauty Thief",
   "en": "Enough with the idle chitchat!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_038_0_0#0",
   "speaker": "Ann",
   "en": "You started it...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_039_0_0#0",
   "speaker": "Ryuji",
   "en": "Mona, who the hell is she?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_040_0_0#0",
   "speaker": "Morgana",
   "en": "Wait! I'll fix this...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_041_0_0#0",
   "speaker": "Beauty Thief",
   "en": "You!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_042_0_0#0",
   "speaker": "Yusuke",
   "en": "Me?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_043_0_0#0",
   "speaker": "Beauty Thief",
   "en": "Learn to take a hint!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_044_0_0#0",
   "speaker": "Yusuke",
   "en": "Huh?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_045_0_0#0",
   "speaker": "Beauty Thief",
   "en": "And you! You're very vulgar...[n]and very stupid!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_046_0_0#0",
   "speaker": "Ryuji",
   "en": "What?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_047_0_0#0",
   "speaker": "Beauty Thief",
   "en": "Um...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_048_0_0#0",
   "speaker": "Beauty Thief",
   "en": "What was it again?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_049_0_0#0",
   "speaker": "Makoto",
   "en": "You came all the way here just to[n]say that?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_050_0_0#0",
   "speaker": "Ryuji",
   "en": "I dunno... It kinda feels like she ain't[n]dangerous at all...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_051_0_0#0",
   "speaker": "Beauty Thief",
   "en": "We will take the Treasure!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_052_0_0#0",
   "speaker": "Futaba",
   "en": "You already said that...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_053_0_0#0",
   "speaker": "Morgana",
   "en": "We don't have time to chat!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_054_0_0#0",
   "speaker": "Ryuji",
   "en": "No point, it won't open—",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_055_0_0#0",
   "speaker": "Morgana",
   "en": "Don't underestimate us.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_056_0_0#0",
   "speaker": "Ann",
   "en": "Behind you!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_057_0_0#0",
   "speaker": "Yusuke",
   "en": "Here they come!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_058_0_0#0",
   "speaker": "Beauty Thief",
   "en": "Huh? Huh!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_059_0_0#0",
   "speaker": "Morgana",
   "en": "Snap out of it! We need to go!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_060_0_0#0",
   "speaker": "Makoto",
   "en": "We'll meet up later at our usual spot![n]Let's hurry!",
   "uk": "",
   "note": ""
  }
 ]
