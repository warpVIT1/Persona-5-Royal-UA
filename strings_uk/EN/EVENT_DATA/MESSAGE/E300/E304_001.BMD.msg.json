{
 "file": "EN/EVENT_DATA/MESSAGE/E300/E304_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Ryuji",
   "en": "Hey... You guys still alive?",
   "uk": "Агов... Ви там живі?",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Ann",
   "en": "I thought I was gonna die in— HEY![n]Will you let go already!?",
   "uk": "Я думала, що помру в... АГОВ![n]Може, вже відпустиш!?",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Ann",
   "en": "Ah, sorry!",
   "uk": "Ой, вибач!",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Yusuke",
   "en": "N-Not again...",
   "uk": "З-знову...",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Sojiro",
   "en": "What was that sound?",
   "uk": "Що це був за звук?",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#1",
   "speaker": "Sojiro",
   "en": "...Hm? What're you guys doing out here?",
   "uk": "...Га? А що це ви тут робите?",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Ann",
   "en": "Oh, ummm...",
   "uk": "Ой, е-е-е...",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Ryuji",
   "en": "That reminds me, where's Futaba?",
   "uk": "До речі, а де Футаба?",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Sojiro",
   "en": "What about Futaba?",
   "uk": "А що з Футабою?",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Ann",
   "en": "Oh, um...",
   "uk": "Ой, ну...",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Makoto",
   "en": "Ah, yes! We came all this way, so how[n]about we enjoy some coffee?",
   "uk": "А, так! Раз уже ми сюди прийшли, може,[n]вип'ємо кави?",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Ann",
   "en": "Oh! That's a great idea!",
   "uk": "О! Чудова ідея!",
   "note": ""
  },
  {
   "id": "MSG_011_5_0#0",
   "speaker": "Sojiro",
   "en": "That's fine, but...",
   "uk": "Та будь ласка, але...",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Yusuke",
   "en": "I'm not thirsty though.",
   "uk": "Хоча мені не хочеться пити.",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Makoto",
   "en": "Oh, I almost forgot!",
   "uk": "Ой, ледь не забула!",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#1",
   "speaker": "Makoto",
   "en": "I have some business to take care of,[n]so you guys go on ahead.",
   "uk": "У мене є одна справа, тож ідіть[n]без мене.",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Ann",
   "en": "O-Okay, gotcha!",
   "uk": "Г-гаразд, зрозуміла!",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Makoto",
   "en": "Let's go see Futaba.",
   "uk": "Ходімо до Футаби.",
   "note": ""
  }
 ]
}