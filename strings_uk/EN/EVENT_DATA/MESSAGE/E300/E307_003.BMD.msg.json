{
 "file": "EN/EVENT_DATA/MESSAGE/E300/E307_003.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Futaba",
   "en": "I'm doooooone!",
   "uk": "Гото-о-о-ово!",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Morgana",
   "en": "Wh-What's up? Something happened?",
   "uk": "Щ-що таке? Щось сталося?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Futaba",
   "en": "It's finished.",
   "uk": "Закінчено.",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Morgana",
   "en": "Finished? What is?",
   "uk": "Закінчено? Що саме?",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Futaba",
   "en": "Ah, it's so clean! Why!?",
   "uk": "Ой, як чисто! Чому!?",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Morgana",
   "en": "We cleaned it.",
   "uk": "Ми прибрали.",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#1",
   "speaker": "Morgana",
   "en": "Anyway, is it true? Did you really take care[n]of Medjed?",
   "uk": "Хай там як, це правда? Ти справді[n]розібралася з Меджедом?",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Futaba",
   "en": "I handled them, and someone else[n]handled my room!",
   "uk": "Я розібралася з ними, а хтось[n]розібрався з моєю кімнатою!",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#1",
   "speaker": "Futaba",
   "en": "I don't understand, but this is good!",
   "uk": "Не розумію як, але це круто!",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Morgana",
   "en": "Futaba?",
   "uk": "Футабо?",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#1",
   "speaker": "Morgana",
   "en": "Hey, Futaba! What's wrong!?",
   "uk": "Агов, Футабо! Що з тобою!?",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Morgana",
   "en": "She's sleeping...",
   "uk": "Вона спить...",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#1",
   "speaker": "Morgana",
   "en": "Well, it looks like it's been taken care of.[n]I guess we should get home and sleep[n]too...",
   "uk": "Що ж, схоже, усе владнано. Мабуть,[n]нам теж час додому спати...",
   "note": ""
  }
 ]
}