{
 "file": "EN/EVENT_DATA/MESSAGE/E300/E318_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Ann",
   "en": "I'm so sleepy...",
   "uk": "Як же хочеться спати...",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Makoto",
   "en": "It'll take over six hours to get there,[n]so why not sleep on the plane?",
   "uk": "Летіти понад шість годин, тож чому[n]б не поспати в літаку?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Ann",
   "en": "I'll do that...",
   "uk": "Так і зроблю...",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Makoto",
   "en": "It's almost time to check in.",
   "uk": "Скоро реєстрація.",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Ann",
   "en": "Phew, looks like it's gonna take off[n]on time.",
   "uk": "Фух, схоже, виліт за розкладом.",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#1",
   "speaker": "Ann",
   "en": "I feel like a lot of flights headed to[n]America tend to run late or get canceled...",
   "uk": "Мені здається, рейси до Америки часто[n]затримують або скасовують...",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Ann",
   "en": "Is it just me or is Ryuji not here yet?",
   "uk": "Мені здається, чи Рюджі ще немає?",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Makoto",
   "en": "...Oh!",
   "uk": "...О!",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Ryuji",
   "en": "I wasn't expectin' to make a mad dash[n]like this...",
   "uk": "Не думав, що доведеться отак[n]мчати стрімголов...",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Ann",
   "en": "Coming late even on a day like this?",
   "uk": "Запізнюєшся навіть у такий день?",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Makoto",
   "en": "That's all you're bringing?",
   "uk": "І це все, що ти береш?",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Ryuji",
   "en": "It's only four nights, right? Ain't it enough?",
   "uk": "Це ж лише чотири ночі, так? Хіба не досить?",
   "note": ""
  },
  {
   "id": "SEL_017_0_0#0",
   "speaker": null,
   "en": "Maybe for you.",
   "uk": "Хіба що для тебе.",
   "note": ""
  },
  {
   "id": "SEL_017_0_0#1",
   "speaker": null,
   "en": "You're underpacked...",
   "uk": "Замало ти взяв...",
   "note": ""
  },
  {
   "id": "SEL_017_0_0#2",
   "speaker": null,
   "en": "It'll be fun either way.",
   "uk": "Так чи так буде весело.",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Ryuji",
   "en": "See?",
   "uk": "Бачиш?",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Makoto",
   "en": "I think that was sarcasm...",
   "uk": "Здається, це був сарказм...",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Ryuji",
   "en": "Really? You guys are just freakin' out[n]over this.",
   "uk": "Серйозно? Та ви просто панікуєте[n]на рівному місці.",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Makoto",
   "en": "Well, I guess it's better than bringing[n]too many useless things.",
   "uk": "Ну, мабуть, це краще, ніж набрати[n]купу непотребу.",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Ryuji",
   "en": "Yeah, that!",
   "uk": "Ага, саме так!",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Makoto",
   "en": "Well, I guess so...",
   "uk": "Ну, мабуть, так...",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Mishima",
   "en": "Hey, guys, they want us to gather near[n]the boarding gate soon.",
   "uk": "Агов, народ, просили незабаром зібратися[n]біля виходу на посадку.",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Ann",
   "en": "Why don't we take a group shot before[n]we take off?",
   "uk": "Може, зробимо спільне фото перед[n]вильотом?",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Ryuji",
   "en": "Ooh, sounds good!",
   "uk": "О-о, класна ідея!",
   "note": ""
  },
  {
   "id": "MSG_027_0_0#0",
   "speaker": "Ryuji",
   "en": "You be our cameraman, okay?",
   "uk": "Ти будеш фотографом, лади?",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Ann",
   "en": "Lemme join in too!",
   "uk": "Я теж хочу!",
   "note": ""
  },
  {
   "id": "MSG_029_0_0#0",
   "speaker": "Ann",
   "en": "You too, Makoto.",
   "uk": "І ти, Макото.",
   "note": ""
  },
  {
   "id": "MSG_030_0_0#0",
   "speaker": "Makoto",
   "en": "All right.",
   "uk": "Гаразд.",
   "note": ""
  },
  {
   "id": "SEL_032_0_0#0",
   "speaker": null,
   "en": "Here goes.",
   "uk": "Поїхали.",
   "note": ""
  },
  {
   "id": "SEL_032_0_0#1",
   "speaker": null,
   "en": "Will everyone fit?",
   "uk": "Усі вмістимося?",
   "note": ""
  },
  {
   "id": "SEL_032_0_0#2",
   "speaker": null,
   "en": "This is embarrassing.",
   "uk": "Аж ніяково.",
   "note": ""
  },
  {
   "id": "MSG_033_0_0#0",
   "speaker": "Makoto",
   "en": "Huh? Where am I supposed to look?",
   "uk": "Га? А куди мені дивитися?",
   "note": ""
  },
  {
   "id": "MSG_034_0_0#0",
   "speaker": "Ryuji",
   "en": "Come on, hurry up.",
   "uk": "Ну ж бо, швидше.",
   "note": ""
  },
  {
   "id": "MSG_035_0_0#0",
   "speaker": "Ann",
   "en": "This is us being \"normal\" students too,[n]you know?",
   "uk": "Ми ж теж «звичайні» учні,[n]розумієш?",
   "note": ""
  },
  {
   "id": "MSG_036_0_0#0",
   "speaker": "Ryuji",
   "en": "Lemme see, lemme see!",
   "uk": "Дай глянути, дай глянути!",
   "note": ""
  },
  {
   "id": "MSG_038_0_0#0",
   "speaker": "Ryuji",
   "en": "What?",
   "uk": "Що?",
   "note": ""
  },
  {
   "id": "MSG_039_0_0#0",
   "speaker": "Ryuji",
   "en": "Holy shit, she's right...",
   "uk": "Трясця, вона має рацію...",
   "note": ""
  },
  {
   "id": "MSG_040_0_0#0",
   "speaker": "Ann",
   "en": "How could you tell, Futaba?",
   "uk": "Як ти здогадалася, Футабо?",
   "note": ""
  },
  {
   "id": "MSG_043_0_0#0",
   "speaker": "Ryuji",
   "en": "Talk about a nasty trick...",
   "uk": "Оце так підступний прийом...",
   "note": ""
  },
  {
   "id": "MSG_044_0_0#0",
   "speaker": "Makoto",
   "en": "I am so glad she's not an enemy of ours.",
   "uk": "Як же добре, що вона нам не ворог.",
   "note": ""
  }
 ]
}