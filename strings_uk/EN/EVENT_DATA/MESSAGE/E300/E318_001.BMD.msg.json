 "file": "EN/EVENT_DATA/MESSAGE/E300/E318_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Ann",
   "en": "I'm so sleepy...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Makoto",
   "en": "It'll take over six hours to get there,[n]so why not sleep on the plane?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Ann",
   "en": "I'll do that...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Makoto",
   "en": "It's almost time to check in.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Ann",
   "en": "Phew, looks like it's gonna take off[n]on time.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#1",
   "speaker": "Ann",
   "en": "I feel like a lot of flights headed to[n]America tend to run late or get canceled...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Ann",
   "en": "Is it just me or is Ryuji not here yet?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Makoto",
   "en": "...Oh!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Ryuji",
   "en": "I wasn't expectin' to make a mad dash[n]like this...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Ann",
   "en": "Coming late even on a day like this?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Makoto",
   "en": "That's all you're bringing?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Ryuji",
   "en": "It's only four nights, right? Ain't it enough?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_017_0_0#0",
   "speaker": null,
   "en": "Maybe for you.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_017_0_0#1",
   "speaker": null,
   "en": "You're underpacked...",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_017_0_0#2",
   "speaker": null,
   "en": "It'll be fun either way.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Ryuji",
   "en": "See?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Makoto",
   "en": "I think that was sarcasm...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Ryuji",
   "en": "Really? You guys are just freakin' out[n]over this.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Makoto",
   "en": "Well, I guess it's better than bringing[n]too many useless things.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Ryuji",
   "en": "Yeah, that!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Makoto",
   "en": "Well, I guess so...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Mishima",
   "en": "Hey, guys, they want us to gather near[n]the boarding gate soon.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Ann",
   "en": "Why don't we take a group shot before[n]we take off?",
