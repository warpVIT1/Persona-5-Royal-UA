   "speaker": "Ann",
   "en": "Lemme join in too!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_029_0_0#0",
   "speaker": "Ann",
   "en": "You too, Makoto.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_030_0_0#0",
   "speaker": "Makoto",
   "en": "All right.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_032_0_0#0",
   "speaker": null,
   "en": "Here goes.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_032_0_0#1",
   "speaker": null,
   "en": "Will everyone fit?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_032_0_0#2",
   "speaker": null,
   "en": "This is embarrassing.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_033_0_0#0",
   "speaker": "Makoto",
   "en": "Huh? Where am I supposed to look?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_034_0_0#0",
   "speaker": "Ryuji",
   "en": "Come on, hurry up.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_035_0_0#0",
   "speaker": "Ann",
   "en": "This is us being \"normal\" students too,[n]you know?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_036_0_0#0",
   "speaker": "Ryuji",
   "en": "Lemme see, lemme see!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_038_0_0#0",
   "speaker": "Ryuji",
   "en": "What?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_039_0_0#0",
