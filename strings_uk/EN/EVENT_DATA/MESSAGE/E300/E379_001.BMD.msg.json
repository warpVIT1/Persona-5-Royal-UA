  {
   "id": "MSG_001_5_0#0",
   "speaker": "Sojiro",
   "en": "Coffee good for you?",
   "uk": "Каву будеш?",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Man in a Suit",
   "en": ". That is your[n]name, yes?",
   "uk": ". Це твоє ім'я,[n]так?",
