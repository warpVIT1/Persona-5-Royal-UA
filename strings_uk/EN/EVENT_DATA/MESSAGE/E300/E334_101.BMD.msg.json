   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Ryuji",
   "en": "Crap, he disappeared!",
   "uk": "Чорт, він зник!",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Makoto",
   "en": "We didn't make it...",
   "uk": "Не встигли...",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
