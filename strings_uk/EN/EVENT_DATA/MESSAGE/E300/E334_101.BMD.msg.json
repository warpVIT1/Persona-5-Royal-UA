{
 "file": "EN/EVENT_DATA/MESSAGE/E300/E334_101.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Ryuji",
   "en": "Over there!",
   "uk": "Он там!",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Yusuke",
   "en": "How can we expect to catch a car!?",
   "uk": "Як, по-вашому, ми наздоженемо[n]машину?!",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Makoto",
   "en": "No complaining! Just run!",
   "uk": "Без нарікань! Просто біжіть!",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Futaba",
   "en": "*gasp* *wheeze* I-I... can't...",
   "uk": "*хекає* *хрипить* Я-я... не можу...",
   "note": ""
