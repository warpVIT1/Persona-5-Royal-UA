  {
   "id": "MSG_008_0_0#0",
   "speaker": "Ryuji",
   "en": "Hrrrraaaaagh!",
   "uk": "Гр-р-ра-а-а-а!",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
