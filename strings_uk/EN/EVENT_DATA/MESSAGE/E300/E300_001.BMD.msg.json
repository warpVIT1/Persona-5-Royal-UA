{
 "file": "EN/EVENT_DATA/MESSAGE/E300/E300_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Futaba",
   "en": "So this is inside my heart...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_000_0_0#1",
   "speaker": "Futaba",
   "en": "I didn't think it'd be like this...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Futaba",
   "en": "Huh...!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "Do you remember?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Futaba",
   "en": "This is the suicide note...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#1",
   "speaker": "Futaba",
   "en": "The men in black suits read it right after[n]Mom died...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "That's correct. Look at the next one.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Futaba",
   "en": "This...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#1",
   "speaker": "Futaba",
   "en": "This is... when Mom jumped in front of[n]that car...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "That's right. Now the next.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Futaba",
   "en": "No...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "Don't run.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#1",
   "speaker": "Shadow Futaba",
   "en": "I thought you made your mind up after[n]you talked to the Phantom Thieves.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Futaba",
   "en": "Okay... I'll look.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Futaba",
   "en": "...It's me complaining. Mom scolded me[n]for bothering her...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "Yes.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Futaba",
   "en": "I knew it. It was me who killed Mom.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#1",
   "speaker": "Futaba",
   "en": "I was a bad daughter... I weighed her[n]down, and she hated me for it...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#2",
   "speaker": "Futaba",
   "en": "It's just like I remember...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "Are you sure?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Futaba",
   "en": "Huh?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "Remember everything. Don't avert[n]your eyes.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#1",
   "speaker": "Shadow Futaba",
   "en": "When did this happen?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Futaba",
   "en": "Just a little before Mom died...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#1",
   "speaker": "Futaba",
   "en": "I whined about wanting to go on a family[n]trip...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#2",
   "speaker": "Futaba",
   "en": "But she scolded me and said no.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "Was that all she said?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Futaba",
   "en": "Mom said...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#1",
   "speaker": "Futaba",
   "en": "\"I'm too busy right now. I need to[n]finish my cognitive research as soon[n]as possible.\"",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "And what did you do?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Futaba",
   "en": "I threw a tantrum. Told her she thought[n]her research was more important than[n]I was.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#1",
   "speaker": "Futaba",
   "en": "That's when she scolded me...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "What did she say afterwards? There was[n]more.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Futaba",
   "en": "......",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Futaba",
   "en": "Did she say...?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#0",
   "speaker": "Futaba",
   "en": "\"My research is almost over. Once it's[n]finished, we can go wherever you like.\"",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#1",
   "speaker": "Futaba",
   "en": "\"I'm sorry I've left you alone for so long,[n]Futaba. Please try to understand though.\"",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_024_0_0#2",
   "speaker": "Futaba",
   "en": "\"This research is really important. I need[n]to complete it, even if it costs me my life.\"",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "Did she hate you?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Futaba",
   "en": "She didn't...?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_027_0_0#0",
   "speaker": "Futaba",
   "en": "Wh-What? She smiled...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#0",
   "speaker": "Futaba",
   "en": "Agh! My head... It hurts...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_028_0_0#1",
   "speaker": "Futaba",
   "en": "Which is true?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_029_0_0#0",
   "speaker": "Shadow Futaba",
   "en": "Your memory is...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_030_0_0#0",
   "speaker": "Futaba",
   "en": "Huh...?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_031_0_0#0",
   "speaker": "Futaba",
   "en": "It's calling me...?",
   "uk": "",
   "note": ""
  }
 ]
}