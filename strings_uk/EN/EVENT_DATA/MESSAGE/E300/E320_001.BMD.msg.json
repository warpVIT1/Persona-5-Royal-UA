   "speaker": "Futaba",
   "en": "Found it!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_5_0#0",
   "speaker": "Futaba",
   "en": "One after another too...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Morgana",
   "en": "What did you find?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Futaba",
   "en": "Still working. Can't tell you.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Morgana",
   "en": "She can handle this without me...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Futaba",
   "en": "Oooh, so much.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Morgana",
   "en": "All I'm good for is driving them around[n]in Mementos...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#1",
   "speaker": "Morgana",
   "en": "I'm basically useless...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Futaba",
   "en": "Kitty! Your mumbling's distracting me!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#1",
   "speaker": "Futaba",
   "en": "If you got something to say, just spit it out.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Morgana",
   "en": "It's nothing.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Futaba",
   "en": "What were you saying!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Morgana",
   "en": "Lemme go!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Futaba",
   "en": "You feel so nice.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Morgana",
   "en": "I do not!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Futaba",
   "en": "So smooth and silky.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#1",
   "speaker": "Futaba",
   "en": "It's kinda hard to believe fur this soft[n]belongs to a human.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Morgana",
   "en": "Don't make me say it again! I'm a human...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#0",
   "speaker": "Futaba",
   "en": "Couldn't you just be assuming that?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_016_0_0#1",
   "speaker": "Futaba",
   "en": "I had the wrong assumptions about[n]my mom for the longest time.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Morgana",
   "en": "That's not the same! I understand myself[n]better than anyone!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Futaba",
   "en": "That's true.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Morgana",
   "en": "......",
   "uk": "",
   "note": ""
  }
 ]
}