{
 "file": "EN/EVENT_DATA/MESSAGE/E300/E349_004.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Ann",
   "en": "Huh...?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Haru",
   "en": "F-Father!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_5_0#0",
   "speaker": "Ann",
   "en": "Wh-Why did he collapse!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_7_0#0",
   "speaker": "Makoto",
   "en": "That didn't look right at all...[n]Don't tell me...!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Haru",
   "en": "Mona-chan, what's going on?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Morgana",
   "en": "No... That's impossible!",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_004_0_0#0",
   "speaker": null,
   "en": "We did everything the same.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_004_0_0#1",
   "speaker": null,
   "en": "What happened!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Morgana",
   "en": "You're right. We followed all the same[n]steps!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Morgana",
   "en": "I want to know that myself!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Morgana",
   "en": "We made sure we just took the Treasure[n]too...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_5_0#0",
   "speaker": "Haru",
   "en": "*gasp* I should call home!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Ann",
   "en": "This— This isn't our fault... is it?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#1",
   "speaker": "Ann",
   "en": "It's been okay all four times so far—[n]ever since Kamoshida!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Makoto",
   "en": "If we let the Shadow live, the real person[n]won't undergo mental shutdown... right?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Morgana",
   "en": "That's how it should work...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Ryuji",
   "en": "Yeah... i-it's gotta be.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Futaba",
   "en": "A-Ah...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Yusuke",
   "en": "What's wrong?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#0",
   "speaker": "Futaba",
   "en": "Th-This is... the same...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_015_0_0#1",
   "speaker": "Futaba",
   "en": "I remember now... It's just like...[n]what happened to my mom...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_017_0_0#0",
   "speaker": "Yusuke",
   "en": "So this is the moment when mental[n]shutdown occurs...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_018_0_0#0",
   "speaker": "Makoto",
   "en": "But why did they target Okumura-san?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_019_0_0#0",
   "speaker": "Ryuji",
   "en": "Dammit! The hell's goin' on here!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#0",
   "speaker": "Haru",
   "en": "Um... I have to go.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_020_0_0#1",
   "speaker": "Haru",
   "en": "I'll talk to the staff before I leave.[n]Feel free to take your time...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_021_0_0#0",
   "speaker": "Ann",
   "en": "Haru...!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_022_0_0#0",
   "speaker": "Ryuji",
   "en": "This ain't our fault, right?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_023_0_0#0",
   "speaker": "Yusuke",
   "en": "I'd like to think so...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_025_0_0#0",
   "speaker": "Ann",
   "en": "Some welcoming party, huh...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#0",
   "speaker": "Makoto",
   "en": "I'll get in contact with Haru later.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_026_0_0#1",
   "speaker": "Makoto",
   "en": "But for today, I think we should all[n]return home.",
   "uk": "",
   "note": ""
  }
 ]
