 "file": "EN/EVENT_DATA/MESSAGE/E000/E099_070.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "Sumire",
   "en": "Hello, Senpai.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Morgana",
   "en": "Wow, you got here fast.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Sumire",
   "en": "Well, while I was travelling here,[n]I suddenly had this epiphany...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#1",
   "speaker": "Sumire",
   "en": "So I had to hurry over and explain it[n]to you.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_003_0_0#0",
   "speaker": null,
   "en": "An epiphany?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_003_0_0#1",
   "speaker": null,
   "en": "Lay it on me.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_004_0_0#0",
   "speaker": "Sumire",
   "en": "Right... I've been wondering for a while[n]if there's any way I can bring some[n]personal flair to my fights in Mementos.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#0",
   "speaker": "Morgana",
   "en": "Your own flair, eh?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_005_0_0#1",
   "speaker": "Morgana",
   "en": "And you came up with something?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#0",
   "speaker": "Sumire",
   "en": "Yes!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_006_0_0#1",
   "speaker": "Sumire",
   "en": "But, I do have a small favor to ask,[n][fName]-senpai...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_007_0_0#0",
   "speaker": "Sumire",
   "en": "What we'll do is...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Morgana",
   "en": "I see... How interesting!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_009_0_0#0",
   "speaker": "Sumire",
   "en": "I feel like... This move would allow me[n]to honor Kasumi properly.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Sumire",
   "en": "So... how about it, [fName]-senpai?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#0",
   "speaker": null,
   "en": "Sounds like a blast.",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_011_0_0#1",
   "speaker": null,
   "en": "Let's dance.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Sumire",
   "en": "Thank you! This should make for one[n]killer routine!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_012_5_0#0",
   "speaker": "Sumire",
   "en": "Oh...!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_013_0_0#0",
   "speaker": "Morgana",
   "en": "I've definitely never seen anything like[n]what she's planning—I can't wait for this!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_014_0_0#0",
   "speaker": "Sumire",
   "en": "I won't let you down!",
   "uk": "",
   "note": ""
  }
 ]
