{
 "file": "EN/EVENT_DATA/MESSAGE/E000/E080_050.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "詩(ラヴェンツァ)",
   "en": "Thou hast fallen, thy will[n]scattered to the winds.",
   "uk": "Ти поліг, і воля твоя[n]розвіялася за вітром.",
   "note": ""
  },
  {
   "id": "MSG_000_0_0#1",
   "speaker": "詩(ラヴェンツァ)",
   "en": "Distortion hath grounded thy cause's[n]noble banner... thy conviction[n]vanished like an awoken dream.",
   "uk": "Викривлення повалило шляхетний стяг твоєї[n]справи... твоя віра зникла,[n]мов сон після пробудження.",
   "note": ""
  },
  {
   "id": "MSG_000_0_0#2",
   "speaker": "詩(ラヴェンツァ)",
   "en": "And thus, the hero meeteth[n]his end; his rebellion quelled,[n]his call to arms silenced...",
   "uk": "І так герой зустрів свій кінець;[n]бунт його придушено,[n]заклик до зброї затих...",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Lavenza",
   "en": "Is this truly it? Have they finally broken[n]your spirit of rebellion?",
   "uk": "Невже це справді все? Невже вони нарешті[n]зламали ваш бунтівний дух?",
   "note": ""
  },
  {
   "id": "SYS_002_0_0#0",
   "speaker": null,
   "en": "What do you wish to do?",
   "uk": "Що ви бажаєте зробити?",
   "note": ""
  },
  {
   "id": "SEL_003_0_0#0",
   "speaker": null,
   "en": "Return to one week prior",
   "uk": "Повернутися на тиждень назад",
   "note": ""
  },
  {
   "id": "SEL_003_0_0#1",
