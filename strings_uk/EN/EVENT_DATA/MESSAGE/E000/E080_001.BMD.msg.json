{
 "file": "EN/EVENT_DATA/MESSAGE/E000/E080_001.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "詩",
   "en": "You have fallen to the earth and your life[n]has been robbed. You didn't even learn[n]the name of your fellow thieves.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_000_0_0#1",
   "speaker": "詩",
   "en": "You who have lost at the gamble of your[n]life and waste away as a gear of the strong.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_000_0_0#2",
   "speaker": "詩",
   "en": "The rehabilitation was not fulfilled, and[n]the false dishonor has become a true[n]notoriety...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Igor",
   "en": "So, the game is over...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#1",
   "speaker": "Igor",
   "en": "What a truly foolish end...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "詩",
   "en": "You have fallen to the earth and your life[n]has been robbed. The path to[n]rehabilitation was not fulfilled either.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#1",
   "speaker": "詩",
   "en": "The false dishonor has become a true[n]notoriety. The soul of justice will be[n]recounted as a sinner's insanity.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#2",
   "speaker": "詩",
   "en": "The hero finally was unable to give his[n]victorious cry and disappears as a gear[n]of the strong...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Igor",
   "en": "So, the game is over...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#1",
   "speaker": "Igor",
   "en": "Just as success was within your reach...",
   "uk": "",
   "note": ""
  },
  {
   "id": "SYS_004_0_0#0",
   "speaker": null,
   "en": "What do you wish to do?",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_005_0_0#0",
   "speaker": null,
   "en": "Return to one week prior",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_005_0_0#1",
   "speaker": null,
   "en": "Return to the title screen",
   "uk": "",
   "note": ""
  },
  {
   "id": "SEL_006_0_0#0",
   "speaker": null,
   "en": "Restart the battle",
   "uk": "",
   "note": ""
  },
  {
