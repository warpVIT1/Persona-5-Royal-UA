{
 "file": "EN/EVENT_DATA/MESSAGE/E000/E080_003.BMD",
 "entries": [
  {
   "id": "MSG_000_0_0#0",
   "speaker": "詩",
   "en": "You have fallen to the earth and your[n]noble life has spilled away.",
   "uk": "Ти впав на землю, і твоє шляхетне[n]життя витекло.",
   "note": ""
  },
  {
   "id": "MSG_000_0_0#1",
   "speaker": "詩",
   "en": "The hero falls to his knees at the weight[n]of his justice, and the story of revolution[n]doesn't reach the populace.",
   "uk": "Герой падає на коліна під вагою своєї[n]справедливості, і повість про революцію[n]не доходить до людей.",
   "note": ""
  },
  {
   "id": "MSG_000_0_0#2",
   "speaker": "詩",
   "en": "The ember of courage that had flickered[n]to life has now been blown away by[n]murky winds...",
   "uk": "Жаринку відваги, що ледь зажевріла,[n]тепер загасили каламутні[n]вітри...",
   "note": ""
  },
  {
   "id": "MSG_001_0_0#0",
   "speaker": "Lavenza",
   "en": "This can't be! If you've fallen, the world will—",
   "uk": "Не може бути! Якщо ви впали, світ...",
   "note": ""
  },
  {
   "id": "MSG_002_0_0#0",
   "speaker": "Igor",
   "en": "I sense a great calamity drawing near...",
   "uk": "Я відчуваю, як наближається велике лихо...",
   "note": ""
  },
  {
   "id": "MSG_003_0_0#0",
   "speaker": "Lavenza",
   "en": "No...",
   "uk": "Ні...",
   "note": ""
  },
  {
   "id": "SYS_004_0_0#0",
   "speaker": null,
   "en": "What do you wish to do?",
   "uk": "Що ви бажаєте зробити?",
   "note": ""
  },
  {
   "id": "SEL_005_0_0#0",
   "speaker": null,
   "en": "Return to one week prior",
   "uk": "Повернутися на тиждень назад",
   "note": ""
  },
  {
   "id": "SEL_005_0_0#1",
   "speaker": null,
   "en": "Return to the title screen",
   "uk": "Повернутися на титульний екран",
