{
 "file": "EN/FACILITY/MSG_CHALLENGE_BATTLE_SELECT.BMD",
 "entries": [
  {
   "id": "msg_cbs_mode_help_000#0",
   "speaker": null,
   "en": "Blank[n]Blank[n]Blank",
   "uk": "Порожньо[n]Порожньо[n]Порожньо",
   "note": ""
  },
  {
   "id": "msg_cbs_mode_help_001#0",
   "speaker": null,
   "en": "An entry-level mode that tests combat[n]fundamentals, including striking weaknesses,[n]supports, and Baton Passing.",
   "uk": "Початковий режим, що перевіряє основи[n]бою: удари по слабкостях, підтримку[n]та Естафету.",
   "note": ""
  },
  {
   "id": "msg_cbs_mode_help_002#0",
   "speaker": null,
   "en": "A mode where you identify enemy[n]weaknesses and chain Baton Passes[n]to achieve a high score.",
   "uk": "Режим, де треба виявляти слабкості[n]ворогів і будувати ланцюги Естафет,[n]щоб набрати високий рахунок.",
   "note": ""
  },
  {
   "id": "msg_cbs_mode_help_003#0",
   "speaker": null,
   "en": "An advanced mode in which you aim for[n]a high score by applying status ailments[n]and scoring Technical hits.",
   "uk": "Складний режим, де високий рахунок[n]дають накладені стани[n]і Технічні удари.",
   "note": ""
  },
  {
   "id": "msg_cbs_mode_help_004#0",
   "speaker": null,
   "en": "An expert mode in which you aim for[n]a high score by surviving and enduring[n]the enemy's fierce attacks.",
   "uk": "Експертний режим, де високий рахунок[n]дає вміння вижити й витримати[n]люті атаки ворога.",
   "note": ""
  },
  {
   "id": "msg_cbs_mode_help_005#0",
   "speaker": null,
   "en": "A mode that will test masters of all[n]elements of combat, including attacking,[n]guarding, and supporting.",
   "uk": "Режим для майстрів усіх аспектів бою:[n]атаки, захисту й підтримки.",
   "note": ""
  },
  {
   "id": "msg_cbs_mode_help_006#0",
   "speaker": null,
   "en": "A special battle against the cognitive echo[n]of a certain Persona-user who fought[n]to prevent the Fall of humanity.",
   "uk": "Особливий бій із когнітивним відлунням[n]користувача Персони, який боровся,[n]щоб запобігти Падінню людства.",
   "note": ""
  },
  {
   "id": "msg_cbs_mode_help_007#0",
   "speaker": null,
   "en": "A special battle against the cognitive echo[n]of a certain Persona-user who dispelled[n]a strange, otherworldly fog.",
   "uk": "Особливий бій із когнітивним відлунням[n]користувача Персони, який розвіяв[n]дивний потойбічний туман.",
   "note": ""
  },
  {
   "id": "msg_cbs_not_open_sys_mes#0",
   "speaker": null,
   "en": "You can attempt this challenge[n]by purchasing the content on[n]the PlayStation™Store.",
   "uk": "Щоб спробувати це випробування,[n]придбайте вміст[n]у PlayStation™Store.",
   "note": ""
  },
  {
   "id": "msg_cbs_confirm_message#0",
   "speaker": "Caroline",
   "en": "You starting this battle?",
   "uk": "Починаєш цей бій?",
   "note": ""
  },
  {
   "id": "msg_cbs_confirm_message_#0",
   "speaker": "Lavenza",
   "en": "Will you start this battle?",
   "uk": "Почнете цей бій?",
   "note": ""
  },
  {
   "id": "msg_cbs_confirm_select#0",
   "speaker": null,
   "en": "Yes.",
   "uk": "Так.",
   "note": ""
  },
  {
   "id": "msg_cbs_confirm_select#1",
   "speaker": null,
   "en": "No.",
   "uk": "Ні.",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00#0",
   "speaker": "Lavenza",
   "en": "Hee-ho!",
   "uk": "Хі-хо!",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_2#0",
   "speaker": "Lavenza",
   "en": "Kill-ho!",
   "uk": "Вбий-хо!",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_3#0",
   "speaker": "Lavenza",
   "en": "...Hee!",
   "uk": "...Хі!",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_4#0",
   "speaker": "Lavenza",
   "en": "HO!",
   "uk": "ХО!",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_5#0",
   "speaker": "Lavenza",
   "en": "Brutality-ho!",
   "uk": "Жорстокість-хо!",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_6#0",
   "speaker": "Lavenza",
   "en": "ME...",
   "uk": "Я...",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_7#0",
   "speaker": "Lavenza",
   "en": "EAT...",
   "uk": "З'ЇМ...",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_8#0",
   "speaker": "Lavenza",
   "en": "...YOU WHOLE!",
   "uk": "...ТЕБЕ ЦІЛКОМ!",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_9#0",
   "speaker": "Lavenza",
   "en": "ME...",
   "uk": "Я...",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_10#0",
   "speaker": "Lavenza",
   "en": "SAME AS YOU!",
   "uk": "ТАКИЙ САМИЙ, ЯК ТИ!",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_11#0",
   "speaker": "Lavenza",
   "en": "Kill...",
   "uk": "Вбити...",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_12#0",
   "speaker": "Lavenza",
   "en": "KILL!",
   "uk": "ВБИТИ!",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_13#0",
   "speaker": "Lavenza",
   "en": "Sleepy...",
   "uk": "Спатки...",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_14#0",
   "speaker": "Lavenza",
   "en": "Hurry...",
   "uk": "Швидше...",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_15#0",
   "speaker": "Lavenza",
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_16#0",
   "speaker": "Lavenza",
   "en": "Whatever...",
   "uk": "Байдуже...",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_17#0",
   "speaker": "Lavenza",
   "en": "Will you die for me?",
   "uk": "Помреш заради мене?",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_18#0",
   "speaker": "Lavenza",
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_19#0",
   "speaker": "Lavenza",
   "en": "No room in here...",
   "uk": "Тут нема місця...",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_20#0",
   "speaker": "Lavenza",
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_21#0",
   "speaker": "Lavenza",
   "en": "Would you mind...",
   "uk": "Чи не могли б ви...",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_22#0",
   "speaker": "Lavenza",
   "en": "...dying for me!?",
   "uk": "...померти за мене!?",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_23#0",
   "speaker": "Lavenza",
   "en": "This is so...",
   "uk": "Тут так...",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_24#0",
   "speaker": "Lavenza",
   "en": "...cramped...",
   "uk": "...тісно...",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_25#0",
   "speaker": "Lavenza",
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_26#0",
   "speaker": "Lavenza",
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_27#0",
   "speaker": "Lavenza",
   "en": "Where am I...?",
   "uk": "Де я...?",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_28#0",
   "speaker": "Lavenza",
   "en": "Next full moon...",
   "uk": "Наступна повня...",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_29#0",
   "speaker": "Lavenza",
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_30#0",
   "speaker": "Lavenza",
   "en": "I don't care...",
   "uk": "Мені байдуже...",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_31#0",
   "speaker": "Lavenza",
   "en": "......",
   "uk": "......",
   "note": ""
  },
  {
   "id": "msg_cbs_devil_message_00_32#0",
