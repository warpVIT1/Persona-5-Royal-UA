 "entries": [
  {
   "id": "MSG_NML08_02_FIND_01_01#0",
   "speaker": null,
   "en": "Who is that!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_FIND_01_02#0",
   "speaker": null,
   "en": "Huh? Who are you!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_FIND_01_03#0",
   "speaker": null,
   "en": "What are you doing here?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_FIND_01_04#0",
   "speaker": null,
   "en": "Are you a fugitive!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_FIND_01_05#0",
   "speaker": null,
   "en": "Hey, you!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_PURSUE_01_0#0",
   "speaker": null,
   "en": "Wait!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_PURSUE_01_0_2#0",
   "speaker": null,
   "en": "You think you[n]can get away!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_PURSUE_01_0_3#0",
   "speaker": null,
   "en": "Do as I say!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_PURSUE_01_0_4#0",
   "speaker": null,
   "en": "You must be punished!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_PURSUE_01_0_5#0",
   "speaker": null,
   "en": "Stop right there!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_LOST_01_01#0",
   "speaker": null,
   "en": "They disappeared!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_LOST_01_02#0",
   "speaker": null,
   "en": "I guess I lost them...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_LOST_01_03#0",
   "speaker": null,
   "en": "You're quick!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_LOST_01_04#0",
   "speaker": null,
   "en": "Tch, where did they go!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_LOST_01_05#0",
   "speaker": null,
   "en": "Dammit, they got away!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_MNLG_NML_01#0",
   "speaker": null,
   "en": "All right, nothing[n]wrong here.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_MNLG_NML_01_2#0",
   "speaker": null,
   "en": "Be vigilant in your[n]surveillance.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_MNLG_NML_01_3#0",
   "speaker": null,
   "en": "Area check complete![n]All clear!",
