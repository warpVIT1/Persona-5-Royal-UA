{
 "file": "EN/FIELD/ENEMY/FEV600_000.BMD",
 "entries": [
  {
   "id": "MSG_NML08_02_FIND_01_01#0",
   "speaker": null,
   "en": "Who is that!?",
   "uk": "Хто це!?",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_FIND_01_02#0",
   "speaker": null,
   "en": "Huh? Who are you!?",
   "uk": "Га? Хто ти!?",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_FIND_01_03#0",
   "speaker": null,
   "en": "What are you doing here?",
   "uk": "Що ти тут робиш?",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_FIND_01_04#0",
   "speaker": null,
   "en": "Are you a fugitive!?",
   "uk": "Ти втікач!?",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_FIND_01_05#0",
   "speaker": null,
   "en": "Hey, you!",
   "uk": "Гей, ти!",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_PURSUE_01_0#0",
   "speaker": null,
   "en": "Wait!",
   "uk": "Стривай!",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_PURSUE_01_0_2#0",
   "speaker": null,
   "en": "You think you[n]can get away!?",
   "uk": "Думаєш, тобі[n]вдасться втекти!?",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_PURSUE_01_0_3#0",
   "speaker": null,
   "en": "Do as I say!",
   "uk": "Роби, як я кажу!",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_PURSUE_01_0_4#0",
   "speaker": null,
   "en": "You must be punished!",
   "uk": "Тебе треба покарати!",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_PURSUE_01_0_5#0",
   "speaker": null,
   "en": "Stop right there!",
   "uk": "Ані руш!",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_LOST_01_01#0",
   "speaker": null,
   "en": "They disappeared!?",
   "uk": "Вони зникли!?",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_LOST_01_02#0",
   "speaker": null,
   "en": "I guess I lost them...",
   "uk": "Схоже, я їх загубив...",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_LOST_01_03#0",
   "speaker": null,
   "en": "You're quick!",
   "uk": "А ти швидкий!",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_LOST_01_04#0",
   "speaker": null,
   "en": "Tch, where did they go!?",
   "uk": "Тц, куди вони поділися!?",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_LOST_01_05#0",
   "speaker": null,
   "en": "Dammit, they got away!",
   "uk": "Чорт, вони втекли!",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_MNLG_NML_01#0",
   "speaker": null,
   "en": "All right, nothing[n]wrong here.",
   "uk": "Гаразд, тут[n]усе добре.",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_MNLG_NML_01_2#0",
   "speaker": null,
   "en": "Be vigilant in your[n]surveillance.",
   "uk": "Будьте пильні[n]під час нагляду.",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_MNLG_NML_01_3#0",
   "speaker": null,
   "en": "Area check complete![n]All clear!",
   "uk": "Перевірку зони завершено![n]Усе чисто!",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_MNLG_NML_01_4#0",
   "speaker": null,
   "en": "No one's stepping[n]out of line, are they?",
   "uk": "Ніхто ж не порушує[n]порядку, правда?",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_MNLG_NML_01_5#0",
   "speaker": null,
   "en": "What was that sound? Must[n]have been my imagination...",
   "uk": "Що це за звук? Мабуть,[n]здалося...",
   "note": ""
  },
  {
   "id": "MSG_NML08_02_MNLG_NML_01_6#0",
   "speaker": null,
   "en": "......",
   "uk": "......",
   "note": ""
