{
 "file": "EN/FIELD/ENEMY/FEV590_001.BMD",
 "entries": [
  {
   "id": "MSG_NML07_FIND_01_01#0",
   "speaker": null,
   "en": "Intruders detected.",
   "uk": "Виявлено порушників.",
   "note": ""
  },
  {
   "id": "MSG_NML07_FIND_01_02#0",
   "speaker": null,
   "en": "Intruders detected.[n]Eliminating.",
   "uk": "Виявлено порушників.[n]Ліквідую.",
   "note": ""
  },
  {
   "id": "MSG_NML07_FIND_01_03#0",
   "speaker": null,
   "en": "Intruders confirmed.[n]Will eliminate.",
   "uk": "Порушників підтверджено.[n]Ліквідую.",
   "note": ""
  },
  {
   "id": "MSG_NML07_FIND_01_04#0",
   "speaker": null,
   "en": "Confirmed.[n]Eliminating.",
   "uk": "Підтверджено.[n]Ліквідую.",
   "note": ""
  },
  {
   "id": "MSG_NML07_FIND_01_05#0",
   "speaker": null,
   "en": "Suspicious persons[n]confirmed. Beginning[n]the operation.",
   "uk": "Підозрілих осіб[n]підтверджено. Починаю[n]операцію.",
   "note": ""
  },
  {
   "id": "MSG_NML07_PURSUE_01_01#0",
   "speaker": null,
   "en": "Pursuing the target.",
   "uk": "Переслідую ціль.",
   "note": ""
  },
  {
   "id": "MSG_NML07_PURSUE_01_02#0",
   "speaker": null,
   "en": "Pursuing the target.[n]They're pretty fast.",
   "uk": "Переслідую ціль.[n]Вони доволі швидкі.",
   "note": ""
  },
  {
   "id": "MSG_NML07_PURSUE_01_03#0",
   "speaker": null,
   "en": "I'm in pursuit.[n]I won't let them escape.",
   "uk": "Переслідую.[n]Не дам їм утекти.",
   "note": ""
  },
  {
   "id": "MSG_NML07_PURSUE_01_04#0",
   "speaker": null,
   "en": "Capturing the target.",
   "uk": "Захоплюю ціль.",
   "note": ""
  },
  {
   "id": "MSG_NML07_PURSUE_01_05#0",
   "speaker": null,
   "en": "Stop.",
   "uk": "Стій.",
   "note": ""
  },
  {
   "id": "MSG_NML07_LOST_01_01#0",
   "speaker": null,
   "en": "I lost them.",
   "uk": "Я їх загубив.",
   "note": ""
  },
  {
   "id": "MSG_NML07_LOST_01_02#0",
   "speaker": null,
   "en": "I guess they escaped.",
   "uk": "Схоже, вони втекли.",
   "note": ""
  },
  {
   "id": "MSG_NML07_LOST_01_03#0",
   "speaker": null,
   "en": "I lost sight of them.",
   "uk": "Я втратив їх з поля зору.",
   "note": ""
  },
  {
   "id": "MSG_NML07_LOST_01_04#0",
   "speaker": null,
   "en": "I lost them, but I won't[n]let them escape again.",
   "uk": "Я їх загубив, але більше[n]не дам їм утекти.",
   "note": ""
  },
  {
   "id": "MSG_NML07_LOST_01_05#0",
   "speaker": null,
   "en": "Tch... I lost them.",
   "uk": "Тц... Я їх загубив.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_NML_01_01#0",
   "speaker": null,
   "en": "Nothing to report.",
   "uk": "Доповідати нічого.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_NML_01_02#0",
   "speaker": null,
   "en": "No problems on my end.",
   "uk": "У мене проблем немає.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_NML_01_03#0",
   "speaker": null,
   "en": "Nothing wrong with that.",
   "uk": "Із цим усе гаразд.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_NML_01_04#0",
   "speaker": null,
   "en": "Area clear.",
   "uk": "Зона чиста.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_NML_01_05#0",
   "speaker": null,
   "en": "The area's clear.[n]Moving to the next one.",
   "uk": "Зона чиста.[n]Переходжу до наступної.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_NML_01_06#0",
   "speaker": null,
   "en": "I should be patient.[n]Haste will lead to[n]carelessness.",
   "uk": "Треба бути терплячим.[n]Поспіх призводить[n]до необачності.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_NML_01_07#0",
   "speaker": null,
   "en": "Why do these pieces of[n]trash keep coming in,[n]one after another?",
   "uk": "Чому ці покидьки[n]лізуть сюди один[n]за одним?",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_NML_01_08#0",
   "speaker": null,
   "en": "I'll worry about their[n]identities after I've[n]dealt with them.",
   "uk": "Про те, хто вони, я подумаю,[n]коли з ними[n]розберуся.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_NML_01_09#0",
   "speaker": null,
   "en": "I smell it...[n]The stench of scum.",
   "uk": "Я чую його...[n]Сморід покидьків.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_NML_01_10#0",
   "speaker": null,
   "en": "I have a bad feeling[n]about this... I'll have[n]to brace myself.",
   "uk": "У мене погане передчуття...[n]Треба приготуватися.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_ALT_01_01#0",
   "speaker": null,
   "en": "I don't see any intruders.[n]I'll look elsewhere.",
   "uk": "Порушників не бачу.[n]Пошукаю деінде.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_ALT_01_02#0",
   "speaker": null,
   "en": "Nothing out of the[n]ordinary. I don't[n]see intruders.",
   "uk": "Нічого незвичного.[n]Порушників[n]не бачу.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_ALT_01_03#0",
   "speaker": null,
   "en": "I can't confirm the intruder's location.",
   "uk": "Не можу встановити, де порушник.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_ALT_01_04#0",
   "speaker": null,
   "en": "The intruders haven't[n]been found.",
   "uk": "Порушників не[n]знайдено.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_ALT_01_05#0",
   "speaker": null,
   "en": "Tch! Where is he hiding!?",
   "uk": "Тц! Де він ховається!?",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_ALT_01_06#0",
   "speaker": null,
   "en": "Preparations are good.[n]I'll crush them like[n]insects.",
   "uk": "Підготовка добра.[n]Розчавлю їх, як[n]комах.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_ALT_01_07#0",
   "speaker": null,
   "en": "That shadowy area[n]is suspicious...Very suspicious...",
   "uk": "Те темне місце[n]підозріле... Дуже підозріле...",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_ALT_01_08#0",
   "speaker": null,
   "en": "The target is mine.[n]I won't let anyone[n]interfere.",
   "uk": "Ціль моя.[n]Я нікому не дам[n]утрутитися.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_ALT_01_09#0",
   "speaker": null,
   "en": "I'm living life on the[n]edge! That's what this[n]feels like!",
   "uk": "Я живу на межі![n]Ось яке в мене[n]відчуття!",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_ALT_01_10#0",
   "speaker": null,
   "en": "I won't go easy on those[n]who have a death wish...",
   "uk": "Я не жалітиму тих,[n]хто шукає смерті...",
   "note": ""
  },
  {
   "id": "MSG_NML07_REPORT_01_01#0",
   "speaker": null,
   "en": "Target sighted.[n]I'll report this to[n]headquarters immediately.",
   "uk": "Ціль помічено.[n]Негайно доповім[n]у штаб.",
   "note": ""
  },
  {
   "id": "MSG_NML07_REPORT_01_02#0",
   "speaker": null,
   "en": "I've spotted the target.[n]I'll go make a report and[n]request tightened security.",
   "uk": "Я помітив ціль.[n]Піду доповім і попрошу[n]посилити охорону.",
   "note": ""
  },
  {
   "id": "MSG_NML07_REPORT_01_03#0",
   "speaker": null,
   "en": "I'll return to[n]headquarters for now.",
   "uk": "Поки що повернуся[n]до штабу.",
   "note": ""
  },
  {
   "id": "MSG_NML07_REPORT_01_04#0",
   "speaker": null,
   "en": "Awaiting orders from HQ.[n]Returning temporarily.",
   "uk": "Чекаю наказів зі штабу.[n]Тимчасово повертаюся.",
   "note": ""
  },
  {
   "id": "MSG_NML07_REPORT_01_05#0",
   "speaker": null,
   "en": "Reporting to headquarters[n]information on the target.",
   "uk": "Доповідаю штабу[n]відомості про ціль.",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_GUARD_01_#0",
   "speaker": null,
   "en": "Nothing out of the[n]ordinary in the[n]guarded zone.",
   "uk": "У зоні охорони[n]нічого[n]незвичного.",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_GUARD_01__2#0",
   "speaker": null,
   "en": "No issues with[n]the defense.",
   "uk": "Із захистом[n]усе гаразд.",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_GUARD_01__3#0",
   "speaker": null,
   "en": "No problems around[n]the protected area.",
   "uk": "Довкола зони охорони[n]проблем немає.",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_GUARD_01__4#0",
   "speaker": null,
   "en": "I don't see anything[n]out of the ordinary.[n]Remaining on guard.",
   "uk": "Нічого незвичного[n]не бачу.[n]Лишаюся на варті.",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_GUARD_01__5#0",
   "speaker": null,
   "en": "Nothing to report.[n]Resuming guard duty.",
   "uk": "Доповідати нічого.[n]Повертаюся до варти.",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_DEFEND_01#0",
   "speaker": null,
   "en": "Captain. I've discovered[n]an intruder.",
   "uk": "Капітане. Я виявив[n]порушника.",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_DEFEND_01_2#0",
   "speaker": null,
   "en": "Reporting in, Captain.[n]Intruders detected.",
   "uk": "Доповідаю, капітане.[n]Виявлено порушників.",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_DEFEND_01_3#0",
   "speaker": null,
   "en": "I have a report, Captain:[n]Intruders sighted.",
   "uk": "Маю доповідь, капітане:[n]помічено порушників.",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_DEFEND_01_4#0",
   "speaker": null,
   "en": "I've spotted intruders.[n]Please be cautious,[n]Captain.",
   "uk": "Я помітив порушників.[n]Будьте обережні,[n]капітане.",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_DEFEND_01_5#0",
   "speaker": null,
   "en": "There are intruders,[n]Captain.",
   "uk": "Тут порушники,[n]капітане.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_0#0",
   "speaker": null,
   "en": "Urgh... Ugh... Phew.[n]My shoulders are stiff.",
   "uk": "Ух... Ох... Фух.[n]Плечі задерев'яніли.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_0_2#0",
   "speaker": null,
   "en": "I want to get off soon[n]so I can drink.",
   "uk": "Хочу швидше відбути зміну,[n]щоб випити.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_0_3#0",
   "speaker": null,
   "en": "Why do these pieces of[n]trash keep coming in,[n]one after another?",
   "uk": "Чому ці покидьки[n]лізуть сюди один[n]за одним?",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_0_4#0",
   "speaker": null,
   "en": "I won't go easy on those[n]who have a death wish...",
   "uk": "Я не жалітиму тих,[n]хто шукає смерті...",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_0_5#0",
   "speaker": null,
   "en": "I want to fight soon...[n]It'll be my first[n]real combat...",
   "uk": "Хочу швидше в бій...[n]Це буде мій перший[n]справжній бій...",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_0_6#0",
   "speaker": null,
   "en": "I hope these intruders[n]have some stamina. I don't[n]want them to die too fast.",
   "uk": "Хоч би ці порушники були[n]витривалими. Не хочу,[n]щоб вони швидко померли.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_0_7#0",
   "speaker": null,
   "en": "Good... I love[n]this tension!",
   "uk": "Добре... Обожнюю[n]цю напругу!",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_0_8#0",
   "speaker": null,
   "en": "I'll worry about their[n]identities after I've[n]dealt with them.",
   "uk": "Про те, хто вони, я подумаю,[n]коли з ними[n]розберуся.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_0_9#0",
   "speaker": null,
   "en": "Preparations are good.[n]I'll crush them like[n]insects.",
   "uk": "Підготовка добра.[n]Розчавлю їх, як[n]комах.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_1#0",
   "speaker": null,
   "en": "That shadowy area[n]is suspicious...Very suspicious...",
   "uk": "Те темне місце[n]підозріле... Дуже підозріле...",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_1_2#0",
   "speaker": null,
   "en": "Hey, General![n]You're there, aren't you?",
   "uk": "Гей, генерале![n]Ви ж там, правда?",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_1_3#0",
   "speaker": null,
   "en": "The target is mine.[n]I won't let anyone[n]interfere.",
   "uk": "Ціль моя.[n]Я нікому не дам[n]утрутитися.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_1_4#0",
   "speaker": null,
   "en": "I'm living life on the[n]edge! That's what this[n]feels like!",
   "uk": "Я живу на межі![n]Ось яке в мене[n]відчуття!",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_1_5#0",
   "speaker": null,
   "en": "I have a bad feeling[n]about this... I'll have[n]to brace myself.",
   "uk": "У мене погане передчуття...[n]Треба приготуватися.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_1_6#0",
   "speaker": null,
   "en": "I smell it...[n]The stench of scum.",
   "uk": "Я чую його...[n]Сморід покидьків.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_1_7#0",
   "speaker": null,
   "en": "They want me to wait[n]for a sign? No way.[n]I can't control myself.",
   "uk": "Хочуть, щоб я чекав[n]сигналу? Нізащо.[n]Я не можу стриматися.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_1_8#0",
   "speaker": null,
   "en": "After this job, I'll drink[n]so much I might as well[n]be bathing in alcohol.",
   "uk": "Після цієї роботи я так[n]нап'юся, що наче[n]викупаюся в алкоголі.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_1_9#0",
   "speaker": null,
   "en": "Those scum are in the[n]wrong. They'll only learn[n]this fact in the afterlife.",
   "uk": "Ці покидьки неправі.[n]Але збагнуть вони це[n]лише на тому світі.",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_1_10#0",
   "speaker": null,
   "en": "I guess I'll play with[n]them a little, but I can't[n]promise they'll live...",
   "uk": "Мабуть, трохи з ними[n]пограюся, але не обіцяю,[n]що вони виживуть...",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_FREE_01_2#0",
   "speaker": null,
   "en": "I should be patient.[n]Haste will lead to[n]carelessness.",
   "uk": "Треба бути терплячим.[n]Поспіх призводить[n]до необачності.",
   "note": ""
  },
  {
   "id": "MSG_NML07_FIND_02_01#0",
   "speaker": null,
   "en": "Woof![n]Woof woof!",
   "uk": "Гав![n]Гав-гав!",
   "note": ""
  },
  {
   "id": "MSG_NML07_FIND_02_02#0",
   "speaker": null,
   "en": "Awoooooo!",
   "uk": "Ау-у-у-у-у!",
   "note": ""
  },
  {
   "id": "MSG_NML07_FIND_02_03#0",
   "speaker": null,
   "en": "Woof woof woof!",
   "uk": "Гав-гав-гав!",
   "note": ""
  },
  {
   "id": "MSG_NML07_PURSUE_02_01#0",
   "speaker": null,
   "en": "Woof![n]Woof woof!",
   "uk": "Гав![n]Гав-гав!",
   "note": ""
  },
  {
   "id": "MSG_NML07_PURSUE_02_02#0",
   "speaker": null,
   "en": "Grrrrrr...",
   "uk": "Р-р-р-р-р...",
   "note": ""
  },
  {
   "id": "MSG_NML07_PURSUE_02_03#0",
   "speaker": null,
   "en": "Woof![n]Grrr... Woof!",
   "uk": "Гав![n]Р-р-р... Гав!",
   "note": ""
  },
  {
   "id": "MSG_NML07_LOST_02_01#0",
   "speaker": null,
   "en": "Woof! Woof!",
   "uk": "Гав! Гав!",
   "note": ""
  },
  {
   "id": "MSG_NML07_LOST_02_02#0",
   "speaker": null,
   "en": "Arf!",
   "uk": "Тяв!",
   "note": ""
  },
  {
   "id": "MSG_NML07_LOST_02_03#0",
   "speaker": null,
   "en": "Grrrrr...",
   "uk": "Р-р-р-р...",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_NML_02_01#0",
   "speaker": null,
   "en": "*sniff* *sniff*",
   "uk": "*нюх* *нюх*",
   "note": ""
  },
  {
   "id": "MSG_NML07_MNLG_NML_02_02#0",
   "speaker": null,
   "en": "*pant* *pant* *pant*",
   "uk": "*дихає* *дихає* *дихає*",
   "note": ""
  },
