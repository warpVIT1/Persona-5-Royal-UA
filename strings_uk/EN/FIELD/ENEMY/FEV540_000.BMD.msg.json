  {
   "id": "MSG_NML03_FIND_01_01#0",
   "speaker": null,
   "en": "Who is that!? There's[n]someone nearby!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_FIND_01_02#0",
   "speaker": null,
   "en": "There! I just saw[n]something there!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_FIND_01_03#0",
   "speaker": null,
   "en": "What!? Who's there!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_FIND_01_04#0",
   "speaker": null,
   "en": "Who is that!? There's[n]someone nearby!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_FIND_01_05#0",
   "speaker": null,
   "en": "Huh!? There was...[n]someone there just[n]now, wasn't there?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_PURSUE_01_01#0",
   "speaker": null,
   "en": "Halt! How did you get in!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_PURSUE_01_02#0",
   "speaker": null,
   "en": "I won't let you escape,[n]you thieves!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_PURSUE_01_03#0",
   "speaker": null,
   "en": "Halt! I won't let you go!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_PURSUE_01_04#0",
   "speaker": null,
   "en": "You! Don't think you[n]can get away!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_PURSUE_01_05#0",
   "speaker": null,
   "en": "I won't let you go![n]Everyone, intruders![n]Surround them!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_LOST_01_01#0",
   "speaker": null,
   "en": "I've lost them... Where did[n]you hide? Show yourselves!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_LOST_01_02#0",
   "speaker": null,
   "en": "Dammit! I lost them...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_LOST_01_03#0",
   "speaker": null,
   "en": "They're quick...[n]Where did they go?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_LOST_01_04#0",
   "speaker": null,
   "en": "They should still be in[n]the area! I'll find you...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_LOST_01_05#0",
   "speaker": null,
   "en": "They disappeared!?[n]Are they magicians!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_NML_01_01#0",
   "speaker": null,
   "en": "As long as I'm here,[n]no intruder will ever[n]get past me...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_NML_01_02#0",
   "speaker": null,
   "en": "\"If you wish to pass,[n]you'll have to defeat ME!\"[n]Okay, good practice.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_NML_01_03#0",
   "speaker": null,
   "en": "I'll never let anyone[n]through here... Never...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_NML_01_04#0",
   "speaker": null,
   "en": "No intruder could have[n]made it this far in...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_NML_01_05#0",
   "speaker": null,
   "en": "I can't let anyone[n]through here...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_NML_01_06#0",
   "speaker": null,
   "en": "I wanna punch someone...[n]I don't care who.[n]Thieves, kids, anybody...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_NML_01_07#0",
   "speaker": null,
   "en": "Ahhh, I love the scent[n]of cash... I could smell[n]those fat stacks forever.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_NML_01_08#0",
   "speaker": null,
   "en": "Ahaha, Mr. Kaneshiro's such[n]a worrywart! Can't blame[n]him, with that kinda money...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_NML_01_09#0",
   "speaker": null,
   "en": "Come on over, idiots.[n]Come this way... I'll[n]bash your skulls in!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_NML_01_10#0",
   "speaker": null,
   "en": "Cash flow is great today,[n]as usual. Mr. Kaneshiro's[n]on a roll! Ahaha!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_ALT_01_01#0",
   "speaker": null,
   "en": "I won't let you go... I'll find[n]you, no matter what...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_ALT_01_02#0",
   "speaker": null,
   "en": "Where did you hide?[n]I won't let you go...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_ALT_01_03#0",
   "speaker": null,
   "en": "Unlike those other[n]blockheads, I won't[n]let anyone get away...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_ALT_01_04#0",
   "speaker": null,
   "en": "I'll find them, and[n]I'll capture them!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_ALT_01_05#0",
   "speaker": null,
   "en": "Are they around here?[n]They're not, are they?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_ALT_01_06#0",
   "speaker": null,
   "en": "Is anyone there?[n]Come get me!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_ALT_01_07#0",
   "speaker": null,
   "en": "Nothing going on here.[n]But maybe I should[n]double-check...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_ALT_01_08#0",
   "speaker": null,
   "en": "Nobody here![n]Nobody there, either!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_ALT_01_09#0",
   "speaker": null,
   "en": "If the intruders show up...[n]I'll kill 'em with my friends![n]Ahaha!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_MNLG_ALT_01_10#0",
   "speaker": null,
   "en": "Heyyy! Come on out![n]I won't do anything to you...[n]Ahaha!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_REPORT_01_01#0",
   "speaker": null,
   "en": "I must tell the[n]bank president!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_REPORT_01_02#0",
   "speaker": null,
   "en": "I must report this to the bank[n]president to tighten security.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_REPORT_01_03#0",
   "speaker": null,
   "en": "We must report this to the[n]bank president at once!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_REPORT_01_04#0",
   "speaker": null,
   "en": "I must ask the bank[n]president to raise security!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML03_REPORT_01_05#0",
   "speaker": null,
   "en": "Just you watch... I'll get[n]security tightened for you!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_GUARD_01_#0",
   "speaker": null,
   "en": "I won't give this up,[n]no matter what.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_GUARD_01__2#0",
   "speaker": null,
   "en": "If I don't protect this,[n]Mr Kaneshiro will kill me...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_GUARD_01__3#0",
   "speaker": null,
   "en": "This was entrusted to me.[n]I will protect it no matter what.",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_GUARD_01__4#0",
   "speaker": null,
   "en": "Please, no one come[n]by right now!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_GUARD_01__5#0",
   "speaker": null,
   "en": "It'd be bad if this got taken...[n]I must work hard to defend it...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_DEFEND_01#0",
   "speaker": null,
   "en": "Mr. Kaneshiro![n]There's an intruder!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_DEFEND_01_2#0",
   "speaker": null,
   "en": "Reporting in![n]Intruders found!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_DEFEND_01_3#0",
   "speaker": null,
   "en": "Intruders! Mr. Kaneshiro,[n]please be on the lookout!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_DEFEND_01_4#0",
   "speaker": null,
   "en": "I-Intruders! Mr. Kaneshiro![n]I've found intruders!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_STG01_MNLG_DEFEND_01_5#0",
   "speaker": null,
   "en": "Intruders detected![n]Intruders detected!",
   "uk": "",
   "note": ""
  },
