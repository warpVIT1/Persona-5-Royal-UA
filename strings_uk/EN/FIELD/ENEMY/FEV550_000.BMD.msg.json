  {
   "id": "MSG_NML04_MNLG_ALT_01_02#0",
   "speaker": null,
   "en": "Theft... Not good...[n]Must find... Capture...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_ALT_01_03#0",
   "speaker": null,
   "en": "Hrrrgh... Where are you?[n]Come out...!",
   "uk": "",
   "note": ""
