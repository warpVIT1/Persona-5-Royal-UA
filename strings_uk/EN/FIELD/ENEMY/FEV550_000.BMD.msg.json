  {
   "id": "MSG_NML04_FIND_01_01#0",
   "speaker": null,
   "en": "Wh-Who goes there...!?",
   "uk": "Х-хто тут...!?",
   "note": ""
  },
  {
   "id": "MSG_NML04_FIND_01_02#0",
   "speaker": null,
   "en": "Who are you...!?",
   "uk": "Хто ти...!?",
   "note": ""
  },
  {
   "id": "MSG_NML04_FIND_01_03#0",
   "speaker": null,
   "en": "Wh-Who is it...!?",
   "uk": "Х-хто це...!?",
   "note": ""
  },
  {
   "id": "MSG_NML04_FIND_01_04#0",
   "speaker": null,
   "en": "Th-Thieves...!?",
   "uk": "З-злодії...!?",
   "note": ""
  },
  {
   "id": "MSG_NML04_FIND_01_05#0",
   "speaker": null,
   "en": "Found strangers...!",
   "uk": "Чужинці...!",
   "note": ""
  },
  {
   "id": "MSG_NML04_PURSUE_01_01#0",
   "speaker": null,
   "en": "Halt! Halt![n]You cannot escape...!",
   "uk": "Стій! Стій![n]Тобі не втекти...!",
   "note": ""
  },
  {
   "id": "MSG_NML04_PURSUE_01_02#0",
   "speaker": null,
   "en": "H-Halt![n]Thief...!",
   "uk": "С-стій![n]Злодій...!",
   "note": ""
  },
  {
   "id": "MSG_NML04_PURSUE_01_03#0",
   "speaker": null,
   "en": "Hrrrgh... Do not run...!",
   "uk": "Гр-р-р... Не тікай...!",
   "note": ""
  },
  {
   "id": "MSG_NML04_PURSUE_01_04#0",
   "speaker": null,
   "en": "You cannot escape...!",
   "uk": "Тобі не втекти...!",
   "note": ""
  },
  {
   "id": "MSG_NML04_PURSUE_01_05#0",
   "speaker": null,
   "en": "Grave robbers...[n]Go away...!",
   "uk": "Грабіжники могил...[n]Геть...!",
   "note": ""
  },
  {
   "id": "MSG_NML04_LOST_01_01#0",
   "speaker": null,
   "en": "Hrrrgh...[n]Not here...?",
   "uk": "Гр-р-р...[n]Немає...?",
   "note": ""
  },
  {
   "id": "MSG_NML04_LOST_01_02#0",
   "speaker": null,
   "en": "Hrrrm...[n]Gone... Where...?",
   "uk": "Гм-м-м...[n]Зникли... Де...?",
   "note": ""
  },
  {
   "id": "MSG_NML04_LOST_01_03#0",
   "speaker": null,
   "en": "Hrrrgh...[n]Gone...",
   "uk": "Гр-р-р...[n]Зникли...",
   "note": ""
  },
  {
   "id": "MSG_NML04_LOST_01_04#0",
   "speaker": null,
   "en": "Ehhh...?[n]Where... Where...?",
   "uk": "Е-е-е...?[n]Де... Де...?",
   "note": ""
  },
  {
   "id": "MSG_NML04_LOST_01_05#0",
   "speaker": null,
   "en": "Gone...[n]Scary...",
   "uk": "Зникли...[n]Страшно...",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_NML_01_01#0",
   "speaker": null,
   "en": "Hrrrgh...[n]No one may pass...[n]No one...",
   "uk": "Гр-р-р...[n]Ніхто не пройде...[n]Ніхто...",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_NML_01_02#0",
   "speaker": null,
   "en": "I stand guard...[n]I stand here...",
   "uk": "Я стережу...[n]Я стою тут...",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_NML_01_03#0",
   "speaker": null,
   "en": "No one may pass...[n]Never allowed...",
   "uk": "Ніхто не пройде...[n]Ніколи не можна...",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_NML_01_04#0",
   "speaker": null,
   "en": "No one may pass...[n]I... protect...",
   "uk": "Ніхто не пройде...[n]Я... захищаю...",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_NML_01_05#0",
   "speaker": null,
   "en": "If someone passes...[n]I get in trouble.[n]Must protect...",
   "uk": "Якщо хтось пройде...[n]мені влетить.[n]Треба захищати...",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_NML_01_06#0",
   "speaker": null,
   "en": "Don't want...[n]annoying people...[n]Trash...",
   "uk": "Не хочу...[n]набридливих людей...[n]Мотлох...",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_NML_01_07#0",
   "speaker": null,
   "en": "Electricity... important...[n]Life of machines...",
   "uk": "Електрика... важлива...[n]Життя машин...",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_NML_01_08#0",
   "speaker": null,
   "en": "Cold... Red... It's all over...![n]This is the end...!",
   "uk": "Холодно... Червоне... Усьому кінець...![n]Це кінець...!",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_NML_01_09#0",
   "speaker": null,
   "en": "Don't want... bad[n]guys... Right...?",
   "uk": "Не хочу... поганих[n]людей... Так...?",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_NML_01_10#0",
   "speaker": null,
   "en": "I told you so...[n]Why didn't you listen...?[n]Awful child...",
   "uk": "Я ж казала...[n]Чому ти не слухала...?[n]Жахлива дитина...",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_ALT_01_01#0",
   "speaker": null,
   "en": "Danger... They're here...[n]Must find, no matter what...",
   "uk": "Небезпека... Вони тут...[n]Треба знайти, хай там що...",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_ALT_01_02#0",
   "speaker": null,
   "en": "Theft... Not good...[n]Must find... Capture...",
   "uk": "Крадіжка... Погано...[n]Знайти... Схопити...",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_ALT_01_03#0",
   "speaker": null,
   "en": "Hrrrgh... Where are you?[n]Come out...!",
   "uk": "Гр-р-р... Де ти?[n]Виходь...!",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_ALT_01_04#0",
   "speaker": null,
   "en": "Grave robbers... Bad guys...[n]Must find... Defeat...",
   "uk": "Грабіжники могил... Погані...[n]Знайти... Здолати...",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_ALT_01_05#0",
   "speaker": null,
   "en": "No use... hiding...[n]Come out, come out...",
   "uk": "Ховатися... марно...[n]Виходь, виходь...",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_ALT_01_06#0",
   "speaker": null,
   "en": "No one's coming...[n]I don't need anyone...!",
   "uk": "Ніхто не прийде...[n]Мені ніхто не потрібен...!",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_ALT_01_07#0",
   "speaker": null,
   "en": "Yes... I reset.[n]I'll have to...!",
   "uk": "Так... я перезавантажуюсь.[n]Доведеться...!",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_ALT_01_08#0",
   "speaker": null,
   "en": "Everything is trash...[n]Everything...!",
   "uk": "Усе — мотлох...[n]Усе...!",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_ALT_01_09#0",
   "speaker": null,
   "en": "Dizzy... Dizzy...[n]Falling down...",
   "uk": "Паморочиться... Паморочиться...[n]Падаю...",
   "note": ""
  },
  {
   "id": "MSG_NML04_MNLG_ALT_01_10#0",
   "speaker": null,
   "en": "So many of them...[n]I will play[n]with you all...",
   "uk": "Як вас багато...[n]Я пограюся[n]з усіма вами...",
   "note": ""
