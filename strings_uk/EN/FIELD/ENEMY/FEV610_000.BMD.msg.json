  {
   "id": "MSG_NML08_01_FIND_01_01#0",
   "speaker": null,
   "en": "Who is that!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_01_FIND_01_02#0",
   "speaker": null,
   "en": "Huh? Who are you!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_01_FIND_01_03#0",
   "speaker": null,
   "en": "What are you[n]doing here?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_01_FIND_01_04#0",
   "speaker": null,
   "en": "Are you a fugitive!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_01_FIND_01_05#0",
   "speaker": null,
   "en": "Hey, you!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_01_PURSUE_01_0#0",
   "speaker": null,
   "en": "Wait!",
   "uk": "Стривай!",
   "note": ""
  },
  {
   "id": "MSG_NML08_01_PURSUE_01_0_2#0",
   "speaker": null,
   "en": "You think you[n]can get away!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_01_PURSUE_01_0_3#0",
   "speaker": null,
   "en": "Do as I say!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_01_PURSUE_01_0_4#0",
   "speaker": null,
   "en": "You must be punished!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_01_PURSUE_01_0_5#0",
   "speaker": null,
   "en": "Stop right there!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_01_LOST_01_01#0",
   "speaker": null,
   "en": "They disappeared!?",
   "uk": "Вони зникли!?",
   "note": ""
  },
  {
   "id": "MSG_NML08_01_LOST_01_02#0",
   "speaker": null,
   "en": "I guess I[n]lost them...",
   "uk": "Схоже, я їх[n]загубив...",
   "note": ""
  },
  {
   "id": "MSG_NML08_01_LOST_01_03#0",
   "speaker": null,
   "en": "You're quick!",
   "uk": "А ти швидкий!",
   "note": ""
  },
  {
   "id": "MSG_NML08_01_LOST_01_04#0",
   "speaker": null,
   "en": "Where did they go!?",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_01_LOST_01_05#0",
   "speaker": null,
   "en": "Dammit! They got away!",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_NML08_01_MNLG_NML_01#0",
   "speaker": null,
   "en": "All right, nothing[n]wrong here.",
