  {
   "id": "CAMERA_ROOM_NPC_GREETING#0",
   "speaker": null,
   "en": "Anything strange?[n]Keep an eye out!",
   "uk": "Щось підозріле?[n]Пильнуйте!",
   "note": ""
  },
  {
   "id": "CAMERA_ROOM_NPC_GREETING_2#0",
   "speaker": null,
   "en": "Are there any suspicious guests?",
   "uk": "Є підозрілі гості?",
   "note": ""
  },
  {
   "id": "CAMERA_ROOM_NPC_GREETING_3#0",
   "speaker": null,
   "en": "Toss any guests with bad manners!",
   "uk": "Виставляйте невихованих гостей!",
   "note": ""
  },
  {
   "id": "CAMERA_ROOM_NPC_GREETING_4#0",
   "speaker": null,
   "en": "The house ALWAYS wins!",
   "uk": "Казино ЗАВЖДИ виграє!",
   "note": ""
  },
  {
   "id": "CAMERA_ROOM_NPC_GREETING_5#0",
   "speaker": null,
   "en": "Stay frosty!",
   "uk": "Не розслаблятися!",
   "note": ""
  },
  {
   "id": "D157_NPC_TALK_mes01#0",
   "speaker": "Security Guard",
   "en": "Hey, guests aren't allowed back here.[n]Get lost!",
   "uk": "Гей, гостям сюди не можна.[n]Забирайтеся!",
   "note": ""
  },
  {
   "id": "D157_NPC_TALK_mes02#0",
   "speaker": "Security Guard",
   "en": "That manager sure is something else,[n]giving you so many chances.",
   "uk": "Той менеджер — щось із чимось,[n]стільки шансів вам дає.",
   "note": ""
  },
  {
   "id": "D157_NPC_TALK_mes03#0",
   "speaker": "Security Guard",
   "en": "Figure something out if you don't have[n]enough coins. Did you forget what the[n]manager said?",
   "uk": "Як не вистачає жетонів — придумайте[n]щось. Ви що, забули, що казав[n]менеджер?",
