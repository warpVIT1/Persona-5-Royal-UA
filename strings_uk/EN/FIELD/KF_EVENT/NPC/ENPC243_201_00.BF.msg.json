   "speaker": "Iida",
   "en": "P-Please don't ask him...",
   "uk": "",
   "note": ""
  },
  {
   "id": "MSG_E24320100_IIDA_103_0#0",
   "speaker": "Morgana",
   "en": "Let's go try and get some information[n]from this Nishiyama.",
   "uk": "",
   "note": ""
