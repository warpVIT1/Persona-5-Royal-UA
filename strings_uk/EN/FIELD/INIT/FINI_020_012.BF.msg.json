 "file": "EN/FIELD/INIT/FINI_020_012.BF",
 "entries": [
  {
   "id": "MSG_000_1ST_0_0#0",
   "speaker": "Morgana",
   "en": "It's kind of calming to see such an[n]imposing building...",
   "uk": "Якось аж заспокоює вигляд такої[n]величної споруди...",
   "note": ""
  },
  {
   "id": "MSG_Jingu2nd#0",
   "speaker": "Morgana",
   "en": "Mm, this place is as calming as it always is.",
   "uk": "М-м, тут, як завжди, спокійно.",
   "note": ""
  },
  {
   "id": "MSG_008_0_0#0",
   "speaker": "Morgana",
   "en": "Are you going to pray for something?",
   "uk": "Помолишся про щось?",
   "note": ""
  },
  {
   "id": "MSG_JINGU_THINK_SEL#0",
   "speaker": null,
   "en": "Let's pray for strong bonds.",
   "uk": "Помолімося про міцні зв'язки.",
   "note": ""
  },
  {
   "id": "MSG_JINGU_THINK_SEL#1",
   "speaker": null,
   "en": "Actually, let's go home.",
   "uk": "Взагалі-то, ходімо додому.",
   "note": ""
  },
  {
   "id": "MSG_011_0_0#0",
   "speaker": "Morgana",
   "en": "I see... Forming deep bonds will really help[n]us in our Phantom Thieves' missions!",
   "uk": "Ясно... Глибокі зв'язки дуже допоможуть[n]нам у місіях Фантомних Злодіїв!",
   "note": ""
  },
  {
   "id": "MSG_010_0_0#0",
   "speaker": "Morgana",
   "en": "What? We came all the way here...",
   "uk": "Що? Ми ж аж сюди прийшли...",
   "note": ""
  },
  {
   "id": "MSG_RSTART#0",
   "speaker": "Morgana",
   "en": "So do you want to pray after all?",
   "uk": "То ти все-таки хочеш помолитися?",
   "note": ""
  },
  {
   "id": "MSG_Loop_CoopMaxError#0",
   "speaker": "Morgana",
   "en": "So, what're you gonna do?",
   "uk": "То що ти робитимеш?",
   "note": ""
  },
  {
   "id": "MSG_Loop_CoopMaxError_En#0",
   "speaker": "Morgana",
   "en": "Yeah, sounds good.",
   "uk": "Так, слушна думка.",
   "note": ""
  },
  {
   "id": "MSG_012_0_0#0",
   "speaker": "Morgana",
   "en": "How much do you want to put in?",
   "uk": "Скільки хочеш покласти?",
   "note": ""
  },
  {
   "id": "SEL_payMoney#0",
   "speaker": null,
   "en": "Nothing.",
   "uk": "Нічого.",
   "note": ""
  },
  {
   "id": "SEL_payMoney#1",
   "speaker": null,
   "en": "5 yen.",
   "uk": "5 єн.",
   "note": ""
  },
  {
   "id": "SEL_payMoney#2",
   "speaker": null,
   "en": "1,000 yen.",
   "uk": "1000 єн.",
   "note": ""
  },
  {
   "id": "MSG_PayMoney_Nothave#0",
   "speaker": "Morgana",
   "en": "Huh? You don't have enough money.",
   "uk": "Га? У тебе не вистачає грошей.",
   "note": ""
  },
  {
   "id": "MSG_PayMoney_0#0",
   "speaker": "Morgana",
   "en": "Is that even allowed...? Make sure you[n]bring some money next time!",
   "uk": "А так взагалі можна...? Наступного разу[n]неодмінно візьми з собою гроші!",
   "note": ""
  },
  {
   "id": "MSG_PayMoney_5#0",
   "speaker": "Morgana",
   "en": "5 yen... Here's hoping for relationships[n]that are worth more, yeah?",
   "uk": "5 єн... Сподіваймося, стосунки[n]будуть вартісніші, еге ж?",
   "note": ""
  },
  {
   "id": "MSG_PayMoney_1000#0",
   "speaker": "Morgana",
   "en": "Wow, that's quite the splurge!",
   "uk": "Ого, оце так щедрість!",
   "note": ""
  },
  {
   "id": "MSG_WhoPray#0",
   "speaker": "Morgana",
   "en": "Well, take your time.",
   "uk": "Що ж, не поспішай.",
   "note": ""
  },
  {
   "id": "MSG_KIGAN_1ST#0",
   "speaker": "Morgana",
   "en": "Do you know how to pray?",
